@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">
        @TempData["Error"]
    </div>
}
@using PetFeast.Models.ShoppingCart
@model List<ShoppingCartItem>

<div class="container mt-5">
    <h2 class="mb-4 fw-bold text-dark">Giỏ hàng của bạn</h2>

    @if (Model == null || !Model.Any())
    {
        <br />
        <br />
        <div class="container">
            <div class="text-center">
                <img src="https://www.svgrepo.com/show/17356/empty-cart.svg"
                     class="img-fluid"
                     style="width:200px; height:200px; margin:auto;"
                     alt="Empty cart" />
                <br />
                <h1 class="fw-bold mt-4">
                    Giỏ hàng của bạn đang trống
                </h1>
                <br />
                <p class="text-secondary">
                    Trước khi thanh toán, bạn cần thêm sản phẩm vào giỏ hàng.
                    Hãy khám phá những sản phẩm thú cưng tuyệt vời của PETFEAST nhé!
                </p>
                <br />
                <a asp-controller="Product"
                   asp-action="Index"
                   class="btn btn-primary px-4 py-2">
                    Tiếp tục mua sắm
                </a>
            </div>
        </div>
        <br />
        <br />
        <br />
        <br />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead class="table-primary text-center">
                    <tr>
                        <th class="text-center">
                            <input type="checkbox" id="selectAll" checked/>
                        </th>
                        <th>Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Giá bán</th>
                        <th>Số lượng</th>
                        <th>Tổng tiền</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>

                            <!-- CHECKBOX -->
                            <td class="text-center">
                                <input type="checkbox"
                                       class="product-checkbox"
                                       data-id="@item.ProductId"
                                       data-price="@item.TotalPrice"
                                       @(item.IsSelected ? "checked" : "") />
                            </td>

                            <!-- HÌNH ẢNH -->
                            <td class="text-center">
                                <img src="@item.ImageUrl"
                                     width="70"
                                     height="70"
                                     style="object-fit:cover;"
                                     class="rounded" />
                            </td>

                            <!-- TÊN -->
                            <td>
                                @item.ProductName
                            </td>

                            <!-- GIÁ BÁN -->
                            <td>
                                @item.Price.ToString("N0") đ
                            </td>

                            <!-- SỐ LƯỢNG -->
                            <td class="text-center">
                                <div class="d-flex justify-content-center align-items-center">

                                    <!-- GIẢM -->
                                    <button type="button"
                                            class="btn btn-outline-secondary btn-sm quantity-btn decrease-btn"
                                            data-id="@item.ProductId">
                                        <i class="bi bi-dash"></i>
                                    </button>

                                    <!-- SỐ LƯỢNG -->
                                    <span class="mx-3 fw-bold quantity-value"
                                          data-id="@item.ProductId">
                                        @item.Quantity
                                    </span>

                                    <!-- TĂNG -->
                                    <button type="button"
                                            class="btn btn-outline-primary btn-sm quantity-btn increase-btn"
                                            data-id="@item.ProductId">
                                        <i class="bi bi-plus"></i>
                                    </button>

                                </div>
                            </td>

                            <!-- TỔNG TIỀN -->
                            <td>
                                <span class="item-total text-success fw-bold"
      data-id="@item.ProductId">
    @item.TotalPrice.ToString("N0") đ
</span>
                            </td>

                            <!-- XÓA -->
                            <td class="text-center">
                                <form asp-controller="ShoppingCart"
                                      asp-action="RemoveFromCart"
                                      method="post">

                                    <input type="hidden"
                                           name="productId"
                                           value="@item.ProductId" />

                                    <button class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash"></i>
                                    </button>

                                </form>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4 p-3 bg-light rounded">
            <h4>
    Tổng cộng:
    <span id="totalPrice"
          class="text-success fw-bold">
        @(Model.Where(x => x.IsSelected)
            .Sum(x => x.TotalPrice)
            .ToString("N0")) đ
    </span>
</h4>
            <div>
                <a href="/" class="btn btn-outline-secondary me-2">Tiếp tục mua hàng</a>
                <a asp-controller="Order"
                   asp-action="CheckOut"
                   class="btn btn-success">

                    Tiến hành thanh toán

                </a>
            </div>
        </div>
    }
</div>

<script>
    const selectAll =
        document.getElementById("selectAll");
    const checkboxes =
        document.querySelectorAll(".product-checkbox");
    const total =
        document.getElementById("totalPrice");
        function updateTotal() {

        if (!total) return;

        let sum = 0;

        document
            .querySelectorAll(".product-checkbox:checked")
            .forEach(cb => {
                sum += Number(cb.dataset.price);
            });

        total.innerText =
            sum.toLocaleString("vi-VN") + " đ";
    }
    // Chọn tất cả
        if (selectAll) {
        selectAll.addEventListener("change", function () {

            checkboxes.forEach(cb => {
                cb.checked = this.checked;
            });

            updateTotal();
        });
    }
    // Checkbox từng sản phẩm
        checkboxes.forEach(cb => {
        cb.addEventListener("change", function () {

            let allChecked =
                document.querySelectorAll(".product-checkbox:checked")
                    .length === checkboxes.length;

            if (selectAll) {
                selectAll.checked = allChecked;
            }

            updateTotal();
        });
    });
</script>
<script>

    document.querySelectorAll(".product-checkbox")
    .forEach(cb => {
        cb.addEventListener("change", function(){
            fetch('/ShoppingCart/UpdateSelect',
            {
                method:'POST',
                headers:
                {
                    'Content-Type':
                    'application/x-www-form-urlencoded'
                },
                body:
                `productId=${this.dataset.id}
                 &isSelected=${this.checked}`
            });
        });
    });
</script>
<script>
    document.querySelectorAll(".quantity-btn").forEach(button => {

        button.addEventListener("click", async function () {

            const productId = this.dataset.id;

            const isIncrease =
                this.classList.contains("increase-btn");

            const url = isIncrease
                ? "/ShoppingCart/IncreaseQuantity"
                : "/ShoppingCart/DecreaseQuantity";

            // Lấy 2 nút của sản phẩm hiện tại
            const increaseButton =
                document.querySelector(
                    `.increase-btn[data-id="${productId}"]`
                );

            const decreaseButton =
                document.querySelector(
                    `.decrease-btn[data-id="${productId}"]`
                );

            // Không cho bấm liên tục khi đang xử lý
            increaseButton.disabled = true;
            decreaseButton.disabled = true;

            try {

                const response = await fetch(url, {
                    method: "POST",
                    headers: {
                        "Content-Type":
                            "application/x-www-form-urlencoded; charset=UTF-8",
                        "X-Requested-With": "XMLHttpRequest"
                    },
                    body:
                        `productId=${encodeURIComponent(productId)}`
                });

                if (!response.ok) {
                    throw new Error("HTTP " + response.status);
                }

                const data = await response.json();

                // =========================
                // XỬ LÝ LỖI
                // =========================

                if (!data.success) {

                    alert(data.message);

                    if (data.quantity !== undefined) {

                        const quantityElement =
                            document.querySelector(
                                `.quantity-value[data-id="${productId}"]`
                            );

                        if (quantityElement) {
                            quantityElement.textContent = data.quantity;
                        }
                    }

                    return;
                }

                // =========================
                // CẬP NHẬT SỐ LƯỢNG
                // =========================

                const quantityElement =
                    document.querySelector(
                        `.quantity-value[data-id="${productId}"]`
                    );

                if (quantityElement) {
                    quantityElement.textContent = data.quantity;
                }


                // =========================
                // CẬP NHẬT THÀNH TIỀN
                // =========================

                const itemTotal =
                    document.querySelector(
                        `.item-total[data-id="${productId}"]`
                    );

                if (itemTotal) {

                    itemTotal.textContent =
                        Number(data.totalPrice)
                            .toLocaleString("vi-VN");
                }


                // =========================
                // CẬP NHẬT DATA-PRICE
                // =========================

                const checkbox =
                    document.querySelector(
                        `.product-checkbox[data-id="${productId}"]`
                    );

                if (checkbox) {
                    checkbox.dataset.price = data.totalPrice;
                }


                // =========================
                // CẬP NHẬT TỔNG GIỎ HÀNG
                // =========================

                updateTotal();

            }
            catch (error) {

                console.error("Quantity error:", error);

                alert("Có lỗi xảy ra. Vui lòng thử lại.");

            }
            finally {

                // Cho phép bấm lại
                increaseButton.disabled = false;
                decreaseButton.disabled = false;

            }

        });

    });
</script>