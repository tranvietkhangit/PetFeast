@model PetFeast.Models.Products.Product

@{
    bool isFavorite = ViewBag.IsFavorite ?? false;

    int currentCartQuantity =
        ViewBag.CurrentCartQuantity ?? 0;

    int maxAddQuantity =
        ViewBag.MaxAddQuantity ?? Model.Quantity;

    var relatedProducts = ViewBag.RelatedProducts
        as IEnumerable<PetFeast.Models.Products.Product>;
}

<div class="container mt-5 mb-5">

    <!-- ==========================================
         PRODUCT MAIN
         ========================================== -->

    <div class="row detail-product g-5">

        <!-- ======================================
             IMAGE
             ====================================== -->

        <div class="col-lg-6">

            <div class="product-image-box">

                <img src="@Model.ImageUrl"
                     class="img-fluid"
                     alt="@Model.ProductName">

            </div>

        </div>


        <!-- ======================================
             PRODUCT INFORMATION
             ====================================== -->

        <div class="col-lg-6">

            <!-- PRODUCT TITLE + FAVORITE -->

            <div class="product-title-row">

                <h1 class="fw-bold text-primary">
                    @Model.ProductName
                </h1>


                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form class="favorite-box favorite-form"
                          data-product-id="@Model.ProductId">

                        @Html.AntiForgeryToken()

                        <button type="button"
                                class="favorite-btn @(isFavorite ? "is-favorite" : "not-favorite")"
                                title="@(isFavorite ? "Bỏ yêu thích" : "Thêm vào yêu thích")">

                            <i class="bi @(isFavorite ? "bi-heart-fill" : "bi-heart") favorite-heart"></i>

                        </button>

                    </form>
                }
                else
                {
                    <a asp-area="Identity"
                       asp-page="/Account/Login"
                       asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString"
                       class="favorite-box favorite-btn not-favorite"
                       title="Đăng nhập để thêm vào yêu thích">

                        <i class="bi bi-heart favorite-heart"></i>

                    </a>
                }

            </div>


            <!-- ==================================
                 PRICE
                 ================================== -->

            <div class="product-price-section">

                @if (Model.DiscountPercent > 0)
                {
                    <div class="old-price">
                        <del>
                            @Model.Price.ToString("N0") đ
                        </del>
                    </div>

                    <div class="discount-price-row">

                        <div class="current-price">
                            @Model.DiscountPrice.ToString("N0") đ
                        </div>

                        <span class="detail-discount-badge">
                            -@Model.DiscountPercent%
                        </span>

                    </div>
                }
                else
                {
                    <div class="current-price">
                        @Model.Price.ToString("N0") đ
                    </div>
                }

            </div>


            <!-- ==================================
                 BASIC PRODUCT INFORMATION
                 ================================== -->

            <div class="basic-product-info">

                @if (!string.IsNullOrWhiteSpace(Model.Brand))
                {
                    <div class="basic-info-item">

                        <div class="basic-info-icon">
                            <i class="bi bi-award"></i>
                        </div>

                        <div>
                            <span class="basic-info-label">
                                Thương hiệu
                            </span>

                            <strong>
                                @Model.Brand
                            </strong>
                        </div>

                    </div>
                }


                @if (!string.IsNullOrWhiteSpace(Model.Origin))
                {
                    <div class="basic-info-item">

                        <div class="basic-info-icon">
                            <i class="bi bi-globe2"></i>
                        </div>

                        <div>
                            <span class="basic-info-label">
                                Xuất xứ
                            </span>

                            <strong>
                                @Model.Origin
                            </strong>
                        </div>

                    </div>
                }


                @if (!string.IsNullOrWhiteSpace(Model.TargetPet))
                {
                    <div class="basic-info-item">

                        <div class="basic-info-icon">
                            <i class="bi bi-person-heart"></i>
                        </div>

                        <div>
                            <span class="basic-info-label">
                                Đối tượng sử dụng
                            </span>

                            <strong>
                                @Model.TargetPet
                            </strong>
                        </div>

                    </div>
                }

            </div>


            <!-- ==================================
                 STOCK
                 ================================== -->

            <div class="stock-section">

                @if (Model.Quantity > 0)
                {
                    <div class="stock-available">

                        <i class="bi bi-check-circle-fill"></i>

                        Còn @Model.Quantity sản phẩm

                    </div>
                }
                else
                {
                    <div class="stock-empty">

                        <i class="bi bi-x-circle-fill"></i>

                        Hết hàng

                    </div>
                }

            </div>


            <!-- ==================================
                 SHORT DESCRIPTION
                 ================================== -->
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <div class="short-description">

                    <h5>
                        Mô tả sản phẩm
                    </h5>

                    <p>
                        @Model.Description
                    </p>

                </div>
            }


            <!-- ==================================
                 ADD TO CART
                 ================================== -->

            <form id="addToCartForm">

                <input type="hidden"
                       id="productId"
                       name="productId"
                       value="@Model.ProductId" />


                <div class="quantity-section">

                    <label class="quantity-label">
                        Số lượng
                    </label>


                    <input type="number"
                           id="quantity"
                           name="quantity"
                           value="1"
                           min="1"
                           max="@maxAddQuantity"
                           class="form-control quantity-box"
                           @(maxAddQuantity <= 0 ? "disabled" : "")>


                    @if (currentCartQuantity > 0)
                    {
                        <small class="quantity-note">

                            Bạn đang có
                            <strong>@currentCartQuantity</strong>
                            sản phẩm này trong giỏ hàng.

                        </small>
                    }


                    @if (maxAddQuantity > 0)
                    {
                        <small class="quantity-note">

                            Có thể thêm tối đa
                            <strong>@maxAddQuantity</strong>
                            sản phẩm.

                        </small>
                    }
                    else
                    {
                        <small class="quantity-error">

                            Sản phẩm đã đạt số lượng tối đa trong giỏ hàng.

                        </small>
                    }

                </div>


                @if (maxAddQuantity > 0)
                {
                    <button type="submit"
                            id="addToCartButton"
                            class="btn btn-primary btn-lg w-100 fw-bold add-cart-btn">

                        <i class="bi bi-cart-plus"></i>

                        <span>
                            THÊM VÀO GIỎ HÀNG
                        </span>

                    </button>
                }
                else if (Model.Quantity <= 0)
                {
                    <button type="button"
                            class="btn btn-secondary btn-lg w-100 fw-bold add-cart-btn"
                            disabled>

                        HẾT HÀNG

                    </button>
                }
                else
                {
                    <button type="button"
                            class="btn btn-secondary btn-lg w-100 fw-bold add-cart-btn"
                            disabled>

                        ĐÃ ĐẠT SỐ LƯỢNG TỐI ĐA

                    </button>
                }

            </form>

        </div>

    </div>


    <!-- ==========================================
         PRODUCT DETAILS
         ========================================== -->

    <div class="product-detail-section mt-5">

        <div class="section-title">

            <span></span>

            <h2>
                Chi tiết sản phẩm
            </h2>

            <span></span>

        </div>


        <!-- ======================================
             BASIC INFORMATION
             ====================================== -->

        <div class="detail-summary">

            @if (!string.IsNullOrWhiteSpace(Model.Brand))
            {
                <div class="detail-summary-card">

                    <div class="detail-summary-icon">
                        <i class="bi bi-award"></i>
                    </div>

                    <div>

                        <small>
                            Thương hiệu
                        </small>

                        <strong>
                            @Model.Brand
                        </strong>

                    </div>

                </div>
            }


            @if (!string.IsNullOrWhiteSpace(Model.Origin))
            {
                <div class="detail-summary-card">

                    <div class="detail-summary-icon">
                        <i class="bi bi-globe2"></i>
                    </div>

                    <div>

                        <small>
                            Xuất xứ
                        </small>

                        <strong>
                            @Model.Origin
                        </strong>

                    </div>

                </div>
            }


            @if (!string.IsNullOrWhiteSpace(Model.TargetPet))
            {
                <div class="detail-summary-card">

                    <div class="detail-summary-icon">
                        <i class="bi bi-person-heart"></i>
                    </div>

                    <div>

                        <small>
                            Đối tượng sử dụng
                        </small>

                        <strong>
                            @Model.TargetPet
                        </strong>

                    </div>

                </div>
            }

        </div>


        <!-- ======================================
             INGREDIENTS
             ====================================== -->
        @if (!string.IsNullOrWhiteSpace(Model.Ingredients))
        {
            <div class="detail-info-block">

                <div class="detail-info-header">

                    <div class="detail-info-icon">
                        <i class="bi bi-list-check"></i>
                    </div>

                    <h3>
                        Thành phần
                    </h3>

                </div>

                <div class="detail-info-content">
                    @Model.Ingredients
                </div>

            </div>
        }


        <!-- ======================================
             NUTRITION
             ====================================== -->
        @if (!string.IsNullOrWhiteSpace(Model.Nutrition))
        {
            <div class="detail-info-block">

                <div class="detail-info-header">

                    <div class="detail-info-icon">
                        <i class="bi bi-bar-chart-line"></i>
                    </div>

                    <h3>
                        Thông tin dinh dưỡng
                    </h3>

                </div>

                <div class="detail-info-content">
                    @Model.Nutrition
                </div>

            </div>
        }


        <!-- ======================================
             USAGE
             ====================================== -->
        @if (!string.IsNullOrWhiteSpace(Model.Usage))
        {
            <div class="detail-info-block">

                <div class="detail-info-header">

                    <div class="detail-info-icon">
                        <i class="bi bi-book"></i>
                    </div>

                    <h3>
                        Hướng dẫn sử dụng
                    </h3>

                </div>

                <div class="detail-info-content">
                    @Model.Usage
                </div>

            </div>
        }


        <!-- ======================================
             STORAGE
             ====================================== -->
        @if (!string.IsNullOrWhiteSpace(Model.Storage))
        {
            <div class="detail-info-block">

                <div class="detail-info-header">

                    <div class="detail-info-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>

                    <h3>
                        Hướng dẫn bảo quản
                    </h3>

                </div>

                <div class="detail-info-content">
                    @Model.Storage
                </div>

            </div>
        }


        <!-- ======================================
             WARNING
             ====================================== -->
        @if (!string.IsNullOrWhiteSpace(Model.Warning))
        {
            <div class="detail-info-block warning-block">

                <div class="detail-info-header">

                    <div class="detail-info-icon">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>

                    <h3>
                        Cảnh báo
                    </h3>

                </div>

                <div class="detail-info-content">
                    @Model.Warning
                </div>

            </div>
        }

    </div>

    <!-- ==========================================
     PRODUCT REVIEWS
     ========================================== -->
    @{
        var productReviews =
        ViewBag.ProductReviews
        as List<PetFeast.Models.Products.ProductReview>
        ?? new List<PetFeast.Models.Products.ProductReview>();

        int reviewCount =
        ViewBag.ReviewCount ?? 0;

        double averageRating =
        ViewBag.AverageRating ?? 0;
    }

    <div class="product-reviews-section mt-5">

        <div class="section-title">

            <span></span>

            <h2>
                Đánh giá sản phẩm
            </h2>

            <span></span>

        </div>


        <!-- REVIEW SUMMARY -->

        <div class="review-summary">

            <div class="review-average">

                <div class="review-average-number">
                    @averageRating.ToString("0.0")
                </div>

                <div class="review-stars">

                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Math.Round(averageRating))
                        {
                            <i class="bi bi-star-fill"></i>
                        }
                        else
                        {
                            <i class="bi bi-star"></i>
                        }
                    }

                </div>

                <div class="text-muted">
                    @reviewCount đánh giá
                </div>

            </div>


            <div class="review-summary-text">

                @if (reviewCount > 0)
                {
                    <h5 class="fw-bold">
                        Khách hàng đã đánh giá sản phẩm
                    </h5>

                    <p class="text-muted mb-0">
                        Điểm đánh giá trung bình dựa trên
                        @reviewCount lượt đánh giá.
                    </p>
                }
                else
                {
                    <h5 class="fw-bold">
                        Chưa có đánh giá
                    </h5>

                    <p class="text-muted mb-0">
                        Hãy là người đầu tiên đánh giá sản phẩm này.
                    </p>
                }

            </div>

        </div>


        <!-- REVIEW LIST -->
        @if (productReviews.Any())
        {
            <div class="review-list">

                @foreach (var review in productReviews)
                {
                    <div class="review-item">

                        <div class="review-header">

                            <div class="review-user">

                                <div class="review-avatar">
                                    <i class="bi bi-person-fill"></i>
                                </div>

                                <div>

                                    <div class="fw-bold">
                                        @(review.User?.FullName
                                                                        ?? review.User?.UserName
                                                                        ?? "Khách hàng")
                            </div>

                                    <div class="text-muted small">
                                        @review.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </div>

                                </div>

                            </div>


                            <div class="review-rating">

                        @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= review.Rating)
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star"></i>
                                    }
                                }

                            </div>

                        </div>


                        @if (!string.IsNullOrWhiteSpace(review.Comment))
                        {
                            <div class="review-comment">
                                @review.Comment
                            </div>
                        }
                        @{
                            var currentUserId =
                            User.FindFirst(
                            System.Security.Claims.ClaimTypes.NameIdentifier
                            )?.Value;
                        }

                        @if (review.UserId != currentUserId)
                        {
                            <div class="review-actions">

                                <button type="button"
                                        class="report-review-btn"
                                        data-bs-toggle="modal"
                                        data-bs-target="#reportModal"
                                        data-review-id="@review.ProductReviewId">

                                    <i class="bi bi-flag me-1"></i>
                                    Tố cáo

                                </button>

                            </div>
                        }
                    </div>
                }
                
            </div>
        }
        <!-- Report Review Modal -->
        <div class="modal fade"
             id="reportModal"
             tabindex="-1"
             aria-labelledby="reportModalLabel"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content report-modal">

                    <div class="modal-header">

                        <h5 class="modal-title"
                            id="reportModalLabel">
                            Tố cáo đánh giá

                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Đóng">
                        </button>

                    </div>

                    <form asp-controller="Review"
                          asp-action="Report"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="modal-body">

                            <input type="hidden"
                                   name="id"
                                   id="reportReviewId" />

                            <div class="mb-3">

                                <label class="form-label fw-bold">
                                    Lý do tố cáo
                                </label>

                                <select name="Reason"
                                        class="form-select"
                                        required>

                                    <option value="">
                                        -- Chọn lý do --
                                    </option>

                                    <option value="Nội dung không phù hợp">
                                        Nội dung không phù hợp
                                    </option>

                                    <option value="Nội dung xúc phạm">
                                        Nội dung xúc phạm
                                    </option>

                                    <option value="Spam hoặc quảng cáo">
                                        Spam hoặc quảng cáo
                                    </option>

                                    <option value="Thông tin sai lệch">
                                        Thông tin sai lệch
                                    </option>

                                    <option value="Nội dung không liên quan">
                                        Nội dung không liên quan
                                    </option>

                                    <option value="Lý do khác">
                                        Lý do khác
                                    </option>

                                </select>

                            </div>

                            <div class="mb-3">

                                <label class="form-label fw-bold">
                                    Mô tả thêm
                                    <span class="text-muted fw-normal">
                                        (không bắt buộc)
                                    </span>
                                </label>

                                <textarea name="Description"
                                          class="form-control"
                                          rows="4"
                                          maxlength="1000"
                                          placeholder="Hãy mô tả cụ thể vấn đề..."></textarea>

                                <div class="form-text">
                                    Tối đa 1000 ký tự.
                                </div>

                            </div>

                        </div>

                        <div class="modal-footer">

                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    data-bs-dismiss="modal">
                                Hủy
                            </button>

                            <button type="submit"
                                    class="btn btn-danger">

                                <i class="bi bi-flag-fill me-1"></i>
                                Gửi tố cáo

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>

    <!-- ==========================================
         RELATED PRODUCTS
         ========================================== -->
    @if (relatedProducts != null && relatedProducts.Any())
    {
        <div class="related-products-section mt-5">

            <div class="section-title">

                <span></span>

                <h2>
                    Sản phẩm liên quan
                </h2>

                <span></span>

            </div>


            <div class="row g-4">

                @foreach (var item in relatedProducts)
                {
                    <div class="col-md-6 col-lg-3">

                        <a asp-controller="Product"
                           asp-action="Detail"
                           asp-route-id="@item.ProductId"
                           class="text-decoration-none text-dark">

                            <div class="card h-100 product-card">

                                <div class="related-image-box">

                                    <img src="@item.ImageUrl"
                                         class="card-img-top"
                                         alt="@item.ProductName">

                                </div>


                                <div class="card-body">

                                    <h5 class="related-product-name">
                                        @item.ProductName
                                    </h5>


                                    @if (item.DiscountPercent > 0)
                                    {
                                        <del class="text-muted">
                                            @item.Price.ToString("N0") đ
                                        </del>

                                        <h5 class="text-danger fw-bold mb-0">
                                            @item.DiscountPrice.ToString("N0") đ
                                        </h5>
                                    }
                                    else
                                    {
                                        <h5 class="text-danger fw-bold mb-0">
                                            @item.Price.ToString("N0") đ
                                        </h5>
                                    }

                                </div>

                            </div>

                        </a>

                    </div>
                }

            </div>

        </div>
    }

</div>


<!-- ==================================================
     ADD TO CART - AJAX
     ================================================== -->

<script>

    const addToCartForm =
        document.getElementById("addToCartForm");

    const addToCartButton =
        document.getElementById("addToCartButton");


    if (addToCartForm && addToCartButton) {

        addToCartForm.addEventListener(
            "submit",
            async function (event) {

                event.preventDefault();


                // Không cho bấm liên tục
                if (addToCartButton.disabled) {
                    return;
                }


                const productId =
                    document.getElementById("productId").value;


                const quantityInput =
                    document.getElementById("quantity");


                let quantity =
                    parseInt(quantityInput.value) || 1;


                const maxQuantity =
                    parseInt(quantityInput.max);


                // ==============================
                // KIỂM TRA SỐ LƯỢNG
                // ==============================

                if (quantity < 1) {

                    quantity = 1;

                    quantityInput.value = 1;

                }


                if (quantity > maxQuantity) {

                    quantity = maxQuantity;

                    quantityInput.value = maxQuantity;

                }


                const originalHTML =
                    addToCartButton.innerHTML;


                addToCartButton.disabled =
                    true;


                // ==============================
                // ĐANG THÊM
                // ==============================

                addToCartButton.innerHTML = `
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    Đang thêm...
                `;


                try {

                    const response =
                        await fetch(
                            "/ShoppingCart/AddToCartAjax",
                            {
                                method: "POST",

                                headers: {
                                    "Content-Type":
                                        "application/x-www-form-urlencoded; charset=UTF-8",

                                    "X-Requested-With":
                                        "XMLHttpRequest"
                                },

                                body:
                                    `productId=${encodeURIComponent(productId)}` +
                                    `&quantity=${encodeURIComponent(quantity)}`
                            }
                        );


                    if (!response.ok) {

                        throw new Error(
                            "HTTP error " + response.status
                        );

                    }


                    const data =
                        await response.json();


                    // ==============================
                    // CHƯA ĐĂNG NHẬP
                    // ==============================

                    if (data.requireLogin) {

                        const currentUrl =
                            window.location.pathname +
                            window.location.search;


                        window.location.href =
                            "/Identity/Account/Login?returnUrl=" +
                            encodeURIComponent(currentUrl);


                        return;
                    }


                    // ==============================
                    // THÀNH CÔNG
                    // ==============================

                    if (data.success) {

                        const cartCount =
                            document.getElementById("cartCount");


                        if (cartCount) {

                            cartCount.textContent =
                                data.cartCount;


                            cartCount.classList.add(
                                "cart-count-bump"
                            );


                            setTimeout(function () {

                                cartCount.classList.remove(
                                    "cart-count-bump"
                                );

                            }, 400);

                        }


                        // ==========================
                        // ĐỔI NÚT
                        // ==========================

                        addToCartButton.classList.remove(
                            "btn-primary"
                        );


                        addToCartButton.classList.add(
                            "btn-success",
                            "cart-added"
                        );


                        addToCartButton.innerHTML = `
                            <i class="bi bi-check-circle-fill me-1"></i>
                            <span>ĐÃ THÊM VÀO GIỎ</span>
                        `;


                        // ==========================
                        // TRẢ LẠI NÚT
                        // ==========================

                        setTimeout(function () {

                            addToCartButton.classList.remove(
                                "btn-success",
                                "cart-added"
                            );


                            addToCartButton.classList.add(
                                "btn-primary"
                            );


                            addToCartButton.innerHTML =
                                originalHTML;


                            addToCartButton.disabled =
                                false;

                        }, 1500);

                    }


                    // ==============================
                    // LỖI
                    // ==============================

                    else {

                            showErrorModal(
        data.message ||
        "Không thể thêm sản phẩm vào giỏ hàng."
    );


                        addToCartButton.innerHTML =
                            originalHTML;


                        addToCartButton.disabled =
                            false;

                    }

                }
                catch (error) {

                    console.error(
                        "Add to cart error:",
                        error
                    );


                        showErrorModal(
        "Có lỗi xảy ra khi thêm sản phẩm vào giỏ hàng."
    );


                    addToCartButton.innerHTML =
                        originalHTML;


                    addToCartButton.disabled =
                        false;

                }

            }
        );

    }

</script>


<!-- ==================================================
     FAVORITE - AJAX
     ================================================== -->

<script>

    const favoriteForm =
        document.querySelector(".favorite-form");


    if (favoriteForm) {

        const favoriteButton =
            favoriteForm.querySelector(".favorite-btn");


        const favoriteIcon =
            favoriteButton.querySelector(".favorite-heart");


        const productId =
            favoriteForm.dataset.productId;


        const token =
            favoriteForm.querySelector(
                'input[name="__RequestVerificationToken"]'
            ).value;


        favoriteButton.addEventListener(
            "click",
            async function () {

                if (favoriteButton.disabled) {
                    return;
                }


                favoriteButton.disabled = true;


                try {

                    const formData =
                        new FormData();


                    formData.append(
                        "productId",
                        productId
                    );


                    formData.append(
                        "__RequestVerificationToken",
                        token
                    );


                    const response =
                        await fetch(
                            "/Favorite/ToggleAjax",
                            {
                                method: "POST",

                                body: formData,

                                headers: {
                                    "X-Requested-With":
                                        "XMLHttpRequest"
                                }
                            }
                        );


                    const data =
                        await response.json();


                    // ==============================
                    // CHƯA ĐĂNG NHẬP
                    // ==============================

                    if (data.requireLogin) {

                        window.location.href =
                            "/Identity/Account/Login?returnUrl=" +
                            encodeURIComponent(
                                window.location.pathname +
                                window.location.search
                            );

                        return;
                    }


                    if (!data.success) {

                        throw new Error(
                            "Không thể cập nhật yêu thích."
                        );

                    }


                    // ==============================
                    // ĐÃ YÊU THÍCH
                    // ==============================

                    if (data.isFavorite) {

                        favoriteButton.classList.remove(
                            "not-favorite"
                        );


                        favoriteButton.classList.add(
                            "is-favorite"
                        );


                        favoriteIcon.classList.remove(
                            "bi-heart"
                        );


                        favoriteIcon.classList.add(
                            "bi-heart-fill"
                        );


                        favoriteButton.title =
                            "Bỏ yêu thích";

                    }


                    // ==============================
                    // BỎ YÊU THÍCH
                    // ==============================

                    else {

                        favoriteButton.classList.remove(
                            "is-favorite"
                        );


                        favoriteButton.classList.add(
                            "not-favorite"
                        );


                        favoriteIcon.classList.remove(
                            "bi-heart-fill"
                        );


                        favoriteIcon.classList.add(
                            "bi-heart"
                        );


                        favoriteButton.title =
                            "Thêm vào yêu thích";

                    }

                }
                catch (error) {

                    console.error(
                        "Favorite error:",
                        error
                    );


                    showErrorModal(
                        "Có lỗi xảy ra khi cập nhật yêu thích."
                    );

                }
                finally {

                    favoriteButton.disabled =
                        false;

                }

            }
        );

    }

            document.addEventListener("DOMContentLoaded", function () {

        const reportModal =
            document.getElementById("reportModal");

        const reportReviewId =
            document.getElementById("reportReviewId");

        if (reportModal && reportReviewId) {

            reportModal.addEventListener(
                "show.bs.modal",
                function (event) {

                    const button =
                        event.relatedTarget;

                    if (!button) {
                        return;
                    }

                    const reviewId =
                        button.getAttribute(
                            "data-review-id"
                        );

                    reportReviewId.value =
                        reviewId;

                    console.log(
                        "Review ID:",
                        reviewId
                    );
                }
            );
        }

    });

        
</script>


