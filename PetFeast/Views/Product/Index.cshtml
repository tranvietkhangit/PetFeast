@model IEnumerable<PetFeast.Models.Products.Product>
@{
    var favoriteProductIds =
        ViewBag.FavoriteProductIds
        as HashSet<int>
        ?? new HashSet<int>();
}
@{
    decimal maxProductPrice = ViewBag.MaxProductPrice ?? 0;

    decimal currentMinPrice = ViewBag.MinPrice ?? 0;
    decimal currentMaxPrice = ViewBag.MaxPrice ?? maxProductPrice;

    if (currentMaxPrice > maxProductPrice)
    {
        currentMaxPrice = maxProductPrice;
    }
}
<div class="container mt-4">

    <div class="product-header">

        <div>

            @if (!string.IsNullOrEmpty(ViewBag.Keyword))
            {
                <p class="search-result-text mb-1">
                    Kết quả tìm kiếm cho
                    <strong>"@ViewBag.Keyword"</strong>
                    (@Model.Count() sản phẩm)
                </p>
            }
            else
            {
                <h4 class="fw-bold text-primary mb-0">
                    Tất cả sản phẩm
                </h4>
            }


        </div>
        <form method="get"
      asp-controller="Product"
      asp-action="Index"
      class="sort-form">

    <input type="hidden"
           name="keyword"
           value="@Context.Request.Query["keyword"]" />

    <input type="hidden"
           name="categoryId"
           value="@Context.Request.Query["categoryId"]" />

    <input type="hidden"
           name="minPrice"
           value="@Context.Request.Query["minPrice"]" />

    <input type="hidden"
           name="maxPrice"
           value="@Context.Request.Query["maxPrice"]" />

    <select name="sortOrder"
        class="form-select sort-select">

        <option value="">
            Sắp xếp
        </option>

        <option value="price_asc"
                selected="@(Context.Request.Query["sortOrder"] == "price_asc")">
            Giá thấp → cao
        </option>

        <option value="price_desc"
                selected="@(Context.Request.Query["sortOrder"] == "price_desc")">
            Giá cao → thấp
        </option>

    </select>

</form>
        </div>

    <div class="row product-main">


        <!-- SIDEBAR -->
        <div class="col-md-3">

            <form method="get"
      asp-controller="Product"
      asp-action="Index"
      class="product-filter-form">

                <div class="card mb-3">

                    <div class="card-header bg-primary text-white">
                        DANH MỤC SẢN PHẨM
                    </div>

                    <div class="list-group list-group-flush">

                        <a href="/Product"
   class="list-group-item category-filter-link">
    Tất cả
</a>

@foreach (var c in ViewBag.Categories)
{
    <a href="/Product?categoryId=@c.CategoryId"
       class="list-group-item category-filter-link">
        @c.CategoryName
    </a>
}

                    </div>

                </div>

                <div class="card mt-3">

    <div class="card-header bg-primary text-white">
        KHOẢNG GIÁ
    </div>

    <div class="card-body">

        <!-- GIÁ TỪ -->
        <div class="mb-3">

            <label class="form-label">
                Giá từ
            </label>

            <div class="input-group">

                <input type="number"
                       id="minPriceInput"
                       name="minPrice"
                       class="form-control"
                       min="0"
                       max="@maxProductPrice"
                       step="1000"
                       value="@currentMinPrice">

                <span class="input-group-text">
                    đ
                </span>

            </div>

        </div>


        <!-- GIÁ ĐẾN -->
        <div class="mb-3">

            <label class="form-label">
                Giá đến
            </label>

            <div class="input-group">

                <input type="number"
                       id="maxPriceInput"
                       name="maxPrice"
                       class="form-control"
                       min="0"
                       max="@maxProductPrice"
                       step="1000"
                       value="@currentMaxPrice.ToString("0")">

                <span class="input-group-text">
                    đ
                </span>

            </div>

        </div>


        <!-- RANGE SLIDER -->
        <div class="price-slider-container">

            <div class="price-slider-track"></div>

            <input type="range"
                   id="minPriceRange"
                   min="0"
                   max="@maxProductPrice"
                   step="1000"
                   value="@currentMinPrice"
                   class="price-range">

            <input type="range"
                   id="maxPriceRange"
                   min="0"
                   max="@maxProductPrice"
                   step="1000"
                   value="@currentMaxPrice"
                   class="price-range">

        </div>


        <!-- LABEL -->
        <div class="d-flex justify-content-between mt-2">

            <span id="minPriceLabel">
                @currentMinPrice.ToString("N0") đ
            </span>

            <span id="maxPriceLabel">
                @maxProductPrice.ToString("N0") đ
            </span>

        </div>


        <!-- BUTTON -->
        <button type="submit"
                class="btn btn-primary w-100 mt-3">
                <i class="bi bi-funnel-fill me-1"></i>
            Lọc sản phẩm
        </button>
        <a asp-controller="Product"
   asp-action="Index"
   class="btn btn-outline-secondary w-100 mt-2">

    <i class="bi bi-arrow-counterclockwise me-1"></i>

    Xóa bộ lọc

</a>

    </div>

</div>


            </form>

        </div>

        <!-- PRODUCTS -->
            <div class="col-md-9">

                @if (!Model.Any())
                {
                    <div class="text-center py-5">

                        <h4>
                            Không tìm thấy sản phẩm phù hợp
                        </h4>

                        <p class="text-muted">
                            Hãy thử từ khóa khác.
                        </p>

                    </div>
                }
                else
                {
                    <div class="row">

                       @foreach (var item in Model)
{
    bool isFavorite = favoriteProductIds.Contains(item.ProductId);
bool isOutOfStock = item.Quantity <= 0;

    <div class="col-md-4 mb-4">

        <div class="card h-100 product-card @(isOutOfStock ? "out-of-stock" : "")">

            <!-- =========================
                 PRODUCT IMAGE
                 ========================= -->

            <div class="product-image-wrapper">
                @if (isOutOfStock)
{
    <span class="out-of-stock-badge">
        <i class="bi bi-x-circle me-1"></i>
        Hết hàng
    </span>
}
                <a asp-action="Detail"
                   asp-route-id="@item.ProductId">

                    <img src="@item.ImageUrl"
                         class="product-image"
                         alt="@item.ProductName" />

                </a>


                <!-- =========================
                     NÚT YÊU THÍCH
                     ========================= -->

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form class="favorite-form"
                          data-product-id="@item.ProductId">

                        @Html.AntiForgeryToken()

                        <button type="button"
                                class="favorite-btn @(isFavorite ? "active" : "")"
                                title="@(isFavorite ? "Bỏ yêu thích" : "Thêm vào yêu thích")">

                            <i class="bi @(isFavorite ? "bi-heart-fill" : "bi-heart")"></i>

                        </button>

                    </form>
                }
                else
                {
                    <div class="favorite-form">

                        <a asp-area="Identity"
                           asp-page="/Account/Login"
                           asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString"
                           class="favorite-btn"
                           title="Đăng nhập để thêm yêu thích">

                            <i class="bi bi-heart"></i>

                        </a>

                    </div>
                }

            </div>


            <!-- =========================
                 PRODUCT INFORMATION
                 ========================= -->

            <div class="card-body">

                <h6 class="product-name">
    @item.ProductName
</h6>


                @if (item.DiscountPercent > 0)
{
    <div class="product-price-box">

        <div class="price-old">
            @item.Price.ToString("N0") đ
        </div>

        <div class="price-new">
            @item.DiscountPrice.ToString("N0") đ
        </div>

        <div class="price-saving">
            <i class="bi bi-tag-fill me-1"></i>
            Tiết kiệm
            @((item.Price - item.DiscountPrice).ToString("N0")) đ
        </div>

    </div>
}
else
{
    <div class="product-price-box">

        <div class="price-normal">
            @item.Price.ToString("N0") đ
        </div>

    </div>
}

            </div>


            <!-- =========================
                 ADD TO CART
                 ========================= -->

            <div class="card-footer bg-white border-0">

                @if (isOutOfStock)
{
    <button type="button"
            class="btn btn-secondary w-100 add-to-cart-btn"
            disabled>

        <i class="bi bi-x-circle me-1"></i>

        <span>Hết hàng</span>

    </button>
}
else
{
    <button type="button"
            class="btn btn-primary w-100 add-to-cart-btn"
            data-product-id="@item.ProductId">

        <i class="bi bi-cart-plus"></i>

        <span>Thêm vào giỏ hàng</span>

    </button>
}

            </div>

        </div>

    </div>
}
                        
                    </div>
                }
                
                @if (ViewBag.TotalPages > 1)
{
    <nav class="mt-4 mb-5">

        <ul class="pagination justify-content-center">

            <!-- TRANG TRƯỚC -->
            @if (ViewBag.CurrentPage > 1)
            {
                <li class="page-item">

                    <a class="page-link"
                       href="@Url.Action("Index", new {
                           keyword = ViewBag.Keyword,
                           categoryId = Context.Request.Query["categoryId"],
                           minPrice = ViewBag.MinPrice,
                           maxPrice = ViewBag.MaxPrice,
                           sortOrder = Context.Request.Query["sortOrder"],
                           page = ViewBag.CurrentPage - 1
                       })">

                        <i class="bi bi-chevron-left"></i>

                    </a>

                </li>
            }


            <!-- CÁC TRANG -->
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">

                    <a class="page-link"
                       href="@Url.Action("Index", new {
                           keyword = ViewBag.Keyword,
                           categoryId = Context.Request.Query["categoryId"],
                           minPrice = ViewBag.MinPrice,
                           maxPrice = ViewBag.MaxPrice,
                           sortOrder = Context.Request.Query["sortOrder"],
                           page = i
                       })">

                        @i

                    </a>

                </li>
            }


            <!-- TRANG SAU -->
            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <li class="page-item">

                    <a class="page-link"
                       href="@Url.Action("Index", new {
                           keyword = ViewBag.Keyword,
                           categoryId = Context.Request.Query["categoryId"],
                           minPrice = ViewBag.MinPrice,
                           maxPrice = ViewBag.MaxPrice,
                           sortOrder = Context.Request.Query["sortOrder"],
                           page = ViewBag.CurrentPage + 1
                       })">

                        <i class="bi bi-chevron-right"></i>

                    </a>

                </li>
            }

        </ul>

    </nav>
}
            </div>

        </div>

    </div>

</div>
<script>

    /* =========================================================
       PRICE SLIDER
    ========================================================= */

    function initPriceSlider() {

        const minRange =
            document.getElementById("minPriceRange");

        const maxRange =
            document.getElementById("maxPriceRange");

        const minInput =
            document.getElementById("minPriceInput");

        const maxInput =
            document.getElementById("maxPriceInput");

        const minLabel =
            document.getElementById("minPriceLabel");

        const maxLabel =
            document.getElementById("maxPriceLabel");

        const track =
            document.querySelector(".price-slider-track");


        if (!minRange ||
            !maxRange ||
            !minInput ||
            !maxInput ||
            !minLabel ||
            !maxLabel ||
            !track) {

            return;
        }


        const maxProductPrice =
            Number(maxRange.max);


        function formatPrice(value) {

            return Number(value)
                .toLocaleString("vi-VN") + " đ";

        }


        function updateTrack() {

            const minValue =
                Number(minRange.value);

            const maxValue =
                Number(maxRange.value);


            const minPercent =
                maxProductPrice > 0
                    ? (minValue / maxProductPrice) * 100
                    : 0;

            const maxPercent =
                maxProductPrice > 0
                    ? (maxValue / maxProductPrice) * 100
                    : 100;


            track.style.background =
                `linear-gradient(
                    to right,
                    #dbeafe 0%,
                    #dbeafe ${minPercent}%,
                    #0d6efd ${minPercent}%,
                    #0d6efd ${maxPercent}%,
                    #dbeafe ${maxPercent}%,
                    #dbeafe 100%
                )`;
        }


        /* =========================
           MIN RANGE
        ========================= */

        minRange.addEventListener("input", function () {

            let value =
                Number(this.value);

            let maxValue =
                Number(maxRange.value);


            if (value > maxValue) {

                value = maxValue;

                this.value = value;
            }


            minInput.value = value;

            minLabel.textContent =
                formatPrice(value);

            updateTrack();

        });


        /* =========================
           MAX RANGE
        ========================= */

        maxRange.addEventListener("input", function () {

            let value =
                Number(this.value);

            let minValue =
                Number(minRange.value);


            if (value < minValue) {

                value = minValue;

                this.value = value;
            }


            maxInput.value = value;

            maxLabel.textContent =
                formatPrice(value);

            updateTrack();

        });


        /* =========================
           MIN INPUT
        ========================= */

        minInput.addEventListener("change", function () {

            let value =
                Number(this.value);


            if (isNaN(value))
                value = 0;


            value = Math.max(
                0,
                Math.min(
                    maxProductPrice,
                    value
                )
            );


            let maxValue =
                Number(maxInput.value);


            if (isNaN(maxValue))
                maxValue = maxProductPrice;


            if (value > maxValue)
                value = maxValue;


            this.value = value;

            minRange.value = value;

            minLabel.textContent =
                formatPrice(value);

            updateTrack();

        });


        /* =========================
           MAX INPUT
        ========================= */

        maxInput.addEventListener("change", function () {

            let value =
                Number(this.value);


            if (isNaN(value))
                value = maxProductPrice;


            value = Math.max(
                0,
                Math.min(
                    maxProductPrice,
                    value
                )
            );


            let minValue =
                Number(minInput.value);


            if (isNaN(minValue))
                minValue = 0;


            if (value < minValue)
                value = minValue;


            this.value = value;

            maxRange.value = value;

            maxLabel.textContent =
                formatPrice(value);

            updateTrack();

        });


        minLabel.textContent =
            formatPrice(minRange.value);

        maxLabel.textContent =
            formatPrice(maxRange.value);

        updateTrack();
    }


    /* =========================================================
       AJAX LOAD PRODUCT PAGE
    ========================================================= */

    async function loadProductPage(
        url,
        updateHistory = true
    ) {

        const oldContainer =
            document.querySelector(".container.mt-4");

        if (!oldContainer)
            return;


        oldContainer.style.opacity = "0.5";
        oldContainer.style.pointerEvents = "none";


        try {

            const response =
                await fetch(url, {
                    headers: {
                        "X-Requested-With":
                            "XMLHttpRequest"
                    }
                });


            if (!response.ok) {

                throw new Error(
                    "HTTP error " +
                    response.status
                );

            }


            const html =
                await response.text();


            const parser =
                new DOMParser();


            const doc =
                parser.parseFromString(
                    html,
                    "text/html"
                );


            const newContainer =
                doc.querySelector(
                    ".container.mt-4"
                );


            if (!newContainer) {

                throw new Error(
                    "Không tìm thấy nội dung Product."
                );

            }


            /* =========================
               THAY TOÀN BỘ NỘI DUNG
            ========================= */

            oldContainer.innerHTML =
                newContainer.innerHTML;


            /* =========================
               CẬP NHẬT URL
            ========================= */

            if (updateHistory) {

                window.history.pushState(
                    {},
                    "",
                    url
                );

            }


            /* =========================
               KHỞI TẠO LẠI SLIDER
            ========================= */

            initPriceSlider();

        }
        catch (error) {

            console.error(
                "Product AJAX error:",
                error
            );

            alert(
                "Không thể tải sản phẩm. Vui lòng thử lại."
            );

        }
        finally {

            oldContainer.style.opacity = "1";
            oldContainer.style.pointerEvents = "auto";

        }

    }


    /* =========================================================
       TẠO URL PRODUCT
    ========================================================= */

    function getProductUrl(form) {

        const params =
            new URLSearchParams();


        const formData =
            new FormData(form);


        for (
            const [key, value]
            of formData.entries()
        ) {

            if (value !== "") {

                params.set(
                    key,
                    value
                );

            }

        }


        params.set(
            "page",
            "1"
        );


        return `/Product/Index?${params.toString()}`;

    }


    /* =========================================================
       FORM FILTER
    ========================================================= */

    document.addEventListener(
        "submit",
        function (event) {

            const form =
                event.target;


            if (!form.matches(
                'form[action*="/Product/Index"], form[action="/Product"], .sort-form'
            )) {

                return;

            }


            event.preventDefault();


            const url =
                getProductUrl(form);


            loadProductPage(url);

        }
    );


    /* =========================================================
       SORT
    ========================================================= */

    document.addEventListener(
        "change",
        function (event) {

            const element =
                event.target;


            if (!element.matches(
                '.sort-form select[name="sortOrder"]'
            )) {

                return;

            }


            const form =
                element.closest("form");


            if (!form)
                return;


            const url =
                getProductUrl(form);


            loadProductPage(url);

        }
    );


    /* =========================================================
       CATEGORY
    ========================================================= */

    document.addEventListener(
        "click",
        function (event) {

            const link =
                event.target.closest(
                    ".category-filter-link"
                );


            if (!link)
                return;


            event.preventDefault();


            const url =
                link.href;


            if (!url)
                return;


            loadProductPage(url);

        }
    );


    /* =========================================================
       PAGINATION
    ========================================================= */

    document.addEventListener(
        "click",
        function (event) {

            const link =
                event.target.closest(
                    ".product-main .pagination a"
                );


            if (!link)
                return;


            event.preventDefault();


            const url =
                link.href;


            if (!url)
                return;


            loadProductPage(url);

        }
    );


    /* =========================================================
       RESET FILTER
    ========================================================= */

    document.addEventListener(
        "click",
        function (event) {

            const link =
                event.target.closest(
                    'a[href*="/Product/Index"], a[href="/Product"]'
                );


            if (!link)
                return;


            /*
             * Không bắt link Product Detail
             */

            if (
                link.closest(".product-card") ||
                link.closest(".product-image-wrapper")
            ) {

                return;

            }


            event.preventDefault();


            loadProductPage(
                link.href
            );

        }
    );


    /* =========================================================
       FAVORITE AJAX
       DÙNG EVENT DELEGATION
    ========================================================= */

    document.addEventListener(
        "click",
        async function (event) {

            const button =
                event.target.closest(
                    ".favorite-form .favorite-btn"
                );


            if (!button)
                return;


            const form =
                button.closest(
                    ".favorite-form"
                );


            if (!form)
                return;


            /*
             * Nếu là link đăng nhập
             */

            if (button.tagName === "A") {
                return;
            }


            if (button.disabled)
                return;


            const icon =
                button.querySelector("i");


            const productId =
                form.dataset.productId;


            const token =
                form.querySelector(
                    'input[name="__RequestVerificationToken"]'
                )?.value;


            button.disabled = true;


            try {

                const formData =
                    new FormData();


                formData.append(
                    "productId",
                    productId
                );


                if (token) {

                    formData.append(
                        "__RequestVerificationToken",
                        token
                    );

                }


                const response =
                    await fetch(
                        "/Favorite/ToggleAjax",
                        {
                            method: "POST",
                            body: formData,
                            headers: {
                                "X-Requested-With":
                                    "XMLHttpRequest"
                            }
                        }
                    );


                if (!response.ok) {

                    throw new Error(
                        "HTTP error " +
                        response.status
                    );

                }


                const data =
                    await response.json();


                if (data.requireLogin) {

                    window.location.href =
                        "/Identity/Account/Login?returnUrl=" +
                        encodeURIComponent(
                            window.location.pathname +
                            window.location.search
                        );

                    return;
                }


                if (!data.success) {

                    throw new Error(
                        data.message ||
                        "Không thể cập nhật yêu thích."
                    );

                }


                if (data.isFavorite) {

                    button.classList.add(
                        "active"
                    );

                    icon.classList.remove(
                        "bi-heart"
                    );

                    icon.classList.add(
                        "bi-heart-fill"
                    );

                    button.title =
                        "Bỏ yêu thích";

                }
                else {

                    button.classList.remove(
                        "active"
                    );

                    icon.classList.remove(
                        "bi-heart-fill"
                    );

                    icon.classList.add(
                        "bi-heart"
                    );

                    button.title =
                        "Thêm vào yêu thích";

                }

            }
            catch (error) {

                console.error(
                    "Favorite error:",
                    error
                );

                alert(
                    "Có lỗi xảy ra khi cập nhật yêu thích."
                );

            }
            finally {

                button.disabled = false;

            }

        }
    );


    /* =========================================================
       ADD TO CART AJAX
       DÙNG EVENT DELEGATION
    ========================================================= */

    document.addEventListener(
        "click",
        async function (event) {

            const button =
                event.target.closest(
                    ".add-to-cart-btn"
                );


            if (!button)
                return;


            if (button.disabled)
                return;


            const productId =
                button.dataset.productId;


            const originalHTML =
                button.innerHTML;


            button.disabled = true;


            button.innerHTML = `
                <span class="spinner-border spinner-border-sm me-1"></span>
                Đang thêm...
            `;


            try {

                const response =
                    await fetch(
                        "/ShoppingCart/AddToCartAjax",
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/x-www-form-urlencoded; charset=UTF-8",

                                "X-Requested-With":
                                    "XMLHttpRequest"
                            },

                            body:
                                `productId=${encodeURIComponent(productId)}&quantity=1`
                        }
                    );


                if (!response.ok) {

                    throw new Error(
                        "HTTP error " +
                        response.status
                    );

                }


                const data =
                    await response.json();


                if (data.requireLogin) {

                    const currentUrl =
                        window.location.pathname +
                        window.location.search;


                    window.location.href =
                        "/Identity/Account/Login?returnUrl=" +
                        encodeURIComponent(
                            currentUrl
                        );

                    return;
                }


                if (data.success) {

                    const cartCount =
                        document.getElementById(
                            "cartCount"
                        );


                    if (cartCount) {

                        cartCount.textContent =
                            data.cartCount;

                    }


                    button.classList.remove(
                        "btn-primary"
                    );

                    button.classList.add(
                        "btn-success"
                    );


                    button.innerHTML = `
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Đã thêm</span>
                    `;


                    setTimeout(
                        function () {

                            button.classList.remove(
                                "btn-success"
                            );

                            button.classList.add(
                                "btn-primary"
                            );

                            button.innerHTML =
                                originalHTML;

                            button.disabled =
                                false;

                        },
                        1500
                    );

                }
                else {

                    alert(
                        data.message ||
                        "Không thể thêm sản phẩm vào giỏ hàng."
                    );


                    button.innerHTML =
                        originalHTML;

                    button.disabled =
                        false;

                }

            }
            catch (error) {

                console.error(
                    "Add to cart error:",
                    error
                );


                alert(
                    "Có lỗi xảy ra khi thêm sản phẩm vào giỏ hàng."
                );


                button.innerHTML =
                    originalHTML;

                button.disabled =
                    false;

            }

        }
    );


    /* =========================================================
       BACK / FORWARD
    ========================================================= */

    window.addEventListener(
        "popstate",
        function () {

            loadProductPage(
                window.location.href,
                false
            );

        }
    );


    /* =========================================================
       KHỞI TẠO
    ========================================================= */

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            initPriceSlider();

        }
    );

</script>
