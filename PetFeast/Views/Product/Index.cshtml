@model IEnumerable<PetFeast.Models.Products.Product>
@{
    var favoriteProductIds =
        ViewBag.FavoriteProductIds
        as HashSet<int>
        ?? new HashSet<int>();
}
@{
    decimal maxProductPrice = ViewBag.MaxProductPrice ?? 0;

    decimal currentMinPrice = ViewBag.MinPrice ?? 0;
    decimal currentMaxPrice = ViewBag.MaxPrice ?? maxProductPrice;

    if (currentMaxPrice > maxProductPrice)
    {
        currentMaxPrice = maxProductPrice;
    }
}
<div class="container mt-4">

    <div class="product-header">

        <div>

            @if (!string.IsNullOrEmpty(ViewBag.Keyword))
            {
                <p class="search-result-text mb-1">
                    Kết quả tìm kiếm cho
                    <strong>"@ViewBag.Keyword"</strong>
                    (@Model.Count() sản phẩm)
                </p>
            }
            else
            {
                <h4 class="fw-bold text-primary mb-0">
                    Tất cả sản phẩm
                </h4>
            }


        </div>
        <form method="get" class="sort-form">

    <input type="hidden"
           name="keyword"
           value="@Context.Request.Query["keyword"]" />

    <input type="hidden"
           name="categoryId"
           value="@Context.Request.Query["categoryId"]" />

    <input type="hidden"
           name="minPrice"
           value="@Context.Request.Query["minPrice"]" />

    <input type="hidden"
           name="maxPrice"
           value="@Context.Request.Query["maxPrice"]" />

    <select name="sortOrder"
            class="form-select sort-select"
            onchange="this.form.submit()">

        <option value="">
            Sắp xếp
        </option>

        <option value="price_asc"
                selected="@(Context.Request.Query["sortOrder"] == "price_asc")">
            Giá thấp → cao
        </option>

        <option value="price_desc"
                selected="@(Context.Request.Query["sortOrder"] == "price_desc")">
            Giá cao → thấp
        </option>

    </select>

</form>
        </div>

    <div class="row">

        <!-- SIDEBAR -->
        <div class="col-md-3">

            <form method="get">

                <div class="card mb-3">

                    <div class="card-header bg-primary text-white">
                        DANH MỤC SẢN PHẨM
                    </div>

                    <div class="list-group list-group-flush">

                        <a href="/Product"
                           class="list-group-item">
                            Tất cả
                        </a>

                        @foreach (var c in ViewBag.Categories)
                        {
                            <a href="/Product?categoryId=@c.CategoryId"
                               class="list-group-item">
                                @c.CategoryName
                            </a>
                        }

                    </div>

                </div>

                <div class="card mt-3">

    <div class="card-header bg-primary text-white">
        KHOẢNG GIÁ
    </div>

    <div class="card-body">

        <!-- GIÁ TỪ -->
        <div class="mb-3">

            <label class="form-label">
                Giá từ
            </label>

            <div class="input-group">

                <input type="number"
                       id="minPriceInput"
                       name="minPrice"
                       class="form-control"
                       min="0"
                       max="@maxProductPrice"
                       step="1000"
                       value="@currentMinPrice">

                <span class="input-group-text">
                    đ
                </span>

            </div>

        </div>


        <!-- GIÁ ĐẾN -->
        <div class="mb-3">

            <label class="form-label">
                Giá đến
            </label>

            <div class="input-group">

                <input type="number"
                       id="maxPriceInput"
                       name="maxPrice"
                       class="form-control"
                       min="0"
                       max="@maxProductPrice"
                       step="1000"
                       value="@currentMaxPrice.ToString("0")">

                <span class="input-group-text">
                    đ
                </span>

            </div>

        </div>


        <!-- RANGE SLIDER -->
        <div class="price-slider-container">

            <div class="price-slider-track"></div>

            <input type="range"
                   id="minPriceRange"
                   min="0"
                   max="@maxProductPrice"
                   step="1000"
                   value="@currentMinPrice"
                   class="price-range">

            <input type="range"
                   id="maxPriceRange"
                   min="0"
                   max="@maxProductPrice"
                   step="1000"
                   value="@currentMaxPrice"
                   class="price-range">

        </div>


        <!-- LABEL -->
        <div class="d-flex justify-content-between mt-2">

            <span id="minPriceLabel">
                @currentMinPrice.ToString("N0") đ
            </span>

            <span id="maxPriceLabel">
                @maxProductPrice.ToString("N0") đ
            </span>

        </div>


        <!-- BUTTON -->
        <button type="submit"
                class="btn btn-primary w-100 mt-3">
                <i class="bi bi-funnel-fill me-1"></i>
            Lọc sản phẩm
        </button>
        <a asp-controller="Product"
   asp-action="Index"
   class="btn btn-outline-secondary w-100 mt-2">

    <i class="bi bi-arrow-counterclockwise me-1"></i>

    Xóa bộ lọc

</a>

    </div>

</div>


            </form>

        </div>

        <!-- PRODUCTS -->
            <div class="col-md-9">

                @if (!Model.Any())
                {
                    <div class="text-center py-5">

                        <h4>
                            Không tìm thấy sản phẩm phù hợp
                        </h4>

                        <p class="text-muted">
                            Hãy thử từ khóa khác.
                        </p>

                    </div>
                }
                else
                {
                    <div class="row">

                       @foreach (var item in Model)
{
    bool isFavorite = favoriteProductIds.Contains(item.ProductId);

    <div class="col-md-4 mb-4">

        <div class="card h-100 product-card">

            <!-- =========================
                 PRODUCT IMAGE
                 ========================= -->

            <div class="product-image-wrapper">

                <a asp-action="Detail"
                   asp-route-id="@item.ProductId">

                    <img src="@item.ImageUrl"
                         class="product-image"
                         alt="@item.ProductName" />

                </a>


                <!-- =========================
                     NÚT YÊU THÍCH
                     ========================= -->

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form class="favorite-form"
                          data-product-id="@item.ProductId">

                        @Html.AntiForgeryToken()

                        <button type="button"
                                class="favorite-btn @(isFavorite ? "active" : "")"
                                title="@(isFavorite ? "Bỏ yêu thích" : "Thêm vào yêu thích")">

                            <i class="bi @(isFavorite ? "bi-heart-fill" : "bi-heart")"></i>

                        </button>

                    </form>
                }
                else
                {
                    <div class="favorite-form">

                        <a asp-area="Identity"
                           asp-page="/Account/Login"
                           asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString"
                           class="favorite-btn"
                           title="Đăng nhập để thêm yêu thích">

                            <i class="bi bi-heart"></i>

                        </a>

                    </div>
                }

            </div>


            <!-- =========================
                 PRODUCT INFORMATION
                 ========================= -->

            <div class="card-body">

                <h6>
                    @item.ProductName
                </h6>


                @if (item.DiscountPercent > 0)
                {
                    <span class="discount-badge">
                        -@item.DiscountPercent%
                    </span>

                    <div class="mb-2">

                        <div class="price-box">

                            <span class="old-price">
                                @item.Price.ToString("N0") đ
                            </span>

                            <span class="new-price">
                                @item.DiscountPrice.ToString("N0") đ
                            </span>

                        </div>

                    </div>
                }
                else
                {
                    <p class="text-danger fw-bold mb-0">
                        @item.Price.ToString("N0") đ
                    </p>
                }

            </div>


            <!-- =========================
                 ADD TO CART
                 ========================= -->

            <div class="card-footer bg-white border-0">

                <button type="button"
                        class="btn btn-primary w-100 add-to-cart-btn"
                        data-product-id="@item.ProductId">

                    <i class="bi bi-cart-plus"></i>

                    <span>Thêm vào giỏ hàng</span>

                </button>

            </div>

        </div>

    </div>
}
                        
                    </div>
                }
                
                @if (ViewBag.TotalPages > 1)
{
    <nav class="mt-4 mb-5">

        <ul class="pagination justify-content-center">

            <!-- TRANG TRƯỚC -->
            @if (ViewBag.CurrentPage > 1)
            {
                <li class="page-item">

                    <a class="page-link"
                       href="@Url.Action("Index", new {
                           keyword = ViewBag.Keyword,
                           categoryId = Context.Request.Query["categoryId"],
                           minPrice = ViewBag.MinPrice,
                           maxPrice = ViewBag.MaxPrice,
                           sortOrder = Context.Request.Query["sortOrder"],
                           page = ViewBag.CurrentPage - 1
                       })">

                        <i class="bi bi-chevron-left"></i>

                    </a>

                </li>
            }


            <!-- CÁC TRANG -->
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">

                    <a class="page-link"
                       href="@Url.Action("Index", new {
                           keyword = ViewBag.Keyword,
                           categoryId = Context.Request.Query["categoryId"],
                           minPrice = ViewBag.MinPrice,
                           maxPrice = ViewBag.MaxPrice,
                           sortOrder = Context.Request.Query["sortOrder"],
                           page = i
                       })">

                        @i

                    </a>

                </li>
            }


            <!-- TRANG SAU -->
            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <li class="page-item">

                    <a class="page-link"
                       href="@Url.Action("Index", new {
                           keyword = ViewBag.Keyword,
                           categoryId = Context.Request.Query["categoryId"],
                           minPrice = ViewBag.MinPrice,
                           maxPrice = ViewBag.MaxPrice,
                           sortOrder = Context.Request.Query["sortOrder"],
                           page = ViewBag.CurrentPage + 1
                       })">

                        <i class="bi bi-chevron-right"></i>

                    </a>

                </li>
            }

        </ul>

    </nav>
}
            </div>

        </div>

    </div>

</div>
<script>

    document.addEventListener("DOMContentLoaded", function () {

        const minRange =
            document.getElementById("minPriceRange");

        const maxRange =
            document.getElementById("maxPriceRange");

        const minInput =
            document.getElementById("minPriceInput");

        const maxInput =
            document.getElementById("maxPriceInput");

        const minLabel =
            document.getElementById("minPriceLabel");

        const maxLabel =
            document.getElementById("maxPriceLabel");

        const track =
            document.querySelector(".price-slider-track");


        // Không có bộ lọc thì dừng
        if (!minRange || !maxRange ||
            !minInput || !maxInput ||
            !minLabel || !maxLabel || !track) {

            return;
        }


        // =====================================
        // GIÁ TỐI ĐA LẤY TRỰC TIẾP TỪ HTML
        // =====================================

        const maxProductPrice =
            Number(maxRange.max);


        // =====================================
        // FORMAT GIÁ
        // =====================================

        function formatPrice(value) {

            return Number(value)
                .toLocaleString("vi-VN") + " đ";

        }


        // =====================================
        // CẬP NHẬT THANH SLIDER
        // =====================================

        function updateTrack() {

            const minValue =
                Number(minRange.value);

            const maxValue =
                Number(maxRange.value);


            const minPercent =
                maxProductPrice > 0
                    ? (minValue / maxProductPrice) * 100
                    : 0;


            const maxPercent =
                maxProductPrice > 0
                    ? (maxValue / maxProductPrice) * 100
                    : 100;


            track.style.background =
                `linear-gradient(
                    to right,
                    #dbeafe 0%,
                    #dbeafe ${minPercent}%,
                    #0d6efd ${minPercent}%,
                    #0d6efd ${maxPercent}%,
                    #dbeafe ${maxPercent}%,
                    #dbeafe 100%
                )`;
        }


        // =====================================
        // SLIDER MIN
        // =====================================

        minRange.addEventListener("input", function () {

            let minValue =
                Number(this.value);

            let maxValue =
                Number(maxRange.value);


            if (minValue > maxValue) {

                minValue = maxValue;

                this.value = minValue;
            }


            minInput.value =
                minValue;

            minLabel.textContent =
                formatPrice(minValue);

            updateTrack();
        });


        // =====================================
        // SLIDER MAX
        // =====================================

        maxRange.addEventListener("input", function () {

            let maxValue =
                Number(this.value);

            let minValue =
                Number(minRange.value);


            if (maxValue < minValue) {

                maxValue = minValue;

                this.value = maxValue;
            }


            maxInput.value =
                maxValue;

            maxLabel.textContent =
                formatPrice(maxValue);

            updateTrack();
        });


        // =====================================
        // NHẬP GIÁ MIN
        // =====================================

        minInput.addEventListener("change", function () {

            let value =
                Number(this.value);


            if (isNaN(value))
                value = 0;


            if (value < 0)
                value = 0;


            if (value > maxProductPrice)
                value = maxProductPrice;


            let maxValue =
                Number(maxInput.value);


            if (isNaN(maxValue))
                maxValue = maxProductPrice;


            if (value > maxValue)
                value = maxValue;


            this.value =
                value;

            minRange.value =
                value;

            minLabel.textContent =
                formatPrice(value);

            updateTrack();
        });


        // =====================================
        // NHẬP GIÁ MAX
        // =====================================

        maxInput.addEventListener("change", function () {

            let value =
                Number(this.value);


            if (isNaN(value))
                value = maxProductPrice;


            if (value < 0)
                value = 0;


            if (value > maxProductPrice)
                value = maxProductPrice;


            let minValue =
                Number(minInput.value);


            if (isNaN(minValue))
                minValue = 0;


            if (value < minValue)
                value = minValue;


            this.value =
                value;

            maxRange.value =
                value;

            maxLabel.textContent =
                formatPrice(value);

            updateTrack();
        });


        // =====================================
        // KHỞI TẠO
        // =====================================

        minLabel.textContent =
            formatPrice(minRange.value);

        maxLabel.textContent =
            formatPrice(maxRange.value);

        updateTrack();

    });

</script>
<script>
    // ==========================================
    // YÊU THÍCH SẢN PHẨM - AJAX
    // ==========================================

    document.querySelectorAll(".favorite-form")
        .forEach(function (form) {

            const button =
                form.querySelector(".favorite-btn");

            const icon =
                button.querySelector("i");

            const productId =
                form.dataset.productId;

            const token =
                form.querySelector(
                    'input[name="__RequestVerificationToken"]'
                ).value;

            button.addEventListener("click", async function () {

                if (button.disabled) {
                    return;
                }

                button.disabled = true;

                try {

                    const formData = new FormData();

                    formData.append(
                        "productId",
                        productId
                    );

                    formData.append(
                        "__RequestVerificationToken",
                        token
                    );

                    const response = await fetch(
                        "/Favorite/ToggleAjax",
                        {
                            method: "POST",
                            body: formData,
                            headers: {
                                "X-Requested-With":
                                    "XMLHttpRequest"
                            }
                        }
                    );

                    const data = await response.json();

                    if (data.requireLogin) {

                        window.location.href =
                            "/Identity/Account/Login?returnUrl="
                            + encodeURIComponent(
                                window.location.pathname +
                                window.location.search
                            );

                        return;
                    }

                    if (!data.success) {
                        throw new Error(
                            "Không thể cập nhật yêu thích."
                        );
                    }

                    // ==============================
                    // ĐÃ YÊU THÍCH
                    // ==============================

                    if (data.isFavorite) {

                        button.classList.add("active");

                        icon.classList.remove("bi-heart");

                        icon.classList.add("bi-heart-fill");

                        button.title =
                            "Bỏ yêu thích";
                    }

                    // ==============================
                    // BỎ YÊU THÍCH
                    // ==============================

                    else {

                        button.classList.remove("active");

                        icon.classList.remove(
                            "bi-heart-fill"
                        );

                        icon.classList.add("bi-heart");

                        button.title =
                            "Thêm vào yêu thích";
                    }

                }
                catch (error) {

                    console.error(
                        "Favorite error:",
                        error
                    );

                    alert(
                        "Có lỗi xảy ra khi cập nhật yêu thích."
                    );

                }
                finally {

                    button.disabled = false;

                }

            });

        });
</script>
<style>

    /* =========================
           PRODUCT CARD
           ========================= */

    .product-card {
        overflow: hidden;
        border-radius: 12px;
    }


    /* =========================
           PRODUCT IMAGE
           ========================= */

    .product-image-wrapper {
        position: relative;
    }


    .product-image {
        width: 100%;
        height: 250px;
        object-fit: cover;
        display: block;
    }


    /* =========================
           FAVORITE FORM
           ========================= */

    .favorite-form {
        position: absolute;
        top: 12px;
        right: 12px;
        z-index: 20;
        margin: 0;
    }

    .favorite-btn {
        width: 58px;
        height: 58px;
        padding: 0;
        border-radius: 50%;
        border: 2px solid #222;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        text-decoration: none;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.15);
        transition: all 0.25s ease;
    }

        .favorite-btn i {
            font-size: 28px;
            color: #222;
            transition: all 0.25s ease;
        }

        /* ĐÃ YÊU THÍCH */
        .favorite-btn.active {
            border-color: #ff416c;
        }

            .favorite-btn.active i {
                color: #ff416c;
            }

        /* HOVER */
        .favorite-btn:hover {
            transform: scale(1.08);
        }

        /* CLICK */
        .favorite-btn:active {
            transform: scale(0.92);
        }


    /* =========================
           PRODUCT NAME
           ========================= */

    .product-name {
        min-height: 42px;
    }


    /* =========================
           PRICE SLIDER
           ========================= */

    .price-slider-container {
        position: relative;
        height: 30px;
        margin-top: 10px;
    }


    .price-slider-track {
        position: absolute;
        top: 50%;
        left: 0;
        right: 0;
        height: 5px;
        border-radius: 5px;
        transform: translateY(-50%);
        background: #dbeafe;
    }


    .price-range {
        position: absolute;
        width: 100%;
        pointer-events: none;
        appearance: none;
        background: none;
        top: 50%;
        transform: translateY(-50%);
        margin: 0;
    }


        .price-range::-webkit-slider-thumb {
            appearance: none;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: #0d6efd;
            cursor: pointer;
            pointer-events: auto;
        }


        .price-range::-moz-range-thumb {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: #0d6efd;
            cursor: pointer;
            pointer-events: auto;
            border: none;
        }

</style>
<script>
    document.querySelectorAll(".add-to-cart-btn")
        .forEach(function (button) {

            button.addEventListener("click", async function () {

                if (button.disabled) {
                    return;
                }

                const productId =
                    button.dataset.productId;

                const originalHTML =
                    button.innerHTML;

                button.disabled = true;

                // ==========================
                // ĐANG THÊM
                // ==========================

                button.innerHTML = `
                    <span class="spinner-border spinner-border-sm me-1"></span>
                    Đang thêm...
                `;

                try {

                    const response =
                        await fetch(
                            "/ShoppingCart/AddToCartAjax",
                            {
                                method: "POST",

                                headers: {
                                    "Content-Type":
                                        "application/x-www-form-urlencoded; charset=UTF-8",

                                    "X-Requested-With":
                                        "XMLHttpRequest"
                                },

                                body:
                                    `productId=${encodeURIComponent(productId)}&quantity=1`
                            }
                        );


                    // ==========================
                    // SERVER ERROR
                    // ==========================

                    if (!response.ok) {

                        throw new Error(
                            "HTTP error " + response.status
                        );

                    }


                    const data =
                        await response.json();


                    // ==========================
                    // CHƯA ĐĂNG NHẬP
                    // ==========================

                    if (data.requireLogin) {

                        const currentUrl =
                            window.location.pathname +
                            window.location.search;

                        window.location.href =
                            "/Identity/Account/Login?returnUrl=" +
                            encodeURIComponent(currentUrl);

                        return;
                    }


                    // ==========================
                    // THÀNH CÔNG
                    // ==========================

                    if (data.success) {

                        const cartCount =
                            document.getElementById("cartCount");


                        // Cập nhật số lượng giỏ hàng
                        if (cartCount) {

                            cartCount.textContent =
                                data.cartCount;

                            cartCount.classList.add(
                                "cart-count-bump"
                            );

                            setTimeout(function () {

                                cartCount.classList.remove(
                                    "cart-count-bump"
                                );

                            }, 400);

                        }


                        // Đổi nút thành "Đã thêm"
                        button.classList.remove(
                            "btn-primary"
                        );

                        button.classList.add(
                            "btn-success",
                            "cart-added"
                        );

                        button.innerHTML = `
                            <i class="bi bi-check-circle-fill"></i>
                            <span>Đã thêm</span>
                        `;


                        // Trả lại trạng thái ban đầu
                        setTimeout(function () {

                            button.classList.remove(
                                "btn-success",
                                "cart-added"
                            );

                            button.classList.add(
                                "btn-primary"
                            );

                            button.innerHTML =
                                originalHTML;

                            button.disabled = false;

                        }, 1500);

                    }


                    // ==========================
                    // LỖI THÊM GIỎ HÀNG
                    // ==========================

                    else {

                        alert(
                            data.message ||
                            "Không thể thêm sản phẩm vào giỏ hàng."
                        );

                        button.innerHTML =
                            originalHTML;

                        button.disabled = false;

                    }

                }
                catch (error) {

                    console.error(
                        "Add to cart error:",
                        error
                    );

                    alert(
                        "Có lỗi xảy ra khi thêm sản phẩm vào giỏ hàng."
                    );

                    button.innerHTML =
                        originalHTML;

                    button.disabled = false;

                }

            });

        });
</script>
<style>

    .add-to-cart-btn {
        transition: all 0.25s ease;
    }

    .add-to-cart-btn:hover {
        transform: translateY(-2px);
    }

    .add-to-cart-btn:active {
        transform: scale(0.96);
    }


    /* =========================
       ĐÃ THÊM
       ========================= */

    .cart-added {
        animation: cartAddedAnimation 0.4s ease;
    }

    @@keyframes cartAddedAnimation {
    0% {
        transform: scale(1);
    }

    50% {
        transform: scale(1.08);
    }

    100% {
        transform: scale(1);
    }
}


    /* =========================
       CART COUNT
       ========================= */

    .cart-count-bump {
        animation: cartCountBump 0.4s ease;
    }

    @@keyframes cartCountBump {
    0% {
        transform: scale(1);
    }

    50% {
        transform: scale(1.4);
    }

    100% {
        transform: scale(1);
    }
}
/* =========================
   PAGINATION
   ========================= */

.pagination {
    gap: 6px;
}

.pagination .page-link {
    width: 40px;
    height: 40px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 8px !important;

    border: 1px solid #dee2e6;

    color: #0d6efd;

    font-weight: 600;

