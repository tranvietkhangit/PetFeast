@model PetFeast.Models.Products.ProductReview

@{
    ViewData["Title"] = "Sửa đánh giá";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <h2 class="fw-bold mb-4">
                        <i class="bi bi-pencil-square me-2"></i>
                        Sửa đánh giá
                    </h2>

                    @if (Model.Product != null)
                    {
                        <div class="mb-4">

                            <div class="d-flex align-items-center gap-3">

                                @if (!string.IsNullOrEmpty(Model.Product.ImageUrl))
                                {
                                    <img src="@Model.Product.ImageUrl"
                                         alt="@Model.Product.ProductName"
                                         style="
                                                    width: 80px;
                                                    height: 80px;
                                                    object-fit: cover;
                                                    border-radius: 10px;
                                                 " />
                                }

                                <div>
                                    <h4 class="fw-bold mb-1">
                                        @Model.Product.ProductName
                                    </h4>

                                    <p class="text-muted mb-0">
                                        Chỉnh sửa đánh giá của bạn
                                    </p>
                                </div>

                            </div>

                        </div>
                    }

                    <form asp-action="Edit"
                          asp-route-id="@Model.ProductReviewId"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="ProductReviewId" />

                        <input type="hidden"
                               asp-for="OrderDetailId" />

                        <div class="mb-4">

                            <label class="form-label fw-bold">
                                Đánh giá
                            </label>

                            <div class="rating-input">

                                @for (int i = 5; i >= 1; i--)
                                {
                                    <input type="radio"
                                           asp-for="Rating"
                                           value="@i"
                                           id="star-@i" />

                                    <label for="star-@i">
                                        ★
                                    </label>
                                }

                            </div>

                            <span asp-validation-for="Rating"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Comment"
                                   class="form-label fw-bold">
                                Nhận xét
                            </label>

                            <textarea asp-for="Comment"
                                      class="form-control"
                                      rows="5"
                                      maxlength="1000"
                                      placeholder="Hãy chia sẻ cảm nhận của bạn..."></textarea>

                            <span asp-validation-for="Comment"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="d-flex gap-2">

                            <a asp-action="MyReviews"
                               class="btn btn-outline-secondary">

                                <i class="bi bi-arrow-left me-1"></i>
                                Quay lại

                            </a>

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-check-lg me-1"></i>
                                Lưu thay đổi

                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <style>

        .rating-input {
            display: flex;
            flex-direction: row-reverse;
            justify-content: flex-end;
            gap: 5px;
        }

            .rating-input input {
                display: none;
            }

            .rating-input label {
                font-size: 38px;
                color: #ccc;
                cursor: pointer;
                transition: 0.2s;
            }

                .rating-input label:hover,
                .rating-input label:hover ~ label,
                .rating-input input:checked ~ label {
                    color: #ffc107;
                }

    </style>
}