@model PetFeast.Models.Products.ProductReview

@{
    ViewData["Title"] = "Đánh giá sản phẩm";
}

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <h2 class="fw-bold mb-4">
                        Đánh giá sản phẩm
                    </h2>

                    @if (Model.Product != null)
                    {
                        <div class="mb-4">
                            <h4 class="fw-bold">
                                @Model.Product.ProductName
                            </h4>

                            <p class="text-muted mb-0">
                                Hãy chia sẻ trải nghiệm của bạn về sản phẩm.
                            </p>
                        </div>
                    }

                    <form asp-controller="Review"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="OrderDetailId"
                               value="@Model.OrderDetailId" />

                        <div class="mb-4">

                            <label class="form-label fw-bold">
                                Đánh giá
                            </label>

                            <div class="rating-input">

                                @for (int i = 5; i >= 1; i--)
                                {
                                    <input type="radio"
                                           asp-for="Rating"
                                           value="@i"
                                           id="star-@i" />

                                    <label for="star-@i">
                                        ★
                                    </label>
                                }

                            </div>

                            <span asp-validation-for="Rating"
                                  class="text-danger"></span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Comment"
                                   class="form-label fw-bold">
                                Nhận xét
                            </label>

                            <textarea asp-for="Comment"
                                      class="form-control"
                                      rows="5"
                                      maxlength="1000"
                                      placeholder="Hãy chia sẻ cảm nhận của bạn..."></textarea>

                            <span asp-validation-for="Comment"
                                  class="text-danger"></span>

                        </div>

                        <div class="d-flex gap-2">

                            @if (Model.OrderDetail?.Order != null)
                            {
                                <a asp-controller="Order"
                                   asp-action="UserOrderDetail"
                                   asp-route-id="@Model.OrderDetail.Order.OrderId"
                                   class="btn btn-outline-secondary">

                                    <i class="bi bi-arrow-left me-1"></i>
                                    Quay lại đơn hàng
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Order"
                                   asp-action="UserOrderList"
                                   class="btn btn-outline-secondary">

                                    <i class="bi bi-arrow-left me-1"></i>
                                    Quay lại
                                </a>
                            }

                            <button type="submit"
                                    class="btn btn-primary">
                                <i class="bi bi-send"></i>
                                Gửi đánh giá
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <style>
        .rating-input {
            display: flex;
            flex-direction: row-reverse;
            justify-content: flex-end;
            gap: 5px;
        }

            .rating-input input {
                display: none;
            }

            .rating-input label {
                font-size: 38px;
                color: #ccc;
                cursor: pointer;
                transition: 0.2s;
            }

                .rating-input label:hover,
                .rating-input label:hover ~ label,
                .rating-input input:checked ~ label {
                    color: #ffc107;
                }
    </style>
}