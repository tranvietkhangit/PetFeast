@model IEnumerable<PetFeast.Models.Products.Favorite>

<div class="container mt-5 mb-5 favorite-page">

    <div class="favorite-header mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                Sản phẩm yêu thích của tôi
            </h2>

            <p class="text-muted mb-0">
                Những sản phẩm bạn đã lưu vào danh sách yêu thích
            </p>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-favorite text-center py-5">

            <div class="empty-favorite-icon">
                <i class="bi bi-heart"></i>
            </div>

            <h4 class="fw-bold mt-4">
                Chưa có sản phẩm yêu thích
            </h4>

            <p class="text-muted">
                Bạn chưa có sản phẩm nào trong danh sách yêu thích.
            </p>

            <a asp-controller="Product"
               asp-action="Index"
               class="btn btn-primary px-4">
                <i class="bi bi-bag me-2"></i>
                Xem sản phẩm
            </a>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var favorite in Model)
            {
                var product = favorite.Product;

                if (product == null)
                {
                    continue;
                }

                bool isOutOfStock = product.Quantity <= 0;

                <div class="col-md-4 mb-4 favorite-item"
                     data-product-id="@product.ProductId">

                    <div class="card h-100 product-card @(isOutOfStock ? "out-of-stock" : "")">

                        <!-- IMAGE -->
                        <div class="product-image-wrapper">

                            <a asp-controller="Product"
                               asp-action="Detail"
                               asp-route-id="@product.ProductId">

                                <img src="@product.ImageUrl"
                                     class="product-image"
                                     alt="@product.ProductName" />

                            </a>

                            <!-- DISCOUNT -->
                            @if (product.DiscountPercent > 0)
                            {
                                <span class="discount-badge">
                                    -@product.DiscountPercent%
                                </span>
                            }

                            <!-- OUT OF STOCK -->
                            @if (isOutOfStock)
                            {
                                <span class="out-of-stock-badge">
                                    <i class="bi bi-x-circle me-1"></i>
                                    Hết hàng
                                </span>
                            }

                            <!-- FAVORITE -->
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form class="favorite-form"
                                      data-product-id="@product.ProductId">

                                    @Html.AntiForgeryToken()

                                    <button type="button"
                                            class="favorite-btn active"
                                            title="Bỏ yêu thích">

                                        <i class="bi bi-heart-fill"></i>

                                    </button>

                                </form>
                            }

                        </div>

                        <!-- BODY -->
                        <div class="card-body d-flex flex-column">

                            <!-- PRODUCT NAME -->
                            <a asp-controller="Product"
                               asp-action="Detail"
                               asp-route-id="@product.ProductId"
                               class="product-name-link">

                                <h6 class="product-name">
                                    @product.ProductName
                                </h6>

                            </a>

                            <!-- PRICE -->
                            <div class="price-box">

                                @if (product.DiscountPercent > 0)
                                {
                                    <span class="old-price">
                                        @product.Price.ToString("N0") đ
                                    </span>

                                    <span class="new-price">
                                        @product.DiscountPrice.ToString("N0") đ
                                    </span>

                                    <span class="save-price">
                                        <i class="bi bi-tag-fill me-1"></i>
                                        Tiết kiệm
                                        @((product.Price - product.DiscountPrice).ToString("N0")) đ
                                    </span>
                                }
                                else
                                {
                                    <span class="new-price normal-price">
                                        @product.Price.ToString("N0") đ
                                    </span>
                                }

                            </div>

                            <!-- BUTTON -->
                            <div class="mt-auto pt-3">

                                @if (!isOutOfStock)
                                {
                                    <button type="button"
                                            class="btn btn-primary w-100 add-to-cart-btn"
                                            data-product-id="@product.ProductId">

                                        <i class="bi bi-cart-plus me-1"></i>
                                        Thêm vào giỏ hàng

                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-secondary w-100"
                                            disabled>

                                        <i class="bi bi-x-circle me-1"></i>
                                        Hết hàng

                                    </button>
                                }

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
        @if (ViewBag.TotalPages > 1)
        {
            <nav class="favorite-pagination mt-4"
                 aria-label="Phân trang sản phẩm yêu thích">

                <ul class="pagination justify-content-center">

                    <!-- TRANG TRƯỚC -->
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">

                        <a class="page-link"
                           asp-controller="Favorite"
                           asp-action="Index"
                           asp-route-page="@(ViewBag.CurrentPage - 1)">

                            <i class="bi bi-chevron-left"></i>

                        </a>

                    </li>


                    <!-- CÁC TRANG -->
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">

                            <a class="page-link"
                               asp-controller="Favorite"
                               asp-action="Index"
                               asp-route-page="@i">

                                @i

                            </a>

                        </li>
                    }


                    <!-- TRANG SAU -->
                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">

                        <a class="page-link"
                           asp-controller="Favorite"
                           asp-action="Index"
                           asp-route-page="@(ViewBag.CurrentPage + 1)">

                            <i class="bi bi-chevron-right"></i>

                        </a>

                    </li>

                </ul>

            </nav>
        }
    }

</div>


<style>

    /* =========================
       PRODUCT CARD
    ========================= */

    .product-card {
        height: 100%;
        display: flex;
        flex-direction: column;
        border: 1px solid #e9ecef;
        border-radius: 12px;
        overflow: hidden;
        transition: all .25s ease;
        background: #fff;
    }

        .product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, .08);
        }


    /* =========================
       IMAGE
    ========================= */

    .product-image-wrapper {
        position: relative;
        width: 100%;
        height: 250px;
        flex-shrink: 0;
        overflow: hidden;
        background: #f8f9fa;
    }

    .product-image {
        width: 100%;
        height: 250px;
        object-fit: cover;
        display: block;
        transition: transform .25s ease;
    }

    .product-card:hover .product-image {
        transform: scale(1.04);
    }


    /* =========================
       CARD BODY
    ========================= */

    .card-body {
        flex: 1;
        display: flex;
        flex-direction: column;
    }


    /* =========================
       PRODUCT NAME
    ========================= */

    .product-name-link {
        display: block;
        width: 100%;
        text-align: center;
        text-decoration: none !important;
        color: #212529 !important;
    }

    .product-name {
        font-size: 18px;
        font-weight: 700;
        height: 42px;
        min-height: 42px;
        margin: 0 0 12px 0;
        text-align: center;
        color: #212529 !important;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        transition: none;
    }

    /* Không đổi màu, không gạch chân khi hover */
    .product-name-link:hover,
    .product-name-link:hover .product-name {
        color: #212529 !important;
        text-decoration: none !important;
    }

    .price-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 90px;
        gap: 3px;
        text-align: center;
    }

    .old-price {
        color: #6c757d;
        text-decoration: line-through;
        font-size: 16px;
        font-weight: 500;
        text-align: center;
    }

    .new-price {
        color: #dc3545;
        font-size: 26px;
        font-weight: 800;
        text-align: center;
        line-height: 1.2;
    }

    .save-price {
        color: #198754;
        font-size: 15px;
        font-weight: 600;
        text-align: center;
        margin-top: 3px;
    }

    .normal-price {
        margin-top: 0;
    }

    /* =========================
       DISCOUNT
    ========================= */

    .discount-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        z-index: 10;
        background: #dc3545;
        color: #fff;
        padding: 5px 9px;
        border-radius: 5px;
        font-size: 13px;
        font-weight: 700;
    }


    /* =========================
       OUT OF STOCK
    ========================= */

    .product-card.out-of-stock .product-image {
        opacity: .6;
        filter: grayscale(15%);
    }

    .out-of-stock-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        z-index: 25;
        display: inline-flex;
        align-items: center;
        padding: 7px 12px;
        background: #6c757d;
        color: #fff;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 700;
        box-shadow: 0 3px 8px rgba(0, 0, 0, .15);
    }


    /* =========================
       ADD TO CART
    ========================= */

    .add-to-cart-btn {
        transition: all .2s ease;
    }

        .add-to-cart-btn:hover {
            transform: translateY(-2px);
        }

        .add-to-cart-btn:disabled {
            cursor: not-allowed;
            opacity: .7;
        }


    /* =========================
       FAVORITE
    ========================= */

    .favorite-form {
        position: absolute;
        top: 12px;
        right: 12px;
        z-index: 20;
        margin: 0;
    }

    .favorite-btn {
        width: 58px;
        height: 58px;
        padding: 0;
        border-radius: 50%;
        border: 2px solid #222;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        text-decoration: none;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.15);
        transition: all 0.25s ease;
    }

        .favorite-btn i {
            font-size: 28px;
            color: #222;
            transition: all 0.25s ease;
        }

        .favorite-btn.active {
            border-color: #ff416c;
        }

            .favorite-btn.active i {
                color: #ff416c;
            }

        .favorite-btn:hover {
            transform: translateY(-2px);
        }


    /* =========================
       EMPTY
    ========================= */

    .empty-favorite {
        background: #f8f9fa;
        border-radius: 14px;
        padding: 70px 20px !important;
    }

    .empty-favorite-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #e7f1ff;
        color: #0d6efd;
        font-size: 38px;
    }
    /* =========================
       PAGINATION
    ========================= */

    .favorite-pagination {
        margin-top: 30px !important;
    }

        .favorite-pagination .pagination {
            gap: 6px;
        }

        .favorite-pagination .page-link {
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px !important;
            border: 1px solid #dee2e6;
            color: #0d6efd;
            background: #fff;
            font-size: 15px;
            font-weight: 600;
            transition: all .2s ease;
        }

            .favorite-pagination .page-link:hover {
                background: #e7f1ff;
                border-color: #0d6efd;
                transform: translateY(-2px);
            }

        .favorite-pagination .page-item.active .page-link {
            background: #0d6efd;
            border-color: #0d6efd;
            color: #fff;
        }

        .favorite-pagination .page-item.disabled .page-link {
            color: #adb5bd;
            background: #f8f9fa;
            border-color: #dee2e6;
            cursor: not-allowed;
        }

            .favorite-pagination .page-item.disabled .page-link:hover {
                transform: none;
            }
</style>