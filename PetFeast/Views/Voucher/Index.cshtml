@model IEnumerable<PetFeast.Models.Voucher.Voucher>

@{
    ViewData["Title"] = "Đổi điểm lấy Voucher";
    var userPoints = ViewBag.UserPoints ?? 0;
}

<div class="container mt-5 mb-5">

    <div class="text-center mb-5">

        <h2 class="fw-bold">
            <i class="bi bi-ticket-perforated"></i>
            Đổi điểm lấy Voucher
        </h2>

        <p class="text-muted">
            Sử dụng điểm tích lũy để đổi lấy những voucher hấp dẫn
        </p>

        <div class="alert alert-primary d-inline-block px-4">
            <i class="bi bi-coin"></i>
            Điểm của bạn:
            <strong>@userPoints.ToString("N0") điểm</strong>
        </div>

    </div>
    <div class="row g-4">

        @foreach (var voucher in Model)
        {
            var canRedeem = userPoints >= voucher.RequiredPoints;

            <div class="col-md-6 col-lg-4">

                <div class="card h-100 shadow-sm border-0">

                    <div class="card-body d-flex flex-column">

                        <div class="text-center mb-3">

                            <i class="bi bi-ticket-perforated-fill"
                               style="font-size: 50px; color: #0d6efd;">
                            </i>

                        </div>

                        <h5 class="card-title text-center fw-bold">
                            @voucher.Name
                        </h5>

                        <div class="text-center mb-3">

                            <h3 class="text-primary fw-bold">
                                @voucher.DiscountAmount.ToString("N0")đ
                            </h3>

                        </div>

                        <hr />

                        <p class="mb-2">
                            <i class="bi bi-coin text-warning"></i>

                            Cần:
                            <strong>
                                @voucher.RequiredPoints.ToString("N0") điểm
                            </strong>
                        </p>

                        <p class="mb-2">
                            <i class="bi bi-cart"></i>

                            Đơn tối thiểu:
                            <strong>
                                @voucher.MinimumOrderAmount.ToString("N0")đ
                            </strong>
                        </p>

                        <p class="mb-3">
                            <i class="bi bi-calendar-event"></i>

                            HSD:
                            <strong>
                                @voucher.ExpiryDate.ToString("dd/MM/yyyy")
                            </strong>
                        </p>


                        <div class="mt-auto">

                            @if (canRedeem)
                            {
                                <form asp-action="Redeem"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@voucher.VoucherId" />

                                    <button type="button"
                                            class="btn btn-primary w-100 redeem-voucher-btn"
                                            data-voucher-points="@voucher.RequiredPoints.ToString("N0")">

                                        <i class="bi bi-arrow-repeat"></i>
                                        Đổi @voucher.RequiredPoints.ToString("N0") điểm

                                    </button>

                                </form>
                            }
                            else
                            {
                                var missing =
                                voucher.RequiredPoints - (int)userPoints;

                                <button class="btn btn-secondary w-100"
                                        disabled>

                                    <i class="bi bi-lock"></i>

                                    Thiếu @missing.ToString("N0") điểm

                                </button>
                            }

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>


    @if (!Model.Any())
    {
        <div class="text-center py-5">

            <i class="bi bi-ticket-perforated"
               style="font-size: 60px;">
            </i>

            <h5 class="mt-3">
                Hiện chưa có voucher nào.
            </h5>

        </div>
    }
    <div class="text-center mt-5">

        <a asp-action="MyVouchers"
           class="btn btn-outline-primary">

            <i class="bi bi-ticket"></i>
            Voucher của tôi

        </a>

    </div>

</div>
@section Scripts
{
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            document.addEventListener("click", function (event) {

                const button =
                    event.target.closest(".redeem-voucher-btn");

                if (!button) return;

                const form = button.closest("form");

                if (!form) return;

                const points =
                    button.dataset.voucherPoints;

                showConfirmModal(
                    `Bạn có chắc muốn đổi ${points} điểm lấy voucher này?`,
                    function () {
                        form.submit();
                    }
                );

            });

        });

    </script>
}