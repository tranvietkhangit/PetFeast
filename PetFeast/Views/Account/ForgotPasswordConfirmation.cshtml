@{
    ViewData["Title"] = "Kiểm tra email";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-6 col-lg-5">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4 p-md-5 text-center">

                    <i class="bi bi-envelope-check-fill text-primary"
                       style="font-size: 55px;"></i>

                    <h3 class="fw-bold mt-3">
                        Kiểm tra email
                    </h3>

                    <p class="text-muted mt-3">
                        Nếu email tồn tại trong hệ thống,
                        bạn sẽ nhận được hướng dẫn để đặt lại mật khẩu.
                    </p>

                    @if (TempData["ResetLink"] != null)
                    {
                        <div class="alert alert-warning text-start mt-4">

                            <strong>LINK TEST:</strong>

                            <div class="mt-2"
                                 style="word-break:break-all;">

                                @TempData["ResetLink"]

                            </div>

                        </div>
                    }

                    <a asp-area="Identity"
                       asp-page="/Account/Login">
                       class="btn btn-primary mt-3">

                        <i class="bi bi-box-arrow-in-right me-2"></i>
                        Quay lại đăng nhập

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>