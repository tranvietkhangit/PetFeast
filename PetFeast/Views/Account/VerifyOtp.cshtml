@{
    ViewData["Title"] = "Xác thực OTP";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-6 col-lg-5">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">

                        <div class="mb-3">
                            <i class="bi bi-envelope-check-fill text-primary"
                               style="font-size: 50px;"></i>
                        </div>

                        <h3 class="fw-bold">
                            Xác thực OTP
                        </h3>

                        <p class="text-muted">
                            Mã OTP gồm 6 chữ số đã được gửi đến email của bạn.
                        </p>

                    </div>

                    @* Chỉ hiện thông báo gửi lại OTP *@
                    @if (TempData["OtpSuccess"] != null)
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle me-2"></i>
                            @TempData["OtpSuccess"]
                        </div>
                    }

                    @if (TempData["OtpError"] != null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-circle me-2"></i>
                            @TempData["OtpError"]
                        </div>
                    }

                    <form asp-controller="Account"
                          asp-action="VerifyOtp"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="userId"
                               value="@ViewBag.UserId" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-4">

                            <label for="otp"
                                   class="form-label fw-semibold">
                                Mã OTP
                            </label>

                            <input type="text"
                                   id="otp"
                                   name="otp"
                                   class="form-control text-center"
                                   maxlength="6"
                                   minlength="6"
                                   pattern="[0-9]{6}"
                                   inputmode="numeric"
                                   autocomplete="one-time-code"
                                   placeholder="Nhập 6 số OTP"
                                   style="
                                       font-size: 25px;
                                       letter-spacing: 8px;
                                   "
                                   required />

                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">

                            <i class="bi bi-check-circle me-2"></i>

                            Xác nhận OTP

                        </button>

                    </form>

                    <div class="text-center mt-4">

                        <span class="text-muted">
                            Không nhận được mã?
                        </span>

                        <form asp-controller="Account"
                              asp-action="ResendOtp"
                              method="post"
                              class="d-inline">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-link p-0 ms-1">
                                Gửi lại OTP
                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}