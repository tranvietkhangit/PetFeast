@model PetFeast.Models.Identity.UserAddress

<div class="container mt-5">

    <div class="mb-4">

        <a asp-controller="Address"
           asp-action="Index"
           class="text-decoration-none text-muted">
            <i class="bi bi-arrow-left me-1"></i>
            Quay lại địa chỉ của tôi
        </a>

        <h2 class="fw-bold text-primary mt-3 mb-1">
            Thêm địa chỉ mới
        </h2>

        <p class="text-muted">
            Nhập thông tin địa chỉ nhận hàng
        </p>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="fromCheckout"
                       value="@((ViewBag.FromCheckout ?? false).ToString().ToLower())" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row g-3">

                    <!-- NGƯỜI NHẬN -->

                    <div class="col-md-6">

                        <label asp-for="ReceiverName"
                               class="form-label fw-semibold">
                            Tên người nhận
                        </label>

                        <input asp-for="ReceiverName"
                               class="form-control"
                               placeholder="Nhập tên người nhận" />

                        <span asp-validation-for="ReceiverName"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- SỐ ĐIỆN THOẠI -->

                    <div class="col-md-6">

                        <label asp-for="PhoneNumber"
                               class="form-label fw-semibold">
                            Số điện thoại
                        </label>

                        <input asp-for="PhoneNumber"
                               class="form-control"
                               placeholder="Nhập số điện thoại" />

                        <span asp-validation-for="PhoneNumber"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- TỈNH / THÀNH -->

                    <div class="col-md-6">

                        <label asp-for="City"
                               class="form-label fw-semibold">
                            Tỉnh / Thành phố
                        </label>

                        <input asp-for="City"
                               class="form-control"
                               placeholder="Ví dụ: Lâm Đồng" />

                        <span asp-validation-for="City"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- PHƯỜNG / XÃ -->

                    <div class="col-md-6">

                        <label asp-for="Ward"
                               class="form-label fw-semibold">
                            Phường / Xã
                        </label>

                        <input asp-for="Ward"
                               class="form-control"
                               placeholder="Nhập phường / xã" />

                        <span asp-validation-for="Ward"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- ĐỊA CHỈ CHI TIẾT -->

                    <div class="col-12">

                        <label asp-for="AddressDetail"
                               class="form-label fw-semibold">
                            Địa chỉ chi tiết
                        </label>

                        <textarea asp-for="AddressDetail"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Số nhà, tên đường..."></textarea>

                        <span asp-validation-for="AddressDetail"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- MẶC ĐỊNH -->

                    <div class="col-12">

                        <div class="form-check">

                            <input asp-for="IsDefault"
                                   class="form-check-input" />

                            <label asp-for="IsDefault"
                                   class="form-check-label">
                                Đặt làm địa chỉ mặc định
                            </label>

                        </div>

                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">

                    <a asp-controller="Address"
                       asp-action="Index"
                       asp-route-fromCheckout="@(ViewBag.FromCheckout ?? false)"
                       class="btn btn-light border">
                        Hủy
                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-lg me-1"></i>
                        Lưu địa chỉ

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}