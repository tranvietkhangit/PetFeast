@model PetFeast.Models.Identity.UserAddress

<div class="container mt-5 mb-5">

    <div class="mb-4">

        <h2 class="fw-bold text-primary">
            Chỉnh sửa địa chỉ
        </h2>

        <p class="text-muted">
            Cập nhật thông tin địa chỉ nhận hàng
        </p>

    </div>


    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <form asp-action="Edit"
                  asp-route-id="@Model.UserAddressId"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="row g-3">

                    <!-- NGƯỜI NHẬN -->

                    <div class="col-md-6">

                        <label asp-for="ReceiverName"
                               class="form-label fw-semibold">
                            Tên người nhận
                        </label>

                        <input asp-for="ReceiverName"
                               class="form-control"
                               placeholder="Nhập tên người nhận" />

                        <span asp-validation-for="ReceiverName"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- SỐ ĐIỆN THOẠI -->

                    <div class="col-md-6">

                        <label asp-for="PhoneNumber"
                               class="form-label fw-semibold">
                            Số điện thoại
                        </label>

                        <input asp-for="PhoneNumber"
                               class="form-control"
                               placeholder="Nhập số điện thoại" />

                        <span asp-validation-for="PhoneNumber"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            Tỉnh / Thành phố
                        </label>

                        <select id="province"
                                class="form-select"
                                required>

                            <option value="">
                                -- Chọn Tỉnh / Thành phố --
                            </option>

                        </select>

                    </div>


                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            Phường / Xã
                        </label>

                        <select id="ward"
                                class="form-select"
                                disabled
                                required>

                            <option value="">
                                -- Chọn Phường / Xã --
                            </option>

                        </select>

                    </div>


                    <input type="hidden"
                           asp-for="City"
                           id="cityValue" />

                    <input type="hidden"
                           asp-for="Ward"
                           id="wardValue" />
                    <!-- ĐỊA CHỈ -->

                    <div class="col-12">

                        <label asp-for="AddressDetail"
                               class="form-label fw-semibold">
                            Địa chỉ chi tiết
                        </label>

                        <textarea asp-for="AddressDetail"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Số nhà, tên đường..."></textarea>

                        <span asp-validation-for="AddressDetail"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- MẶC ĐỊNH -->

                    <div class="col-12">

                        <div class="form-check">

                            <input asp-for="IsDefault"
                                   class="form-check-input" />

                            <label asp-for="IsDefault"
                                   class="form-check-label">

                                Đặt làm địa chỉ mặc định

                            </label>

                        </div>

                    </div>

                </div>


                <div class="d-flex justify-content-end gap-2 mt-4">

                    <a asp-action="Index"
                       class="btn btn-light border">

                        <i class="bi bi-arrow-left me-1"></i>
                        Quay lại

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-lg me-1"></i>
                        Lưu thay đổi

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/address.js"></script>

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                loadAddressData({

                    currentCity:
                        @Html.Raw(
                            System.Text.Json.JsonSerializer.Serialize(
                                    Model.City
                            )
                                        ),

                currentWard:
                    @Html.Raw(
                                                System.Text.Json.JsonSerializer.Serialize(
                                                        Model.Ward
                                                )
                                        )

            });

        }
    );

</script>
}