@model IEnumerable<PetFeast.Models.Identity.UserAddress>

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold text-primary mb-1">
                Địa chỉ của tôi
            </h2>

            <p class="text-muted mb-0">
                Quản lý địa chỉ nhận hàng của bạn
            </p>
        </div>

        <a asp-controller="Address"
           asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-lg me-1"></i>
            Thêm địa chỉ

        </a>

    </div>


    <!-- THÔNG BÁO -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["Success"]

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">

            <i class="bi bi-exclamation-circle me-2"></i>

            @TempData["Error"]

        </div>
    }


    @if (!Model.Any())
    {
        <div class="text-center py-5">

            <i class="bi bi-geo-alt text-muted"
               style="font-size:60px;"></i>

            <h5 class="mt-3">
                Bạn chưa có địa chỉ nào
            </h5>

            <p class="text-muted">
                Thêm địa chỉ để thuận tiện khi đặt hàng.
            </p>

            <a asp-action="Create"
               class="btn btn-primary">

                Thêm địa chỉ đầu tiên

            </a>

        </div>
    }
    else
    {
        foreach (var address in Model)
        {
            <div class="card border-0 shadow-sm mb-3">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <!-- THÔNG TIN -->

                        <div>

                            <div class="d-flex align-items-center gap-2">

                                <h5 class="fw-bold mb-0">
                                    @address.ReceiverName
                                </h5>

                                @if (address.IsDefault)
                                {
                                    <span class="badge bg-primary">
                                        Mặc định
                                    </span>
                                }

                            </div>


                            <div class="text-muted mt-2">

                                <i class="bi bi-telephone me-2"></i>

                                @address.PhoneNumber

                            </div>


                            <div class="mt-2">

                                <i class="bi bi-geo-alt me-2 text-primary"></i>

                                @address.AddressDetail,
                                @address.Ward,
                                @address.City

                            </div>

                        </div>


                        <!-- NÚT -->

                        <div class="d-flex align-items-center gap-2">

                            @if (!address.IsDefault)
                            {
                                <form asp-controller="Address"
                                      asp-action="SetDefault"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@address.UserAddressId" />

                                    <button type="submit"
                                            class="btn btn-outline-primary btn-sm">

                                        <i class="bi bi-check-lg me-1"></i>
                                        Đặt mặc định

                                    </button>

                                </form>
                            }


                            <a asp-controller="Address"
                               asp-action="Edit"
                               asp-route-id="@address.UserAddressId"
                               class="btn btn-outline-secondary btn-sm">

                                <i class="bi bi-pencil me-1"></i>
                                Chỉnh sửa

                            </a>


                            @if (!address.IsDefault)
                            {
                                <form asp-controller="Address"
                                      asp-action="Delete"
                                      method="post"
                                      onsubmit="return confirm('Bạn có chắc muốn xóa địa chỉ này?');">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@address.UserAddressId" />

                                    <button type="submit"
                                            class="btn btn-outline-danger btn-sm">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </form>
                            }

                        </div>

                    </div>

                </div>

            </div>
        }
    }


    <!-- QUAY LẠI CHECKOUT -->

    <div class="mt-4 mb-5">

        <a asp-controller="Order"
           asp-action="CheckOut"
           class="btn btn-light border">

            <i class="bi bi-arrow-left me-1"></i>
            Quay lại thanh toán

        </a>

    </div>

</div>