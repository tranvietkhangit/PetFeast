@model List<PetFeast.Models.Notifications.Notification>

@{
    ViewData["Title"] = "Thông báo của tôi";
}

@Html.AntiForgeryToken()

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">
            <i class="bi bi-bell text-primary me-2"></i>
            Thông báo của tôi
        </h2>

        <span id="unread-count" class="text-muted">
            @Model.Count(n => !n.IsRead) thông báo chưa đọc
        </span>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            Bạn chưa có thông báo nào.
        </div>
    }
    else
    {
        <div class="notification-page-list">

            @foreach (var notification in Model)
            {
                <div class="notification-card
                    @(notification.IsRead ? "" : "unread")"
                     data-notification-id="@notification.Id"
                     data-is-read="@notification.IsRead.ToString().ToLower()">

                    <div class="d-flex justify-content-between
                                        align-items-start gap-3">

                        <div class="flex-grow-1">

                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-bell text-primary me-2"></i>

                                <h5 class="mb-0 fw-semibold">
                                    @notification.Title
                                </h5>

                                @if (!notification.IsRead)
                                {
                                    <span class="badge bg-primary ms-2">
                                        Mới
                                    </span>
                                }
                            </div>

                            <p class="mb-2 text-secondary">
                                @notification.Message
                            </p>

                            <small class="text-muted">
                                <i class="bi bi-clock me-1"></i>
                                @notification.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </small>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>

<style>
    /* Danh sách thông báo */
    .notification-page-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    /* Card thông báo */
    .notification-card {
        padding: 20px;
        background-color: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
        transition: all 0.2s ease;
    }

        /* Hover */
        .notification-card:hover {
            border-color: #0d6efd;
            box-shadow: 0 4px 12px rgba(13, 110, 253, 0.12);
        }

        /* Chưa đọc */
        .notification-card.unread {
            background-color: #f0f6ff;
            border-left: 4px solid #0d6efd;
        }

        /* Nội dung */
        .notification-card p {
            line-height: 1.6;
        }

        /* Hiệu ứng khi vừa được đánh dấu đã đọc */
        .notification-card.read {
            background-color: #ffffff;
            border-left: 1px solid #dee2e6;
        }
</style>

@section Scripts {
    <script>

        // ==========================================
        // Cập nhật số thông báo trên icon chuông
        // ==========================================
                function updateNotificationBadge(unreadCount) {

            let notificationBadge =
                document.querySelector(".notification-count");

            const notificationLink =
                document.querySelector(".header-notification");

            if (!notificationLink) {
                return;
            }

            // Nếu badge chưa tồn tại thì tạo
            if (!notificationBadge) {

                notificationBadge =
                    document.createElement("span");

                notificationBadge.className =
                    "notification-count";

                notificationLink.appendChild(
                    notificationBadge
                );
            }

            // Luôn hiển thị số
            notificationBadge.dataset.count =
                unreadCount;

            notificationBadge.textContent =
                unreadCount > 99
                    ? "99+"
                    : unreadCount;
        }

                function updateNotificationBadge(unreadCount) {

            let notificationBadge =
                document.querySelector(".notification-count");

            // Không còn thông báo chưa đọc
            if (unreadCount <= 0) {

                if (notificationBadge) {
                    notificationBadge.remove();
                }

                return;
            }

            // Badge chưa tồn tại → tạo lại
            if (!notificationBadge) {

                const notificationLink =
                    document.querySelector(".header-notification");

                if (!notificationLink) {
                    return;
                }

                notificationBadge =
                    document.createElement("span");

                notificationBadge.className =
                    "notification-count";

                notificationLink.appendChild(
                    notificationBadge
                );
            }

            // Cập nhật số
            notificationBadge.dataset.count =
                unreadCount;

            notificationBadge.textContent =
                unreadCount > 99
                    ? "99+"
                    : unreadCount;
        }
        // ==========================================
        // Khi trang Notification/Index đã load
        // ==========================================
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const cards =
                    document.querySelectorAll(
                        ".notification-card.unread"
                    );

                if (cards.length === 0) {
                    return;
                }


                // ==========================================
                // Theo dõi notification khi xuất hiện trên màn hình
                // ==========================================
                const observer =
                    new IntersectionObserver(
                        async function (entries, observer) {

                            for (const entry of entries) {

                                if (!entry.isIntersecting) {
                                    continue;
                                }


                                const card =
                                    entry.target;

                                const notificationId =
                                    card.dataset.notificationId;

                                if (!notificationId) {
                                    continue;
                                }


                                // Không gửi request nhiều lần
                                if (
                                    card.dataset.marking === "true"
                                ) {
                                    continue;
                                }

                                card.dataset.marking =
                                    "true";


                                // ==========================================
                                // Lấy AntiForgeryToken
                                // ==========================================
                                const token =
                                    document.querySelector(
                                        'input[name="__RequestVerificationToken"]'
                                    );


                                const formData =
                                    new FormData();

                                formData.append(
                                    "id",
                                    notificationId
                                );


                                if (token) {

                                    formData.append(
                                        "__RequestVerificationToken",
                                        token.value
                                    );
                                }


                                try {

                                    // ==========================================
                                    // Gọi Controller
                                    // ==========================================
                                    const response =
                                        await fetch(
                                            '@Url.Action("MarkAsRead", "Notification")',
                                            {
                                                method: "POST",
                                                body: formData
                                            }
                                        );


                                    // ==========================================
                                    // Kiểm tra HTTP response
                                    // ==========================================
                                    if (!response.ok) {

                                        throw new Error(
                                            `HTTP ${response.status}`
                                        );
                                    }


                                    // ==========================================
                                    // Đọc JSON
                                    // ==========================================
                                    const result =
                                        await response.json();


                                            console.log("========== MARK AS READ ==========");
        console.log("Notification ID:", result.id);
        console.log("Success:", result.success);
        console.log("Unread Count:", result.unreadCount);
        console.log("Full result:", JSON.stringify(result));
        console.log("=================================");


                                    // ==========================================
                                    // Nếu Controller xử lý thành công
                                    // ==========================================
                                    if (result.success) {

                                        // Bỏ trạng thái chưa đọc
                                        card.classList.remove(
                                            "unread"
                                        );


                                        // Đánh dấu đã đọc trên HTML
                                        card.dataset.isRead =
                                            "true";


                                        // Xóa chữ "Mới"
                                        const badge =
                                            card.querySelector(
                                                ".badge"
                                            );

                                        if (badge) {
                                            badge.remove();
                                        }


                                        // ==========================================
                                        // Cập nhật số trên trang
                                        // ==========================================
                                        const countElement =
                                            document.querySelector(
                                                "#unread-count"
                                            );


                                        if (countElement) {

                                            countElement.textContent =
                                                `${result.unreadCount} thông báo chưa đọc`;
                                        }


                                        // ==========================================
                                        // Cập nhật badge trên icon chuông
                                        // ==========================================
                                        updateNotificationBadge(
                                            result.unreadCount
                                        );


                                        // Không theo dõi notification này nữa
                                        observer.unobserve(
                                            card
                                        );
                                    }
                                    else {

                                        console.warn(
                                            "MarkAsRead thất bại:",
                                            result
                                        );

                                        // Cho phép thử lại
                                        card.dataset.marking =
                                            "false";
                                    }

                                }
                                catch (error) {

                                    console.error(
                                        "Mark notification as read error:",
                                        error
                                    );

                                    // Cho phép thử lại
                                    card.dataset.marking =
                                        "false";
                                }
                            }

                        },
                        {
                            threshold: 0.5
                        }
                    );


                // ==========================================
                // Bắt đầu theo dõi tất cả notification chưa đọc
                // ==========================================
                cards.forEach(
                    function (card) {
                        observer.observe(card);
                    }
                );

            }
        );

    </script>
}