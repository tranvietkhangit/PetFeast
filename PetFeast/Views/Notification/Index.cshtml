@model List<PetFeast.Models.Notifications.Notification>

@{
    ViewData["Title"] = "Thông báo của tôi";
}

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">
            <i class="bi bi-bell text-primary me-2"></i>
            Thông báo của tôi
        </h2>

        <span id="unread-count" class="text-muted">
            @Model.Count(n => !n.IsRead) thông báo chưa đọc
        </span>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            Bạn chưa có thông báo nào.
        </div>
    }
    else
    {
        <div class="notification-page-list">

            @foreach (var notification in Model)
            {
                <div class="notification-card
                                    @(notification.IsRead ? "" : "unread")">

                    <div class="d-flex justify-content-between
                                        align-items-start gap-3">

                        <div class="flex-grow-1">

                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-bell text-primary me-2"></i>

                                <h5 class="mb-0 fw-semibold">
                                    @notification.Title
                                </h5>

                                @if (!notification.IsRead)
                                {
                                    <span class="badge bg-primary ms-2">
                                        Mới
                                    </span>
                                }
                            </div>

                            <p class="mb-2 text-secondary">
                                @notification.Message
                            </p>

                            <small class="text-muted">
                                <i class="bi bi-clock me-1"></i>
                                @notification.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </small>

                        </div>

                        @if (!notification.IsRead)
                        {
                            <form class="mark-as-read-form"
                                  asp-action="MarkAsRead"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@notification.Id" />

                                <button type="submit"
                                        class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-check2 me-1"></i>
                                    Đã đọc
                                </button>
                            </form>
                        }

                    </div>

                </div>
            }

        </div>
    }

</div>
<style>
    /* Danh sách thông báo trong trang Index */
    .notification-page-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    /* Card thông báo */
    .notification-card {
        padding: 20px;
        background-color: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
        transition: all 0.2s ease;
    }

        /* Hiệu ứng khi di chuột */
        .notification-card:hover {
            border-color: #0d6efd;
            box-shadow: 0 4px 12px rgba(13, 110, 253, 0.12);
        }

        /* Thông báo chưa đọc */
        .notification-card.unread {
            background-color: #f0f6ff;
            border-left: 4px solid #0d6efd;
        }

        /* Nội dung thông báo */
        .notification-card p {
            line-height: 1.6;
        }

        /* Nút Đã đọc */
        .notification-card .btn {
            white-space: nowrap;
        }
</style>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const forms = document.querySelectorAll(".mark-as-read-form");

            forms.forEach(form => {

                form.addEventListener("submit", async function (event) {

                    // Ngăn form submit thông thường
                    event.preventDefault();

                    const button = form.querySelector("button");
                    const card = form.closest(".notification-card");

                    const formData = new FormData(form);

                    button.disabled = true;

                    try {
                        const response = await fetch(form.action, {
                            method: "POST",
                            body: formData
                        });

                        if (!response.ok) {
                            throw new Error("Không thể đánh dấu đã đọc.");
                        }

                        const result = await response.json();

                        if (result.success) {

                            // Xóa nền thông báo chưa đọc
                            card.classList.remove("unread");

                            // Xóa nhãn "Mới"
                            const badge = card.querySelector(".badge");

                            if (badge) {
                                badge.remove();
                            }

                            // Xóa nút "Đã đọc"
                            form.remove();

                            // Cập nhật tổng số thông báo chưa đọc
                            const unreadCountElement =
                                document.querySelector("#unread-count");

                            if (unreadCountElement) {

                                let count = parseInt(
                                    unreadCountElement.textContent
                                ) || 0;

                                count = Math.max(0, count - 1);

                                unreadCountElement.textContent =
                                    `${count} thông báo chưa đọc`;
                            }
                        }
                    }
                    catch (error) {
                        showErrorModal(error.message);
                        button.disabled = false;
                    }

                });

            });

        });
    </script>
}