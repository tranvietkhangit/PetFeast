@model PetFeast.Models.Products.Product

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-page">

    <div class="admin-page-header">
        <div>
            <h2 class="admin-page-title">Thêm sản phẩm</h2>
            <p class="admin-page-subtitle">
                Thêm sản phẩm mới vào cửa hàng PetFeast
            </p>
        </div>

        <a asp-action="ProductList"
           class="admin-btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Quay lại
        </a>
    </div>

    <div class="admin-card">

        <div class="admin-card-header">
            <i class="bi bi-box-seam text-primary"></i>
            <h4>Thông tin sản phẩm</h4>
        </div>

        <div class="admin-card-body">

            <form asp-action="CreateProduct"
                  method="post"
                  enctype="multipart/form-data"
                  class="admin-form">

                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <div class="col-md-8">

                        <div class="mb-3">
                            <label asp-for="ProductName"
                                   class="admin-form-label">
                                Tên sản phẩm
                            </label>

                            <input asp-for="ProductName"
                                   class="form-control"
                                   placeholder="Nhập tên sản phẩm..."
                                   required />

                            <span asp-validation-for="ProductName"
                                  class="text-danger">
                            </span>
                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="mb-3">
                            <label asp-for="CategoryId"
                                   class="admin-form-label">
                                Danh mục
                            </label>

                            <select asp-for="CategoryId"
                                    class="form-select"
                                    asp-items="@(new SelectList(ViewBag.Categories, "CategoryId", "CategoryName"))">
                                <option value="">
                                    -- Chọn danh mục --
                                </option>
                            </select>
                        </div>

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="Price"
                                   class="admin-form-label">
                                Giá
                            </label>

                            <input asp-for="Price"
                                   class="form-control"
                                   type="number"
                                   min="0"
                                   required />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="DiscountPercent"
                                   class="admin-form-label">
                                Giảm giá (%)
                            </label>

                            <input asp-for="DiscountPercent"
                                   class="form-control"
                                   type="number"
                                   min="0"
                                   max="100" />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="Quantity"
                                   class="admin-form-label">
                                Số lượng
                            </label>

                            <input asp-for="Quantity"
                                   class="form-control"
                                   type="number"
                                   min="0"
                                   required />
                        </div>
                    </div>

                </div>

                <div class="mb-3">
                    <label asp-for="Description"
                           class="admin-form-label">
                        Mô tả
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              placeholder="Nhập mô tả sản phẩm..."></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageFile"
                           class="admin-form-label">
                        Ảnh sản phẩm
                    </label>

                    <input asp-for="ImageFile"
                           class="form-control"
                           type="file"
                           accept="image/*" />
                </div>

                <div class="admin-form-actions">

                    <button type="submit"
                            class="admin-btn-primary">
                        <i class="bi bi-check-circle"></i>
                        Lưu sản phẩm
                    </button>

                    <a asp-action="ProductList"
                       class="admin-btn-secondary">
                        <i class="bi bi-x-circle"></i>
                        Hủy
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>