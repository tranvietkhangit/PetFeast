@model PetFeast.Models.Products.Product

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-page">

    <div class="admin-page-header">
        <div>
            <h2 class="admin-page-title">Thêm sản phẩm</h2>
            <p class="admin-page-subtitle">
                Thêm sản phẩm mới vào cửa hàng PetFeast
            </p>
        </div>

        <a asp-action="ProductList"
           class="admin-btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Quay lại
        </a>
    </div>

    <div class="admin-card">

        <div class="admin-card-header">
            <i class="bi bi-box-seam text-primary"></i>
            <h4>Thông tin sản phẩm</h4>
        </div>

        <div class="admin-card-body">

            <form asp-action="CreateProduct"
                  method="post"
                  enctype="multipart/form-data"
                  class="admin-form">

                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <div class="col-md-8">

                        <div class="mb-3">
                            <label asp-for="ProductName"
                                   class="admin-form-label">
                                Tên sản phẩm
                            </label>

                            <input asp-for="ProductName"
                                   class="form-control"
                                   placeholder="Nhập tên sản phẩm..."
                                   required />

                            <span asp-validation-for="ProductName"
                                  class="text-danger">
                            </span>
                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="mb-3">
                            <label asp-for="CategoryId"
                                   class="admin-form-label">
                                Danh mục
                            </label>

                            <select asp-for="CategoryId"
                                    class="form-select"
                                    asp-items="@(new SelectList(ViewBag.Categories, "CategoryId", "CategoryName"))">
                                <option value="">
                                    -- Chọn danh mục --
                                </option>
                            </select>
                        </div>

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="Price"
                                   class="admin-form-label">
                                Giá
                            </label>

                            <input asp-for="Price"
                                   class="form-control"
                                   type="number"
                                   min="0"
                                   required />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="DiscountPercent"
                                   class="admin-form-label">
                                Giảm giá (%)
                            </label>

                            <input asp-for="DiscountPercent"
                                   class="form-control"
                                   type="number"
                                   min="0"
                                   max="100" />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="Quantity"
                                   class="admin-form-label">
                                Số lượng
                            </label>

                            <input asp-for="Quantity"
                                   class="form-control"
                                   type="number"
                                   min="0"
                                   required />
                        </div>
                    </div>

                </div>

                <div class="mb-3">
                    <label asp-for="Description"
                           class="admin-form-label">
                        Mô tả
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              placeholder="Nhập mô tả sản phẩm..."></textarea>
                </div>
                <!-- =========================
                     THÔNG TIN SẢN PHẨM
                ========================= -->

                <div class="admin-card-header mt-4 mb-3">
                    <i class="bi bi-info-circle text-primary"></i>
                    <h4>Thông tin chi tiết sản phẩm</h4>
                </div>

                <div class="row">

                    <!-- Thương hiệu -->
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="Brand"
                                   class="admin-form-label">
                                Thương hiệu
                            </label>

                            <input asp-for="Brand"
                                   class="form-control"
                                   placeholder="VD: Royal Canin, Whiskas..." />

                            <span asp-validation-for="Brand"
                                  class="text-danger">
                            </span>
                        </div>
                    </div>

                    <!-- Xuất xứ -->
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="Origin"
                                   class="admin-form-label">
                                Xuất xứ
                            </label>

                            <input asp-for="Origin"
                                   class="form-control"
                                   placeholder="VD: Pháp, Mỹ, Nhật Bản..." />

                            <span asp-validation-for="Origin"
                                  class="text-danger">
                            </span>
                        </div>
                    </div>

                    <!-- Đối tượng sử dụng -->
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="TargetPet"
                                   class="admin-form-label">
                                Đối tượng sử dụng
                            </label>

                            <input asp-for="TargetPet"
                                   class="form-control"
                                   placeholder="VD: Chó trưởng thành, mèo con..." />

                            <span asp-validation-for="TargetPet"
                                  class="text-danger">
                            </span>
                        </div>
                    </div>

                </div>

                <!-- Thành phần -->
                <div class="mb-3">
                    <label asp-for="Ingredients"
                           class="admin-form-label">
                        Thành phần
                    </label>

                    <textarea asp-for="Ingredients"
                              class="form-control"
                              rows="4"
                              placeholder="Nhập thành phần sản phẩm..."></textarea>

                    <span asp-validation-for="Ingredients"
                          class="text-danger">
                    </span>
                </div>

                <!-- Thông tin dinh dưỡng -->
                <div class="mb-3">
                    <label asp-for="Nutrition"
                           class="admin-form-label">
                        Thông tin dinh dưỡng
                    </label>

                    <textarea asp-for="Nutrition"
                              class="form-control"
                              rows="4"
                              placeholder="VD: Protein, chất béo, chất xơ, năng lượng..."></textarea>

                    <span asp-validation-for="Nutrition"
                          class="text-danger">
                    </span>
                </div>

                <!-- Hướng dẫn sử dụng -->
                <div class="mb-3">
                    <label asp-for="Usage"
                           class="admin-form-label">
                        Hướng dẫn sử dụng
                    </label>

                    <textarea asp-for="Usage"
                              class="form-control"
                              rows="4"
                              placeholder="Nhập hướng dẫn sử dụng sản phẩm..."></textarea>

                    <span asp-validation-for="Usage"
                          class="text-danger">
                    </span>
                </div>

                <!-- Hướng dẫn bảo quản -->
                <div class="mb-3">
                    <label asp-for="Storage"
                           class="admin-form-label">
                        Hướng dẫn bảo quản
                    </label>

                    <textarea asp-for="Storage"
                              class="form-control"
                              rows="3"
                              placeholder="VD: Bảo quản nơi khô ráo, thoáng mát..."></textarea>

                    <span asp-validation-for="Storage"
                          class="text-danger">
                    </span>
                </div>

                <!-- Cảnh báo -->
                <div class="mb-3">
                    <label asp-for="Warning"
                           class="admin-form-label">
                        Cảnh báo
                    </label>

                    <textarea asp-for="Warning"
                              class="form-control"
                              rows="3"
                              placeholder="Nhập các lưu ý hoặc cảnh báo..."></textarea>

                    <span asp-validation-for="Warning"
                          class="text-danger">
                    </span>
                </div>
                <div class="mb-3">
                    <label asp-for="ImageFile"
                           class="admin-form-label">
                        Ảnh sản phẩm
                    </label>

                    <input asp-for="ImageFile"
                           class="form-control"
                           type="file"
                           accept="image/*" />
                </div>

                <div class="admin-form-actions">

                    <button type="submit"
                            class="admin-btn-primary">
                        <i class="bi bi-check-circle"></i>
                        Lưu sản phẩm
                    </button>

                    <a asp-action="ProductList"
                       class="admin-btn-secondary">
                        <i class="bi bi-x-circle"></i>
                        Hủy
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>