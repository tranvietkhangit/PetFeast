@model PetFeast.Models.Products.Product

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-page">

    <div class="admin-page-header">
        <div>
            <h2 class="admin-page-title">Sửa sản phẩm</h2>
            <p class="admin-page-subtitle">
                Cập nhật thông tin sản phẩm
            </p>
        </div>

        <a asp-action="ProductList"
           class="admin-btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Quay lại
        </a>
    </div>

    <div class="admin-card">

        <div class="admin-card-header">
            <i class="bi bi-pencil-square text-primary"></i>
            <h4>Thông tin sản phẩm</h4>
        </div>

        <div class="admin-card-body">

            <form asp-action="EditProduct"
                  method="post"
                  enctype="multipart/form-data"
                  class="admin-form">

                <input type="hidden"
                       asp-for="ProductId" />

                <input type="hidden"
                       asp-for="ImageUrl" />

                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <div class="col-md-8">

                        <div class="mb-3">
                            <label asp-for="ProductName"
                                   class="admin-form-label">
                                Tên sản phẩm
                            </label>

                            <input asp-for="ProductName"
                                   class="form-control"
                                   required />
                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="mb-3">
                            <label asp-for="CategoryId"
                                   class="admin-form-label">
                                Danh mục
                            </label>

                            <select asp-for="CategoryId"
                                    class="form-select"
                                    asp-items="@(new SelectList(ViewBag.Categories, "CategoryId", "CategoryName"))">
                            </select>
                        </div>

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="Price"
                                   class="admin-form-label">
                                Giá
                            </label>

                            <input asp-for="Price"
                                   class="form-control"
                                   type="number"
                                   min="0"
                                   required />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="DiscountPercent"
                                   class="admin-form-label">
                                Giảm giá (%)
                            </label>

                            <input asp-for="DiscountPercent"
                                   class="form-control"
                                   type="number"
                                   min="0"
                                   max="100" />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="Quantity"
                                   class="admin-form-label">
                                Số lượng
                            </label>

                            <input asp-for="Quantity"
                                   class="form-control"
                                   type="number"
                                   min="0"
                                   required />
                        </div>
                    </div>

                </div>

                <div class="mb-3">
                    <label asp-for="Description"
                           class="admin-form-label">
                        Mô tả
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"></textarea>
                </div>
                <!-- =========================
                     THÔNG TIN SẢN PHẨM
                ========================= -->

                <div class="admin-card-header mt-4 mb-3">
                    <i class="bi bi-info-circle text-primary"></i>
                    <h4>Thông tin chi tiết sản phẩm</h4>
                </div>

                <div class="row">

                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="Brand"
                                   class="admin-form-label">
                                Thương hiệu
                            </label>

                            <input asp-for="Brand"
                                   class="form-control"
                                   placeholder="VD: Royal Canin, Whiskas..." />

                            <span asp-validation-for="Brand"
                                  class="text-danger">
                            </span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="Origin"
                                   class="admin-form-label">
                                Xuất xứ
                            </label>

                            <input asp-for="Origin"
                                   class="form-control"
                                   placeholder="VD: Pháp, Mỹ, Nhật Bản..." />

                            <span asp-validation-for="Origin"
                                  class="text-danger">
                            </span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="TargetPet"
                                   class="admin-form-label">
                                Đối tượng sử dụng
                            </label>

                            <input asp-for="TargetPet"
                                   class="form-control"
                                   placeholder="VD: Chó trưởng thành, mèo con..." />

                            <span asp-validation-for="TargetPet"
                                  class="text-danger">
                            </span>
                        </div>
                    </div>

                </div>

                <div class="mb-3">
                    <label asp-for="Ingredients"
                           class="admin-form-label">
                        Thành phần
                    </label>

                    <textarea asp-for="Ingredients"
                              class="form-control"
                              rows="4"
                              placeholder="Nhập thành phần sản phẩm..."></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="Nutrition"
                           class="admin-form-label">
                        Thông tin dinh dưỡng
                    </label>

                    <textarea asp-for="Nutrition"
                              class="form-control"
                              rows="4"
                              placeholder="Nhập thông tin dinh dưỡng..."></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="Usage"
                           class="admin-form-label">
                        Hướng dẫn sử dụng
                    </label>

                    <textarea asp-for="Usage"
                              class="form-control"
                              rows="4"
                              placeholder="Nhập hướng dẫn sử dụng..."></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="Storage"
                           class="admin-form-label">
                        Hướng dẫn bảo quản
                    </label>

                    <textarea asp-for="Storage"
                              class="form-control"
                              rows="3"
                              placeholder="Nhập hướng dẫn bảo quản..."></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="Warning"
                           class="admin-form-label">
                        Cảnh báo
                    </label>

                    <textarea asp-for="Warning"
                              class="form-control"
                              rows="3"
                              placeholder="Nhập cảnh báo hoặc lưu ý..."></textarea>
                </div>
                <div class="mb-3">

                    <label class="admin-form-label">
                        Ảnh hiện tại
                    </label>

                    <div>
                        <img src="@Model.ImageUrl"
                             class="admin-image-preview"
                             alt="@Model.ProductName" />
                    </div>

                </div>

                <div class="mb-3">

                    <label asp-for="ImageFile"
                           class="admin-form-label">
                        Ảnh mới
                    </label>

                    <input asp-for="ImageFile"
                           class="form-control"
                           type="file"
                           accept="image/*" />

                </div>

                <div class="admin-form-actions">

                    <button type="submit"
                            class="admin-btn-primary">
                        <i class="bi bi-check-circle"></i>
                        Cập nhật
                    </button>

                    <a asp-action="ProductList"
                       class="admin-btn-secondary">
                        <i class="bi bi-x-circle"></i>
                        Hủy
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>