@model IEnumerable<PetFeast.Models.Products.Product>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid admin-list-page">

    <div class="admin-page-header">

        <div>
            <h3 class="admin-page-title">
                Danh sách sản phẩm
            </h3>

            <p class="text-muted mb-0 mt-1">
                Quản lý sản phẩm, giá bán và tồn kho
            </p>
        </div>

        <form asp-controller="Admin"
              asp-action="ProductSearch"
              method="get"
              class="admin-search">

            <input type="text"
                   name="keyword"
                   placeholder="Tìm sản phẩm..."
                   value="@Context.Request.Query["keyword"]" />

            <button type="submit">
                <i class="bi bi-search"></i>
            </button>

        </form>

    </div>

    <div class="admin-card">

        <div class="admin-card-header">

            <h4>
                <i class="bi bi-box-seam me-2"></i>
                Quản lý sản phẩm
            </h4>

            <a asp-action="CreateProduct"
               class="admin-btn-add">

                <i class="bi bi-plus-circle"></i>
                Thêm sản phẩm

            </a>

        </div>

        <div class="admin-card-body">

            <div class="admin-table-wrapper">

                <table class="table admin-table">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Ảnh</th>
                            <th>Tên sản phẩm</th>
                            <th>Giá</th>
                            <th>Giảm giá</th>
                            <th>Tồn kho</th>
                            <th>Danh mục</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td class="fw-semibold">
                                    #@item.ProductId
                                </td>

                                <td>
                                    <img src="@item.ImageUrl"
                                         class="admin-product-image"
                                         alt="@item.ProductName" />
                                </td>

                                <td>
                                    <span class="fw-semibold">
                                        @item.ProductName
                                    </span>
                                </td>

                                <td>

                                    @if (item.DiscountPercent > 0)
                                    {
                                        <del class="text-muted small">
                                            @item.Price.ToString("N0") đ
                                        </del>

                                        <div class="text-danger fw-bold">
                                            @item.DiscountPrice.ToString("N0") đ
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="fw-bold">
                                            @item.Price.ToString("N0") đ
                                        </span>
                                    }

                                </td>

                                <td>
                                    @if (item.DiscountPercent > 0)
                                    {
                                        <span class="badge bg-danger">
                                            -@item.DiscountPercent%
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-secondary">
                                            Không giảm
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (item.Quantity <= 0)
                                    {
                                        <span class="badge bg-danger">
                                            Hết hàng
                                        </span>
                                    }
                                    else if (item.Quantity <= 5)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            @item.Quantity
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            @item.Quantity
                                        </span>
                                    }
                                </td>

                                <td>
                                    @item.Category?.CategoryName
                                </td>

                                <td>
                                    <div class="admin-action-buttons">

                                        <a asp-action="EditProduct"
                                           asp-route-id="@item.ProductId"
                                           class="btn btn-outline-warning"
                                           title="Sửa">

                                            <i class="bi bi-pencil-square"></i>

                                        </a>

                                        <a asp-action="DeleteProduct"
                                           asp-route-id="@item.ProductId"
                                           class="btn btn-outline-danger"
                                           title="Xóa"
                                           onclick="return confirm('Xóa sản phẩm này?')">

                                            <i class="bi bi-trash"></i>

                                        </a>

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>