@model IEnumerable<PetFeast.Models.Orders.Order>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid admin-list-page">

    <!-- HEADER -->
    <div class="admin-page-header">
        <div>
            <h3 class="admin-page-title">
                Quản lý đơn hàng
            </h3>

            <p class="text-muted mb-0 mt-1">
                Theo dõi đơn hàng, thanh toán và trạng thái giao hàng
            </p>
        </div>
    </div>

    <!-- CARD -->
    <div class="admin-card">

        <div class="admin-card-header">
            <div>
                <h4 class="mb-1">
                    <i class="bi bi-receipt me-2"></i>
                    Danh sách đơn hàng
                </h4>

                <small class="opacity-75">
                    Tổng cộng @Model.Count() đơn hàng
                </small>
            </div>
        </div>

        <div class="admin-card-body">

            @if (!Model.Any())
            {
                <div class="admin-empty-state">
                    <i class="bi bi-inbox"></i>

                    <h5>Chưa có đơn hàng</h5>

                    <p class="text-muted mb-0">
                        Hiện tại chưa có đơn hàng nào trong hệ thống.
                    </p>
                </div>
            }
            else
            {
                <div class="admin-table-wrapper">

                    <table class="table admin-table order-table">

                        <thead>
                            <tr>
                                <th>Mã đơn</th>
                                <th>Khách hàng</th>
                                <th>Ngày đặt</th>
                                <th>Tổng tiền</th>
                                <th>Thanh toán</th>
                                <th>Trạng thái</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <!-- MÃ ĐƠN -->
                                    <td>
                                        <a asp-action="OrderDetail"
                                           asp-route-id="@item.OrderId"
                                           class="order-code">
                                            #@item.OrderId
                                        </a>
                                    </td>

                                    <!-- KHÁCH HÀNG -->
                                    <td>
                                        <div class="customer-info">

                                            <div class="customer-avatar">
                                                <i class="bi bi-person-fill"></i>
                                            </div>

                                            <div>
                                                <div class="customer-name">
                                                    @(item.User?.FullName
                                                                                                ?? item.CustomerName
                                                                                                ?? "Khách hàng")
                                        </div>

                                        @if (item.User != null)
                                                {
                                                    <small class="text-muted">
                                                        @item.User.Email
                                                    </small>
                                                }
                                            </div>

                                        </div>
                                    </td>

                                    <!-- NGÀY ĐẶT -->
                                    <td>
                                        <div class="order-date">
                                            <strong>
                                                @item.OrderDate.ToString("dd/MM/yyyy")
                                            </strong>

                                            <small>
                                                @item.OrderDate.ToString("HH:mm")
                                            </small>
                                        </div>
                                    </td>

                                    <!-- TỔNG TIỀN -->
                                    <td>
                                        <strong class="order-total">
                                            @item.TotalAmount.ToString("N0")đ
                                        </strong>
                                    </td>

                                    <!-- THANH TOÁN -->
                                    <td>
                                        @if (item.PaymentMethod == "BankTransfer")
                                        {
                                            @if (item.PaymentStatus == "Đã thanh toán")
                                            {
                                                <span class="admin-status status-success">
                                                    <i class="bi bi-check-circle"></i>
                                                    Đã thanh toán
                                                </span>
                                            }
                                            else if (item.PaymentStatus == "Đã hoàn tiền")
                                            {
                                                <span class="admin-status status-refunded">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                    Đã hoàn tiền
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="admin-status status-warning">
                                                    <i class="bi bi-clock"></i>
                                                    Chờ xác nhận
                                                </span>

                                                <small class="payment-method">
                                                    Chuyển khoản
                                                </small>
                                            }
                                        }
                                        else
                                        {
                                            @if (item.PaymentStatus == "Đã thanh toán")
                                            {
                                                <span class="admin-status status-success">
                                                    <i class="bi bi-check-circle"></i>
                                                    Đã thanh toán
                                                </span>
                                            }
                                            else if (item.PaymentStatus == "Đã hoàn tiền")
                                            {
                                                <span class="admin-status status-refunded">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                    Đã hoàn tiền
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="admin-status status-secondary">
                                                    <i class="bi bi-wallet2"></i>
                                                    COD
                                                </span>
                                            }
                                        }
                                    </td>

                                    <!-- TRẠNG THÁI -->
                                    <td>
                                        @if (item.Status == "Chờ xác nhận")
                                        {
                                            <span class="admin-status status-warning">
                                                <i class="bi bi-clock"></i>
                                                Chờ xác nhận
                                            </span>
                                        }
                                        else if (item.Status == "Đang giao")
                                        {
                                            <span class="admin-status status-primary">
                                                <i class="bi bi-truck"></i>
                                                Đang giao
                                            </span>
                                        }
                                        else if (item.Status == "Hoàn thành")
                                        {
                                            <span class="admin-status status-success">
                                                <i class="bi bi-check-circle"></i>
                                                Hoàn thành
                                            </span>
                                        }
                                        else if (item.Status == "Đã hủy")
                                        {
                                            <span class="admin-status status-danger">
                                                <i class="bi bi-x-circle"></i>
                                                Đã hủy
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="admin-status status-secondary">
                                                @item.Status
                                            </span>
                                        }
                                    </td>

                                    <!-- THAO TÁC -->
                                    <td>
                                        <div class="admin-order-actions">

                                            <!-- CHI TIẾT -->
                                            <a asp-action="OrderDetail"
                                               asp-route-id="@item.OrderId"
                                               class="admin-detail-btn"
                                               title="Xem chi tiết">

                                                <i class="bi bi-eye"></i>
                                                Chi tiết
                                            </a>

                                            <!-- XÁC NHẬN THANH TOÁN -->
                                            @if (item.PaymentMethod == "BankTransfer"
                                                                                && item.PaymentStatus != "Đã thanh toán"
                                                                                && item.PaymentStatus != "Đã hoàn tiền"
                                                                                && item.Status == "Chờ xác nhận")
                                            {
                                                <form asp-action="ConfirmPayment"
                                                      method="post"
                                                      onsubmit="return confirm('Xác nhận đơn hàng đã thanh toán?')">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@item.OrderId" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success"
                                                            title="Xác nhận thanh toán">

                                                        <i class="bi bi-check2-circle"></i>
                                                    </button>

                                                </form>
                                            }

                                            <!-- XÁC NHẬN ĐƠN -->
                                            @if (item.Status == "Chờ xác nhận"
                                                                                && (item.PaymentMethod == "COD"
                                                                                || item.PaymentStatus == "Đã thanh toán"))
                                            {
                                                <form asp-action="ConfirmOrder"
                                                      method="post"
                                                      onsubmit="return confirm('Xác nhận đơn hàng này?')">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@item.OrderId" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-primary"
                                                            title="Xác nhận đơn hàng">

                                                        <i class="bi bi-box-seam"></i>
                                                    </button>

                                                </form>
                                            }

                                            <!-- HOÀN THÀNH -->
                                            @if (item.Status == "Đang giao")
                                            {
                                                <form asp-action="CompleteOrder"
                                                      method="post"
                                                      onsubmit="return confirm('Xác nhận đơn hàng đã hoàn thành?')">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@item.OrderId" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success"
                                                            title="Hoàn thành">

                                                        <i class="bi bi-check-lg"></i>
                                                    </button>

                                                </form>
                                            }

                                            <!-- HỦY ĐƠN -->
                                            @if (item.Status != "Đã hủy"
                                                                                && item.Status != "Hoàn thành")
                                            {
                                                <form asp-action="CancelOrder"
                                                      method="post"
                                                      onsubmit="return confirm('Bạn có chắc muốn hủy đơn hàng này?')">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@item.OrderId" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="Hủy đơn hàng">

                                                        <i class="bi bi-x-lg"></i>
                                                    </button>

                                                </form>
                                            }

                                        </div>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>
</div>