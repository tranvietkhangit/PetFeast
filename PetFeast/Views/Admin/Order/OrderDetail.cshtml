        border: 1px solid #e9ecef;
        border-radius: 14px;
        box-shadow: 0 3px 12px rgba(0, 0, 0, .04);
    }

        .order-action-card h5 {
            margin: 0;
            font-size: 16px;
            font-weight: 700;
        }

        .order-action-card > div:first-child span {
            display: block;
            margin-top: 4px;
            color: #8a8f98;
            font-size: 12px;
