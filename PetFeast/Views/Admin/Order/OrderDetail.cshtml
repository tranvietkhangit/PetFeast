@section Scripts {
            <script>
                document.addEventListener("DOMContentLoaded", function () {

                    document.addEventListener("submit", function (event) {

                        const form = event.target;

                        let message = null;

                        if (form.classList.contains("approve-return-form")) {

                            message =
                                "Bạn có chắc muốn duyệt yêu cầu trả hàng này?";

                        }
                        else if (form.classList.contains("reject-return-form")) {

                            message =
                                "Bạn có chắc muốn từ chối yêu cầu này?";

                        }
                        else if (form.classList.contains("waiting-return-form")) {

                            message =
                                "Xác nhận chuyển yêu cầu sang trạng thái Đang chờ nhận hàng?";

                        }
                        else if (form.classList.contains("received-return-form")) {

                            message =
                                "Xác nhận PetFeast đã nhận được sản phẩm trả về?";

                        }
                        else if (form.classList.contains("inspect-return-form")) {

                            message =
                                "Xác nhận bắt đầu kiểm tra sản phẩm?";

                        }
                        else if (form.classList.contains("refund-return-form")) {

                            message =
                                "Xác nhận sản phẩm đạt điều kiện và thực hiện hoàn tiền?";

                        }
                        else if (form.classList.contains("detail-confirm-payment-form")) {

                            message =
                                "Bạn đã kiểm tra và xác nhận số tiền chuyển khoản của đơn hàng này?";

                        }
                        else if (form.classList.contains("detail-confirm-order-form")) {

                            message =
                                "Xác nhận đơn hàng và chuyển sang trạng thái Đang giao?";

                        }
                        else if (form.classList.contains("detail-complete-order-form")) {

                            message =
                                "Xác nhận đơn hàng đã giao thành công?";

                        }
                        else if (form.classList.contains("detail-cancel-order-form")) {

                            message =
                                "Bạn có chắc muốn hủy đơn hàng này? Điểm, voucher và tồn kho sẽ được hoàn lại?";

                        }

                        if (!message) {
                            return;
                        }

                        event.preventDefault();

                        showConfirmModal(
                            message,
                            function () {
                                form.submit();
                            }
                        );

                    });

                });
            </script>
}
