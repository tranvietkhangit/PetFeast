        padding: 10px 15px;
        border: 1px solid #0d6efd;
        border-radius: 8px;
        color: #0d6efd;
        text-decoration: none;
        font-weight: 600;
        transition: .2s;
    }

        .return-detail-btn:hover {
            background: #0d6efd;
            color: #fff;
