@model PetFeast.Models.Orders.Order

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var orderDetails = Model.OrderDetails
        ?? new List<PetFeast.Models.Orders.OrderDetail>();

    var productSubtotal = orderDetails.Sum(x => x.Price * x.Quantity);
    var productCount = orderDetails.Sum(x => x.Quantity);
}

<div class="admin-page admin-order-detail">

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <div class="order-detail-top">

        <a asp-controller="Admin"
           asp-action="OrderList"
           class="order-back-btn">

            <i class="bi bi-arrow-left"></i>
            Quay lại đơn hàng

        </a>

        <div class="order-title-row">

            <div>

                <div class="order-title-line">

                    <h2>
                        Đơn hàng #@Model.OrderId
                    </h2>

                    @if (Model.Status == "Chờ xác nhận")
                    {
                        <span class="order-status status-pending">
                            <i class="bi bi-clock me-1"></i>
                            Chờ xác nhận
                        </span>
                    }
                    else if (Model.Status == "Đang giao")
                    {
                        <span class="order-status status-shipping">
                            <i class="bi bi-truck me-1"></i>
                            Đang giao
                        </span>
                    }
                    else if (Model.Status == "Hoàn thành")
                    {
                        <span class="order-status status-completed">
                            <i class="bi bi-check-circle me-1"></i>
                            Hoàn thành
                        </span>
                    }
                    else if (Model.Status == "Đã hủy")
                    {
                        <span class="order-status status-cancelled">
                            <i class="bi bi-x-circle me-1"></i>
                            Đã hủy
                        </span>
                    }
                    else
                    {
                        <span class="order-status status-other">
                            @Model.Status
                        </span>
                    }

                </div>

                <div class="order-created">

                    <i class="bi bi-calendar3 me-1"></i>

                    Đặt ngày
                    @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- THÔNG TIN TỔNG QUAN -->
    <!-- ===================================================== -->

    <div class="order-info-grid">

        <!-- KHÁCH HÀNG -->
        <div class="order-info-card">

            <div class="order-info-header">

                <div class="order-info-icon">
                    <i class="bi bi-person"></i>
                </div>

                <div>

                    <h5>Khách hàng</h5>

                    <span>
                        Thông tin người đặt
                    </span>

                </div>

            </div>

            <div class="order-info-body">

                <div class="info-row">

                    <span>Họ tên</span>

                    <strong>
                        @Model.CustomerName
                    </strong>

                </div>

                <div class="info-row">

                    <span>Số điện thoại</span>

                    <strong>
                        @Model.Phone
                    </strong>

                </div>

                <div class="info-row info-address">

                    <span>Địa chỉ</span>

                    <strong>
                        @Model.Address
                    </strong>

                </div>

            </div>

        </div>


        <!-- GIAO NHẬN -->
        <div class="order-info-card">

            <div class="order-info-header">

                <div class="order-info-icon shipping-icon">
                    <i class="bi bi-truck"></i>
                </div>

                <div>

                    <h5>Giao nhận</h5>

                    <span>
                        Phương thức nhận hàng
                    </span>

                </div>

            </div>

            <div class="order-info-body">

                <div class="info-row">

                    <span>Phương thức</span>

                    @if (Model.DeliveryMethod == "Ship")
                    {
                        <strong class="info-highlight">
                            <i class="bi bi-truck me-1"></i>
                            Giao hàng
                        </strong>
                    }
                    else
                    {
                        <strong class="info-highlight">
                            <i class="bi bi-shop me-1"></i>
                            Nhận tại cửa hàng
                        </strong>
                    }

                </div>

                <div class="info-row">

                    <span>Phí vận chuyển</span>

                    <strong>

                        @if (Model.DeliveryMethod == "Ship")
                        {
                            @Model.ShippingFee.ToString("N0")
                        
                            @: đ
                        }
                        else
                        {
                            @:0 đ
                        }

                    </strong>

                </div>

                @if (Model.CompletedDate.HasValue)
                {
                    <div class="info-row">

                        <span>Hoàn thành</span>

                        <strong>
                            @Model.CompletedDate.Value.ToString("dd/MM/yyyy HH:mm")
                        </strong>

                    </div>
                }

            </div>

        </div>


        <!-- THANH TOÁN -->
        <div class="order-info-card">

            <div class="order-info-header">

                <div class="order-info-icon payment-icon">
                    <i class="bi bi-credit-card"></i>
                </div>

                <div>

                    <h5>Thanh toán</h5>

                    <span>
                        Thông tin thanh toán
                    </span>

                </div>

            </div>

            <div class="order-info-body">

                <div class="info-row">

                    <span>Phương thức</span>

                    @if (Model.PaymentMethod == "BankTransfer")
                    {
                        <strong>
                            <i class="bi bi-bank me-1"></i>
                            Chuyển khoản
                        </strong>
                    }
                    else
                    {
                        <strong>
                            <i class="bi bi-cash-coin me-1"></i>
                            COD
                        </strong>
                    }

                </div>

                <div class="info-row">

                    <span>Trạng thái</span>

                    @if (Model.PaymentStatus == "Đã thanh toán")
                    {
                        <span class="payment-paid">

                            <i class="bi bi-check-circle me-1"></i>
                            Đã thanh toán

                        </span>
                    }
                    else
                    {
                        <span class="payment-unpaid">

                            <i class="bi bi-clock me-1"></i>
                            Chưa thanh toán

                        </span>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- GHI CHÚ KHÁCH HÀNG -->
    <!-- ===================================================== -->
    @if (!string.IsNullOrWhiteSpace(Model.Note))
    {
        <div class="order-note-card">

            <div class="order-note-icon">
                <i class="bi bi-chat-left-text"></i>
            </div>

            <div>

                <div class="order-note-title">
                    Ghi chú của khách hàng
                </div>

                <div class="order-note-content">
                    @Model.Note
                </div>

            </div>

        </div>
    }


    <!-- ===================================================== -->
    <!-- CHI TIẾT SẢN PHẨM -->
    <!-- ===================================================== -->

    <div class="order-section-card">

        <div class="order-section-header">

            <div>

                <h5>
                    <i class="bi bi-bag me-2"></i>
                    Sản phẩm trong đơn
                </h5>

                <span>
                    @productCount sản phẩm
                </span>

            </div>

        </div>


        <div class="order-products">

            @foreach (var item in orderDetails)
            {
                <div class="order-product">

                    <!-- SẢN PHẨM -->

                    <div class="order-product-main">

                        <img src="@item.Product?.ImageUrl"
                             class="order-product-image"
                             alt="@item.Product?.ProductName" />

                        <div class="order-product-info">

                            <h6>
                                @item.Product?.ProductName
                            </h6>

                            <span>
                                Mã SP: @item.ProductId
                            </span>

                        </div>

                    </div>


                    <!-- ĐƠN GIÁ -->

                    <div class="order-product-price">

                        <span>
                            Đơn giá
                        </span>

                        <strong>
                            @item.Price.ToString("N0") đ
                        </strong>

                    </div>


                    <!-- SỐ LƯỢNG -->

                    <div class="order-product-quantity">

                        <span class="quantity-badge">
                            × @item.Quantity
                        </span>

                    </div>


                    <!-- THÀNH TIỀN -->

                    <div class="order-product-total">

                        <span>
                            Thành tiền
                        </span>

                        <strong>
                            @((item.Price * item.Quantity).ToString("N0")) đ
                        </strong>

                    </div>

                </div>
            }

        </div>


        <!-- ================================================= -->
        <!-- TỔNG TIỀN -->
        <!-- ================================================= -->

        <div class="order-total-wrapper">

            <div class="order-total-card">

                <div class="order-total-row">

                    <span>
                        Tiền sản phẩm
                    </span>

                    <strong>
                        @productSubtotal.ToString("N0") đ
                    </strong>

                </div>


                @if (Model.PointDiscount > 0)
                {
                    <div class="order-total-row discount">

                        <span>

                            <i class="bi bi-coin me-1"></i>
                            Giảm bằng điểm

                        </span>

                        <strong>
                            -@Model.PointDiscount.ToString("N0") đ
                        </strong>

                    </div>
                }


                @if (Model.VoucherDiscount > 0)
                {
                    <div class="order-total-row discount">

                        <span>

                            <i class="bi bi-ticket-perforated me-1"></i>
                            Giảm voucher

                        </span>

                        <strong>
                            -@Model.VoucherDiscount.ToString("N0") đ
                        </strong>

                    </div>
                }


                <div class="order-total-row">

                    <span>
                        Phí vận chuyển
                    </span>

                    <strong>

                        @if (Model.DeliveryMethod == "Ship")
                        {
                            @Model.ShippingFee.ToString("N0")
                        
                            @: đ
                        }
                        else
                        {
                            @:0 đ
                        }

                    </strong>

                </div>


                <div class="order-grand-total">

                    <span>
                        Tổng thanh toán
                    </span>

                    <strong>
                        @Model.TotalAmount.ToString("N0") đ
                    </strong>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- VOUCHER -->
    <!-- ===================================================== -->
    @if (Model.UserVoucher != null)
    {
        <div class="voucher-info-card">

            <div class="voucher-info-icon">
                <i class="bi bi-ticket-perforated"></i>
            </div>

            <div class="voucher-info-content">

                <h6>
                    Voucher đã sử dụng
                </h6>

                <div class="voucher-info-details">

                    <span>
                        Giảm
                        <strong>
                            @Model.VoucherDiscount.ToString("N0") đ
                        </strong>
                    </span>

                    @if (Model.UserVoucher.IsUsed)
                    {
                        <span class="voucher-used">
                            <i class="bi bi-check-circle me-1"></i>
                            Đã sử dụng
                        </span>
                    }
                    else
                    {
                        <span class="voucher-unused">
                            Chưa sử dụng
                        </span>
                    }

                </div>

            </div>

        </div>
    }


    <!-- ===================================================== -->
    <!-- HỦY ĐƠN -->
    <!-- ===================================================== -->
    @if (Model.Status == "Đã hủy"
        && !string.IsNullOrWhiteSpace(Model.CancellationReason))
    {
        <div class="order-alert-card cancellation-card">

            <div class="order-alert-header">

                <div class="order-alert-icon">
                    <i class="bi bi-x-circle"></i>
                </div>

                <div>

                    <h5>
                        Đơn hàng đã bị hủy
                    </h5>

                    <span>
                        Lý do hủy đơn
                    </span>

                </div>

            </div>

            <div class="order-alert-content">

                @Model.CancellationReason

            </div>

        </div>
    }


    <!-- ===================================================== -->
    <!-- YÊU CẦU TRẢ HÀNG -->
    <!-- ===================================================== -->
    @if (Model.ReturnRequest != null)
    {
        <div class="return-request-card">

            <!-- HEADER -->

            <div class="return-request-header">

                <div class="return-title">

                    <div class="return-icon">
                        <i class="bi bi-arrow-return-left"></i>
                    </div>

                    <div>

                        <h5>
                            Yêu cầu trả hàng
                        </h5>

                        <span>
                            Yêu cầu xử lý hoàn trả sản phẩm
                        </span>

                    </div>

                </div>


                <!-- STATUS -->

                <div>

                    @if (Model.ReturnRequest.Status == "Chờ xử lý")
                    {
                        <span class="return-status return-pending">
                            <i class="bi bi-clock me-1"></i>
                            Chờ xử lý
                        </span>
                    }
                    else if (Model.ReturnRequest.Status == "Đã duyệt")
                    {
                        <span class="return-status return-approved">
                            <i class="bi bi-check-circle me-1"></i>
                            Đã duyệt
                        </span>
                    }
                    else if (Model.ReturnRequest.Status == "Đang chờ nhận hàng")
                    {
                        <span class="return-status return-waiting">
                            <i class="bi bi-box-seam me-1"></i>
                            Đang chờ nhận hàng
                        </span>
                    }
                    else if (Model.ReturnRequest.Status == "Đã nhận hàng")
                    {
                        <span class="return-status return-received">
                            <i class="bi bi-box2-heart me-1"></i>
                            Đã nhận hàng
                        </span>
                    }
                    else if (Model.ReturnRequest.Status == "Đang kiểm tra")
                    {
                        <span class="return-status return-inspecting">
                            <i class="bi bi-search me-1"></i>
                            Đang kiểm tra
                        </span>
                    }
                    else if (Model.ReturnRequest.Status == "Đã hoàn tiền")
                    {
                        <span class="return-status return-refunded">
                            <i class="bi bi-cash-coin me-1"></i>
                            Đã hoàn tiền
                        </span>
                    }
                    else if (Model.ReturnRequest.Status == "Từ chối")
                    {
                        <span class="return-status return-rejected">
                            <i class="bi bi-x-circle me-1"></i>
                            Từ chối
                        </span>
                    }
                    else
                    {
                        <span class="return-status return-other">
                            @Model.ReturnRequest.Status
                        </span>
                    }

                </div>

            </div>


            <!-- BODY -->

            <div class="return-request-body">

                <div class="return-detail-grid">

                    <!-- LÝ DO -->

                    <div class="return-detail-item">

                        <span>
                            Lý do
                        </span>

                        <strong>
                            @Model.ReturnRequest.Reason
                        </strong>

                    </div>


                    <!-- NGÀY YÊU CẦU -->

                    <div class="return-detail-item">

                        <span>
                            Ngày yêu cầu
                        </span>

                        <strong>
                            @Model.ReturnRequest.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </strong>

                    </div>


                    @if (Model.ReturnRequest.ApprovedAt.HasValue)
                    {
                        <div class="return-detail-item">

                            <span>
                                Ngày duyệt
                            </span>

                            <strong>
                                @Model.ReturnRequest.ApprovedAt.Value.ToString("dd/MM/yyyy HH:mm")
                            </strong>

                        </div>
                    }


                    @if (Model.ReturnRequest.ReturnFee > 0)
                    {
                        <div class="return-detail-item">

                            <span>
                                Phí trả hàng
                            </span>

                            <strong>
                                @Model.ReturnRequest.ReturnFee.ToString("N0") đ
                            </strong>

                        </div>
                    }


                    @if (Model.ReturnRequest.RefundAmount > 0)
                    {
                        <div class="return-detail-item">

                            <span>
                                Số tiền hoàn
                            </span>

                            <strong class="refund-value">
                                @Model.ReturnRequest.RefundAmount.ToString("N0") đ
                            </strong>

                        </div>
                    }

                </div>


                <!-- MÔ TẢ -->
                @if (!string.IsNullOrWhiteSpace(Model.ReturnRequest.Description))
                {
                    <div class="return-description">

                        <span>
                            Mô tả của khách hàng
                        </span>

                        <p>
                            @Model.ReturnRequest.Description
                        </p>

                    </div>
                }


                <!-- ADMIN NOTE -->
                @if (!string.IsNullOrWhiteSpace(Model.ReturnRequest.AdminNote))
                {
                    <div class="admin-return-note">

                        <div>

                            <i class="bi bi-info-circle me-1"></i>

                            <strong>
                                Ghi chú của Admin
                            </strong>

                        </div>

                        <p>
                            @Model.ReturnRequest.AdminNote
                        </p>

                    </div>
                }


                <!-- ================================================= -->
                <!-- BẰNG CHỨNG -->
                <!-- ================================================= -->
                @if (!string.IsNullOrWhiteSpace(Model.ReturnRequest.EvidenceImageUrl)
                            || !string.IsNullOrWhiteSpace(Model.ReturnRequest.EvidenceVideoUrl))
                {
                    <div class="return-evidence">

                        <h6>

                            <i class="bi bi-paperclip me-1"></i>
                            Bằng chứng

                        </h6>


                        <div class="evidence-grid">

                            @if (!string.IsNullOrWhiteSpace(Model.ReturnRequest.EvidenceImageUrl))
                            {
                                <a href="@Model.ReturnRequest.EvidenceImageUrl"
                                   target="_blank"
                                   class="evidence-image">

                                    <img src="@Model.ReturnRequest.EvidenceImageUrl"
                                         alt="Ảnh bằng chứng trả hàng" />

                                    <span>
                                        <i class="bi bi-arrows-fullscreen"></i>
                                        Xem ảnh
                                    </span>

                                </a>
                            }


                            @if (!string.IsNullOrWhiteSpace(Model.ReturnRequest.EvidenceVideoUrl))
                            {
                                <a href="@Model.ReturnRequest.EvidenceVideoUrl"
                                   target="_blank"
                                   class="evidence-video-link">

                                    <i class="bi bi-play-circle"></i>

                                    <span>
                                        Xem video bằng chứng
                                    </span>

                                </a>
                            }

                        </div>

                    </div>
                }


                <!-- ================================================= -->
                <!-- XỬ LÝ YÊU CẦU -->
                <!-- ================================================= -->

                <div class="return-actions">

                    <h6>
                        <i class="bi bi-gear me-1"></i>
                        Xử lý yêu cầu
                    </h6>


                    <!-- CHỜ XỬ LÝ -->
                    @if (Model.ReturnRequest.Status == "Chờ xử lý")
                    {
                        <div class="return-action-area">

                            <!-- DUYỆT -->

                            <form asp-controller="Admin"
                                  asp-action="ApproveReturnRequest"
                                  asp-route-id="@Model.ReturnRequest.ReturnRequestId"
                                  method="post"
                                  class="approve-return-form">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-primary btn-approve">

                                    <i class="bi bi-check-circle me-1"></i>
                                    Duyệt yêu cầu

                                </button>

                            </form>


                            <!-- TỪ CHỐI -->

                            <form asp-controller="Admin"
                                  asp-action="RejectReturnRequest"
                                  asp-route-id="@Model.ReturnRequest.ReturnRequestId"
                                  method="post"
                                  class="reject-return-form">

                                @Html.AntiForgeryToken()

                                <input type="text"
                                       name="adminNote"
                                       class="form-control"
                                       placeholder="Nhập lý do từ chối..."
                                       required />

                                <button type="submit"
                                        class="btn btn-danger">

                                    <i class="bi bi-x-circle me-1"></i>
                                    Từ chối

                                </button>

                            </form>

                        </div>
                    }


                    <!-- ĐÃ DUYỆT -->
                    @if (Model.ReturnRequest.Status == "Đã duyệt")
                    {
                        <form asp-controller="Admin"
                              asp-action="SetReturnWaitingForProduct"
                              asp-route-id="@Model.ReturnRequest.ReturnRequestId"
                              method="post"
                              class="waiting-return-form">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-box-seam me-1"></i>
                                Chờ nhận hàng

                            </button>

                        </form>
                    }


                    <!-- ĐANG CHỜ NHẬN -->
                    @if (Model.ReturnRequest.Status == "Đang chờ nhận hàng")
                    {
                        <form asp-controller="Admin"
                              asp-action="SetReturnReceived"
                              asp-route-id="@Model.ReturnRequest.ReturnRequestId"
                              method="post"
                              class="received-return-form">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-box-arrow-in-down me-1"></i>
                                Đã nhận hàng

                            </button>

                        </form>
                    }


                    <!-- ĐÃ NHẬN -->
                    @if (Model.ReturnRequest.Status == "Đã nhận hàng")
                    {
                        <form asp-controller="Admin"
                              asp-action="SetReturnInspecting"
                              asp-route-id="@Model.ReturnRequest.ReturnRequestId"
                              method="post"
                              class="inspect-return-form">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-warning">

                                <i class="bi bi-search me-1"></i>
                                Bắt đầu kiểm tra

                            </button>

                        </form>
                    }


                    <!-- ĐANG KIỂM TRA -->
                    @if (Model.ReturnRequest.Status == "Đang kiểm tra")
                    {
                        <form asp-controller="Admin"
                              asp-action="SetReturnRefunded"
                              asp-route-id="@Model.ReturnRequest.ReturnRequestId"
                              method="post"
                              class="refund-return-form">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-success">

                                <i class="bi bi-cash-coin me-1"></i>
                                Xác nhận hoàn tiền

                            </button>

                        </form>
                    }


                    <!-- HOÀN TẤT / TỪ CHỐI -->
                    @if (Model.ReturnRequest.Status == "Đã hoàn tiền"
                                    || Model.ReturnRequest.Status == "Từ chối")
                    {
                        <div class="return-finished">

                            @if (Model.ReturnRequest.Status == "Đã hoàn tiền")
                            {
                                <i class="bi bi-check-circle text-success"></i>

                                <strong class="text-success">
                                    Yêu cầu đã được hoàn tất.
                                </strong>
                            }
                            else
                            {
                                <i class="bi bi-x-circle text-danger"></i>

                                <strong class="text-danger">
                                    Yêu cầu trả hàng đã bị từ chối.
                                </strong>
                            }

                        </div>
                    }

                </div>


                <!-- XEM CHI TIẾT -->

                <a asp-controller="Admin"
                   asp-action="ReturnRequestDetail"
                   asp-route-id="@Model.ReturnRequest.ReturnRequestId"
                   class="return-detail-btn">

                    <i class="bi bi-eye me-1"></i>
                    Xem chi tiết yêu cầu trả hàng

                </a>

            </div>

        </div>
    }


    <!-- ===================================================== -->
    <!-- ACTION BAR -->
    <!-- ===================================================== -->

    <div class="order-action-card">

        <div>

            <h5>
                <i class="bi bi-gear me-2"></i>
                Xử lý đơn hàng
            </h5>

            <span>
                Thực hiện các thao tác phù hợp với trạng thái hiện tại
            </span>

        </div>


        <div class="order-action-buttons">

            <!-- ============================================= -->
            <!-- CHỜ XÁC NHẬN -->
            <!-- ============================================= -->
            @if (Model.Status == "Chờ xác nhận")
            {
                <!-- XÁC NHẬN THANH TOÁN -->
                @if (Model.PaymentMethod == "BankTransfer"
                            && Model.PaymentStatus != "Đã thanh toán")
                {
                    <form asp-controller="Admin"
                          asp-action="ConfirmPayment"
                          asp-route-id="@Model.OrderId"
                          method="post"
                          class="detail-confirm-payment-form">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-warning fw-bold">

                            <i class="bi bi-cash-coin me-1"></i>
                            Xác nhận thanh toán

                        </button>

                    </form>
                }


                <!-- XÁC NHẬN ĐƠN -->
                @if (Model.PaymentMethod == "COD"
                            || (Model.PaymentMethod == "BankTransfer"
                            && Model.PaymentStatus == "Đã thanh toán"))
                {
                    <form asp-controller="Admin"
                          asp-action="ConfirmOrder"
                          asp-route-id="@Model.OrderId"
                          method="post"
                          class="detail-confirm-order-form">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-primary fw-bold">

                            <i class="bi bi-truck me-1"></i>
                            Xác nhận đơn

                        </button>

                    </form>
                }
            }


            <!-- ============================================= -->
            <!-- ĐANG GIAO -->
            <!-- ============================================= -->
            @if (Model.Status == "Đang giao")
            {
                <form asp-controller="Admin"
                      asp-action="CompleteOrder"
                      asp-route-id="@Model.OrderId"
                      method="post"
                      class="detail-complete-order-form">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-success fw-bold">

                        <i class="bi bi-check-circle me-1"></i>
                        Hoàn thành đơn hàng

                    </button>

                </form>
            }


            <!-- ============================================= -->
            <!-- HỦY ĐƠN -->
            <!-- ============================================= -->
            @if (Model.Status != "Hoàn thành"
                        && Model.Status != "Đã hủy")
            {
                <form asp-controller="Admin"
                      asp-action="CancelOrder"
                      asp-route-id="@Model.OrderId"
                      method="post"
                      class="detail-cancel-order-form">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-outline-danger fw-bold">

                        <i class="bi bi-x-circle me-1"></i>
                        Hủy đơn hàng

                    </button>

                </form>
            }

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- CSS -->
<!-- ========================================================= -->

