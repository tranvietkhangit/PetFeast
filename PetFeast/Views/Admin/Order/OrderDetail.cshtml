        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        flex-wrap: wrap;
    }

        .order-action-buttons form {
            margin: 0;
        }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 1100px) {
        .order-info-grid

    {
        grid-template-columns: 1fr 1fr;
    }

    .order-product {
        grid-template-columns: minmax(200px, 1fr) 130px 80px;
    }

    .order-product-total {
        grid-column: 2 / -1;
        text-align: right;
    }

    .return-detail-grid {
        grid-template-columns: 1fr 1fr;
    }

    }


    @@media (max-width: 768px) {
        .order-title-row

    {
        align-items: flex-start;
        flex-direction: column;
    }

    .order-title-line {
        align-items: flex-start;
        flex-direction: column;
    }

    .order-info-grid {
