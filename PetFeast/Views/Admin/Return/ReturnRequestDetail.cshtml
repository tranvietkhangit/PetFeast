@model PetFeast.Models.Orders.ReturnRequest

@{
    ViewData["Title"] = "Chi tiết yêu cầu trả hàng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var order = Model.Order;
    var user = Model.User;
}

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-controller="Admin"
                   asp-action="ReturnRequestList"
                   class="back-link">
                    <i class="bi bi-arrow-left"></i>
                </a>

                <h3 class="fw-bold mb-0">
                    Chi tiết yêu cầu trả hàng
                </h3>
            </div>

            <p class="text-muted mb-0">
                Yêu cầu #@Model.ReturnRequestId
            </p>
        </div>

        <div>
            @switch (Model.Status)
            {
                case "Chờ xử lý":
                    <span class="status-badge status-pending">
                        <i class="bi bi-clock me-1"></i>
                        Chờ xử lý
                    </span>
                    break;

                case "Đã duyệt":
                    <span class="status-badge status-approved">
                        <i class="bi bi-check-circle me-1"></i>
                        Đã duyệt
                    </span>
                    break;

                case "Đang chờ nhận hàng":
                    <span class="status-badge status-shipping">
                        <i class="bi bi-box-seam me-1"></i>
                        Đang chờ nhận hàng
                    </span>
                    break;

                case "Đã nhận hàng":
                    <span class="status-badge status-received">
                        <i class="bi bi-box2-heart me-1"></i>
                        Đã nhận hàng
                    </span>
                    break;

                case "Đang kiểm tra":
                    <span class="status-badge status-inspecting">
                        <i class="bi bi-search me-1"></i>
                        Đang kiểm tra
                    </span>
                    break;

                case "Đã hoàn tiền":
                    <span class="status-badge status-completed">
                        <i class="bi bi-cash-coin me-1"></i>
                        Đã hoàn tiền
                    </span>
                    break;

                case "Từ chối":
                    <span class="status-badge status-rejected">
                        <i class="bi bi-x-circle me-1"></i>
                        Từ chối
                    </span>
                    break;

                default:
                    <span class="status-badge status-default">
                        @Model.Status
                    </span>
                    break;
            }
        </div>

    </div>

    <div class="row g-4">

        <!-- =========================
             LEFT
        ========================== -->

        <div class="col-lg-8">

            <!-- CUSTOMER -->
            <div class="card detail-card mb-4">

                <div class="card-header">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-person me-2 text-primary"></i>
                        Thông tin khách hàng
                    </h5>
                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <div class="info-label">
                                Họ tên
                            </div>

                            <div class="info-value">
                                @(user?.FullName ?? "Không xác định")
                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="info-label">
                                Email
                            </div>

                            <div class="info-value">
                                @(user?.Email ?? "Không xác định")
                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="info-label">
                                Số điện thoại
                            </div>

                            <div class="info-value">
                                @(order?.Phone ?? user?.PhoneNumber ?? "Không xác định")
                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="info-label">
                                Ngày gửi yêu cầu
                            </div>

                            <div class="info-value">
                                @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ORDER -->
            <div class="card detail-card mb-4">

                <div class="card-header d-flex justify-content-between align-items-center">

                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-receipt me-2 text-primary"></i>
                        Thông tin đơn hàng
                    </h5>

                    @if (order != null)
                    {
                        <span class="order-number">
                            Đơn #@order.OrderId
                        </span>
                    }

                </div>

                <div class="card-body">

                    @if (order != null)
                    {
                        <div class="row g-3 mb-4">

                            <div class="col-md-6">
                                <div class="info-label">
                                    Người nhận
                                </div>
                                <div class="info-value">
                                    @order.CustomerName
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="info-label">
                                    Số điện thoại
                                </div>
                                <div class="info-value">
                                    @order.Phone
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="info-label">
                                    Hình thức nhận hàng
                                </div>
                                <div class="info-value">
                                    @if (order.DeliveryMethod == "Ship")
                                    {
                                        <span>
                                            <i class="bi bi-truck me-1"></i>
                                            Giao hàng
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            <i class="bi bi-shop me-1"></i>
                                            Nhận tại cửa hàng
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="info-label">
                                    Phương thức thanh toán
                                </div>
                                <div class="info-value">
                                    @if (order.PaymentMethod == "BankTransfer")
                                    {
                                        <span>
                                            <i class="bi bi-qr-code me-1"></i>
                                            Chuyển khoản
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            <i class="bi bi-cash-coin me-1"></i>
                                            COD
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="info-label">
                                    Địa chỉ
                                </div>
                                <div class="info-value">
                                    @order.Address
                                </div>
                            </div>

                        </div>


                        <!-- PRODUCTS -->
                        <h6 class="fw-bold mb-3">
                            Sản phẩm trong đơn hàng
                        </h6>

                        @if (order.OrderDetails != null &&
                                            order.OrderDetails.Any())
                        {
                            <div class="table-responsive">

                                <table class="table align-middle product-table">

                                    <thead>
                                        <tr>
                                            <th>Sản phẩm</th>
                                            <th class="text-center">SL</th>
                                            <th class="text-end">Đơn giá</th>
                                            <th class="text-end">Thành tiền</th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        @foreach (var detail in order.OrderDetails)
                                        {
                                            <tr>

                                                <td>
                                                    <div class="product-info">

                                                        @if (!string.IsNullOrEmpty(detail.Product?.ImageUrl))
                                                        {
                                                            <img src="@detail.Product.ImageUrl"
                                                                 alt="@detail.Product.ProductName"
                                                                 class="product-image" />
                                                        }
                                                        else
                                                        {
                                                            <div class="product-placeholder">
                                                                <i class="bi bi-image"></i>
                                                            </div>
                                                        }

                                                        <div>
                                                            <div class="fw-semibold">
                                                                @detail.Product?.ProductName
                                                            </div>

                                                            <div class="text-muted small">
                                                                Mã SP:
                                                                @detail.ProductId
                                                            </div>
                                                        </div>

                                                    </div>
                                                </td>

                                                <td class="text-center">
                                                    @detail.Quantity
                                                </td>

                                                <td class="text-end">
                                                    @detail.Price.ToString("N0") đ
                                                </td>

                                                <td class="text-end fw-semibold">
                                                    @((detail.Price * detail.Quantity).ToString("N0")) đ
                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>
                        }


                    <!-- ORDER TOTAL -->
                    <div class="order-summary">

                        <div class="summary-row">
                            <span>Tạm tính</span>
                            <strong>
                                @(
                                                                order.OrderDetails?
                                                                .Sum(x => x.Price * x.Quantity)
                                                                .ToString("N0")
                                                                ) đ
                            </strong>
                        </div>

                            <div class="summary-row">
                                <span>Phí vận chuyển</span>
                                <strong>
                                    @order.ShippingFee.ToString("N0") đ
                                </strong>
                            </div>

                        @if (order.VoucherDiscount > 0)
                            {
                                <div class="summary-row discount-row">
                                    <span>
                                        Giảm giá voucher
                                    </span>

                                    <strong>
                                        -@order.VoucherDiscount.ToString("N0") đ
                                    </strong>
                                </div>
                            }

                            @if (order.PointDiscount > 0)
                            {
                                <div class="summary-row discount-row">
                                    <span>
                                        Giảm bằng điểm
                                        (@order.UsedPoints điểm)
                                    </span>

                                    <strong>
                                        -@order.PointDiscount.ToString("N0") đ
                                    </strong>
                                </div>
                            }

                            <div class="summary-total">
                                <span>Tổng tiền đơn hàng</span>

                                <strong>
                                    @order.TotalAmount.ToString("N0") đ
                                </strong>
                            </div>

                        </div>
                    }

                </div>

            </div>


            <!-- RETURN REASON -->
            <div class="card detail-card mb-4">

                <div class="card-header">

                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-chat-left-text me-2 text-primary"></i>
                        Nội dung yêu cầu
                    </h5>

                </div>

                <div class="card-body">

                    <div class="mb-4">

                        <div class="info-label">
                            Lý do trả hàng
                        </div>

                        <div class="reason-box">
                            @Model.Reason
                        </div>

                    </div>

                    <div>

                        <div class="info-label">
                            Mô tả chi tiết
                        </div>

                        <div class="description-box">

                            @if (!string.IsNullOrWhiteSpace(Model.Description))
                            {
                                @Model.Description
                            }
                            else
                            {
                                <span class="text-muted">
                                    Khách hàng không cung cấp mô tả.
                                </span>
                            }

                        </div>

                    </div>

                </div>

            </div>


            <!-- EVIDENCE -->
            <div class="card detail-card mb-4">

                <div class="card-header">

                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-paperclip me-2 text-primary"></i>
                        Bằng chứng
                    </h5>

                </div>

                <div class="card-body">

                    <div class="row g-4">

                        <!-- IMAGE -->
                        @if (!string.IsNullOrEmpty(Model.EvidenceImageUrl))
                        {
                            <div class="col-md-6">

                                <div class="evidence-label">
                                    <i class="bi bi-image me-1"></i>
                                    Hình ảnh
                                </div>

                                <a href="@Model.EvidenceImageUrl"
                                   target="_blank"
                                   class="evidence-image-link">

                                    <img src="@Model.EvidenceImageUrl"
                                         class="evidence-image"
                                         alt="Bằng chứng trả hàng" />

                                </a>

                                <div class="text-muted small mt-2">
                                    Nhấn vào hình để xem kích thước đầy đủ.
                                </div>

                            </div>
                        }

                        <!-- VIDEO -->
                        @if (!string.IsNullOrEmpty(Model.EvidenceVideoUrl))
                        {
                            <div class="col-md-6">

                                <div class="evidence-label">
                                    <i class="bi bi-camera-video me-1"></i>
                                    Video
                                </div>

                                <video controls
                                       class="evidence-video">

                                    <source src="@Model.EvidenceVideoUrl" />

                                    Trình duyệt không hỗ trợ video.
                                </video>

                            </div>
                        }

                        @if (string.IsNullOrEmpty(Model.EvidenceImageUrl) &&
                                                string.IsNullOrEmpty(Model.EvidenceVideoUrl))
                        {
                            <div class="col-12">

                                <div class="no-evidence">
                                    <i class="bi bi-file-earmark-x"></i>

                                    <span>
                                        Không có bằng chứng được cung cấp.
                                    </span>
                                </div>

                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>


        <!-- =========================
             RIGHT
        ========================== -->

        <div class="col-lg-4">

            <!-- PROCESS -->
            <div class="card detail-card mb-4">

                <div class="card-header">

                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-diagram-3 me-2 text-primary"></i>
                        Tiến trình xử lý
                    </h5>

                </div>

                <div class="card-body">

                    @{
                        var statusOrder = new Dictionary<string, int>
                                        {
                                        { "Chờ xử lý", 1 },
                                        { "Đã duyệt", 2 },
                                        { "Đang chờ nhận hàng", 3 },
                                        { "Đã nhận hàng", 4 },
                                        { "Đang kiểm tra", 5 },
                                        { "Đã hoàn tiền", 6 }
                                        };

                        int currentStep = statusOrder.ContainsKey(Model.Status)
                        ? statusOrder[Model.Status]
                        : 0;
                    }

                    <div class="timeline">

                        @{
                            var steps = new[]
                            {
                                                new { Order = 1, Name = "Chờ xử lý", Description = "Khách hàng gửi yêu cầu" },
                                                new { Order = 2, Name = "Đã duyệt", Description = "PetFeast chấp nhận yêu cầu" },
                                                new { Order = 3, Name = "Đang chờ nhận hàng", Description = "Chờ khách gửi sản phẩm" },
                                                new { Order = 4, Name = "Đã nhận hàng", Description = "PetFeast đã nhận sản phẩm" },
                                                new { Order = 5, Name = "Đang kiểm tra", Description = "Kiểm tra tình trạng sản phẩm" },
                                                new { Order = 6, Name = "Đã hoàn tiền", Description = "Hoàn tất yêu cầu" }
                                                };
                        }

                        @foreach (var step in steps)
                        {
                            bool isActive = step.Order <= currentStep;

                            <div class="timeline-item @(isActive ? "active" : "")">

                                <div class="timeline-dot"></div>

                                <div>
                                    <div class="fw-semibold">
                                        @step.Name
                                    </div>

                                    <small class="text-muted">
                                        @step.Description
                                    </small>
                                </div>

                            </div>
                        }

                    </div>

                    @if (Model.Status == "Từ chối")
                    {
                        <div class="rejected-process">
                            <i class="bi bi-x-circle-fill"></i>

                            <div>
                                <strong>Yêu cầu đã bị từ chối</strong>

                                <div class="small mt-1">
                                    Vui lòng xem lý do từ chối bên dưới.
                                </div>
                            </div>
                        </div>
                    }


                </div>

            </div>


            <!-- ACTION -->
            <div class="card detail-card mb-4">

                <div class="card-header">

                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-gear me-2 text-primary"></i>
                        Xử lý yêu cầu
                    </h5>

                </div>

                <div class="card-body">

                    @if (Model.Status == "Chờ xử lý")
                    {
                        <!-- APPROVE -->
                        <form asp-controller="Admin"
                              asp-action="ApproveReturnRequest"
                              asp-route-id="@Model.ReturnRequestId"
                              method="post"
                              class="mb-3 approve-return-form">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-approve w-100">

                                <i class="bi bi-check-circle me-2"></i>
                                Duyệt yêu cầu

                            </button>

                        </form>


                        <!-- REJECT -->
                        <form asp-controller="Admin"
                              asp-action="RejectReturnRequest"
                              asp-route-id="@Model.ReturnRequestId"
                              method="post"
                              class="reject-return-form">

                            @Html.AntiForgeryToken()

                            <label class="form-label fw-semibold">
                                Lý do từ chối
                            </label>

                            <textarea name="adminNote"
                                  class="form-control mb-3"
                                  rows="4"
                                  placeholder="Nhập lý do từ chối..."
                                  required></textarea>

                            <button type="submit"
                                    class="btn btn-reject w-100">

                                <i class="bi bi-x-circle me-2"></i>
                                Từ chối yêu cầu

                            </button>

                        </form>
                    }

                    else if (Model.Status == "Đã duyệt")
                    {
                        <form asp-controller="Admin"
                              asp-action="SetReturnWaitingForProduct"
                              asp-route-id="@Model.ReturnRequestId"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-primary-action w-100">

                                <i class="bi bi-box-seam me-2"></i>
                                Chuyển sang chờ nhận hàng

                            </button>

                        </form>
                    }

                    else if (Model.Status == "Đang chờ nhận hàng")
                    {
                        <form asp-controller="Admin"
                              asp-action="SetReturnReceived"
                              asp-route-id="@Model.ReturnRequestId"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-primary-action w-100">

                                <i class="bi bi-box2-heart me-2"></i>
                                Xác nhận đã nhận hàng

                            </button>

                        </form>
                    }

                    else if (Model.Status == "Đã nhận hàng")
                    {
                        <form asp-controller="Admin"
                              asp-action="SetReturnInspecting"
                              asp-route-id="@Model.ReturnRequestId"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-primary-action w-100">

                                <i class="bi bi-search me-2"></i>
                                Bắt đầu kiểm tra

                            </button>

                        </form>
                    }

                    else if (Model.Status == "Đang kiểm tra")
                    {
                        <div class="inspection-note mb-3">
                            <i class="bi bi-search me-2"></i>

                            Sản phẩm đã được nhận về và đang được kiểm tra.
                            Nếu sản phẩm đạt điều kiện trả hàng, Admin có thể
                            xác nhận hoàn tiền cho khách hàng.
                        </div>

                        <div class="refund-summary mb-3">

                            <div class="refund-summary-title">
                                <i class="bi bi-cash-coin me-2"></i>
                                Thông tin hoàn trả
                            </div>

                            <div class="refund-row">
                                <span>Tổng tiền đơn hàng</span>
                                <strong>
                                    @Model.Order.TotalAmount.ToString("N0") đ
                                </strong>
                            </div>

                            <div class="refund-row">
                                <span>Phí vận chuyển không hoàn</span>
                                <strong>
                                    @Model.Order.ShippingFee.ToString("N0") đ
                                </strong>
                            </div>

                            <div class="refund-row refund-total">
                                <span>Số tiền hoàn lại</span>
                                <strong>
                                    @Math.Max(0, Model.Order.TotalAmount - Model.Order.ShippingFee).ToString("N0") đ
                                </strong>
                        </div>

                        @if (Model.Order.UsedPoints > 0)
                            {
                                <div class="refund-extra">
                                    <i class="bi bi-coin me-2"></i>
                                    Hoàn lại
                                    <strong>@Model.Order.UsedPoints điểm</strong>
                                    cho khách hàng
                                </div>
                            }

                            @if (Model.Order.UserVoucherId.HasValue)
                            {
                                <div class="refund-extra">
                                    <i class="bi bi-ticket-perforated me-2"></i>
                                    Voucher đã sử dụng sẽ được
                                    <strong>kích hoạt lại</strong>
                                </div>
                            }

                        </div>

                        <form asp-controller="Admin"
                              asp-action="SetReturnRefunded"
                              asp-route-id="@Model.ReturnRequestId"
                              method="post"
                              class="refund-return-form">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-primary-action w-100">

                                <i class="bi bi-cash-coin me-2"></i>

                                Xác nhận hoàn tiền
                            </button>

                        </form>
                        <!-- TỪ CHỐI SAU KHI KIỂM TRA -->
                        <form asp-controller="Admin"
                              asp-action="RejectReturnAfterInspection"
                              asp-route-id="@Model.ReturnRequestId"
                              method="post"
                              class="reject-after-inspection-form mt-3">

                            @Html.AntiForgeryToken()

                            <label class="form-label fw-semibold">
                                Lý do từ chối hoàn trả
                            </label>

                            <textarea name="adminNote"
                                  class="form-control mb-3"
                                  rows="4"
                                  placeholder="Ví dụ: Sản phẩm bị hư hỏng do sử dụng sai cách..."
                                  required></textarea>

                            <button type="submit"
                                    class="btn btn-reject w-100">

                                <i class="bi bi-x-circle me-2"></i>
                                Từ chối hoàn trả
                            </button>

                        </form>
                                        }

                    else if (Model.Status == "Đã hoàn tiền")
                    {
                        <div class="completed-box">

                            <i class="bi bi-check-circle-fill"></i>

                            <div>
                                <strong>
                                    Yêu cầu đã hoàn tất
                                </strong>

                                <div class="small text-muted mt-1">
                                    Sản phẩm đã được kiểm tra và tiền đã được hoàn trả.
                                </div>
                            </div>

                        </div>
                    }

                    else if (Model.Status == "Từ chối")
                    {
                        <div class="rejected-box">

                            <i class="bi bi-x-circle-fill"></i>

                            <div>
                                <strong>
                                    Yêu cầu đã bị từ chối
                                </strong>

                                <div class="small mt-1">
                                    Không thể thực hiện thêm thao tác.
                                </div>
                            </div>

                        </div>
                    }

                </div>

            </div>


            <!-- ADMIN NOTE -->
            @if (Model.Status == "Từ chối" &&
                        !string.IsNullOrWhiteSpace(Model.AdminNote))
            {
                <div class="card detail-card">

                    <div class="card-header">

                        <h5 class="mb-0 fw-bold">
                            <i class="bi bi-chat-square-text me-2 text-danger"></i>
                            Lý do từ chối
                        </h5>

                    </div>

                    <div class="card-body">

                        <div class="admin-note">
                            @Model.AdminNote
                        </div>

                    </div>

                </div>
            }

        </div>

    </div>

</div>


<style>

    /* =========================
           GENERAL
        ========================= */

    .detail-card {
        border: 0;
        border-radius: 14px;
