@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            document.addEventListener("submit", function (event) {

                const form = event.target;

                if (form.classList.contains("approve-return-form")) {

                    event.preventDefault();

                    showConfirmModal(
                        "Bạn có chắc muốn duyệt yêu cầu trả hàng này?",
                        function () {
                            form.submit();
                        }
                    );
                }

                else if (form.classList.contains("reject-return-form")) {

                    event.preventDefault();

                    showConfirmModal(
                        "Bạn có chắc muốn từ chối yêu cầu này?",
                        function () {
                            form.submit();
                        }
                    );
                }

                else if (form.classList.contains("refund-return-form")) {

                    event.preventDefault();

                    showConfirmModal(
                        "Bạn xác nhận sản phẩm đạt điều kiện và muốn hoàn tiền? Hệ thống sẽ hoàn lại điểm, kích hoạt lại voucher và cộng lại tồn kho.",
                        function () {
                            form.submit();
                        }
                    );
                }

                else if (form.classList.contains("reject-after-inspection-form")) {

                    event.preventDefault();

                    showConfirmModal(
                        "Bạn có chắc muốn từ chối hoàn trả sau khi kiểm tra?",
                        function () {
                            form.submit();
                        }
                    );
                }

            });

        });
    </script>
}