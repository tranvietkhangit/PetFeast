@model IEnumerable<PetFeast.Models.Products.Category>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid admin-list-page">

    <div class="admin-page-header">
        <div>
            <h3 class="admin-page-title">
                Quản lý danh mục
            </h3>

            <p class="text-muted mb-0 mt-1">
                Quản lý các danh mục sản phẩm của PetFeast
            </p>
        </div>
    </div>

    <div class="admin-card">

        <div class="admin-card-header">

            <h4>
                <i class="bi bi-grid me-2"></i>
                Danh sách danh mục
            </h4>

            <a asp-action="CreateCategory"
               class="admin-btn-add">

                <i class="bi bi-plus-circle"></i>
                Thêm danh mục

            </a>

        </div>

        <div class="admin-card-body">

            <div class="admin-table-wrapper">

                <table class="table admin-table">

                    <thead>
                        <tr>
                            <th width="100">ID</th>
                            <th>Tên danh mục</th>
                            <th width="150" class="text-center">
                                Thao tác
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        #@item.CategoryId
                                    </td>

                                    <td>
                                        <span class="fw-semibold">
                                            @item.CategoryName
                                        </span>
                                    </td>

                                    <td>
                                        <div class="admin-action-buttons">

                                            <a asp-action="EditCategory"
                                               asp-route-id="@item.CategoryId"
                                               class="btn btn-outline-warning"
                                               title="Sửa">

                                                <i class="bi bi-pencil-square"></i>

                                            </a>

                                            <form asp-action="DeleteCategory"
                                                  asp-route-id="@item.CategoryId"
                                                  method="post"
                                                  class="delete-category-form d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-outline-danger"
                                                        title="Xóa">

                                                    <i class="bi bi-trash"></i>

                                                </button>

                                            </form>

                                        </div>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3"
                                    class="text-center text-muted py-5">

                                    <i class="bi bi-folder2-open fs-2 d-block mb-2"></i>
                                    Chưa có danh mục nào.

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            document.addEventListener("submit", function (event) {

                const form = event.target;

                if (!form.classList.contains("delete-category-form")) {
                    return;
                }

                event.preventDefault();

                showConfirmModal(
                    "Bạn có chắc muốn xóa danh mục này?",
                    function () {
                        form.submit();
                    }
                );
            });

        });
    </script>
}