@model PetFeast.Models.Products.Category

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-page">

    <div class="admin-page-header">
        <div>
            <h2 class="admin-page-title">Thêm danh mục</h2>
            <p class="admin-page-subtitle">
                Tạo danh mục sản phẩm mới cho PetFeast
            </p>
        </div>

        <a asp-action="CategoryList"
           class="admin-btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Quay lại
        </a>
    </div>

    <div class="admin-card">

        <div class="admin-card-header">
            <i class="bi bi-folder-plus text-primary"></i>
            <h4>Thông tin danh mục</h4>
        </div>

        <div class="admin-card-body">

            <form asp-action="CreateCategory"
                  method="post"
                  class="admin-form">

                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryName"
                           class="admin-form-label">
                        Tên danh mục
                    </label>

                    <input asp-for="CategoryName"
                           class="form-control"
                           placeholder="Nhập tên danh mục..."
                           required />

                    <span asp-validation-for="CategoryName"
                          class="text-danger">
                    </span>
                </div>

                <div class="admin-form-actions">

                    <button type="submit"
                            class="admin-btn-primary">
                        <i class="bi bi-check-circle"></i>
                        Lưu danh mục
                    </button>

                    <a asp-action="CategoryList"
                       class="admin-btn-secondary">
                        <i class="bi bi-x-circle"></i>
                        Hủy
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>