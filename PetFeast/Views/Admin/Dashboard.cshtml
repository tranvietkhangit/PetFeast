@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- CDN Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="dashboard-scope">
    <!-- TIÊU ĐỀ -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0" style="color: #075985 !important;">Dashboard Quản Trị</h4>
        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill small">
            <i class="bi bi-broadcast me-1"></i> Realtime Sync
        </span>
    </div>

    <!-- 4 THẺ CHỈ SỐ GRADIENT -->
    <div class="row g-3 mb-4">
        <!-- Doanh thu -->
        <div class="col-xl-3 col-sm-6">
            <div class="stat-card-gradient grad-navy">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="stat-card-title">Doanh thu tháng</span>
                    <span class="stat-icon-glass"><i class="bi bi-cash-stack"></i></span>
                </div>
                <div class="stat-card-num">
                    <span id="liveRevenue">@String.Format("{0:N0}", ViewBag.TotalRevenue)</span><small class="fs-6 ms-1">₫</small>
                </div>
            </div>
        </div>

        <!-- Tổng đơn hàng -->
        <div class="col-xl-3 col-sm-6">
            <div class="stat-card-gradient grad-cyan">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="stat-card-title">Tổng đơn hàng</span>
                    <span class="stat-icon-glass"><i class="bi bi-cart-check-fill"></i></span>
                </div>
                <div class="stat-card-num">
                    <span id="liveOrders">@ViewBag.TotalOrders</span> <small class="fs-6 opacity-75">đơn</small>
                </div>
            </div>
        </div>

        <!-- Tổng sản phẩm -->
        <div class="col-xl-3 col-sm-6">
            <div class="stat-card-gradient grad-emerald">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="stat-card-title">Tổng sản phẩm</span>
                    <span class="stat-icon-glass"><i class="bi bi-box-seam-fill"></i></span>
                </div>
                <div class="stat-card-num">
                    <span id="liveProducts">@ViewBag.TotalProducts</span> <small class="fs-6 opacity-75">món</small>
                </div>
            </div>
        </div>

        <!-- Danh mục -->
        <div class="col-xl-3 col-sm-6">
            <div class="stat-card-gradient grad-indigo">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="stat-card-title">Danh mục</span>
                    <span class="stat-icon-glass"><i class="bi bi-grid-fill"></i></span>
                </div>
                <div class="stat-card-num">
                    <span id="liveCategories">@ViewBag.TotalCategories</span> <small class="fs-6 opacity-75">loại</small>
                </div>
            </div>
        </div>
    </div>

    <!-- KHỐI BIỂU ĐỒ & BẢNG ĐƠN HÀNG MỚI -->
    <div class="row g-4">
        <!-- CỘT TRÁI (Biểu đồ doanh thu & Bảng 5 đơn hàng mới) -->
        <div class="col-xl-8 col-lg-7">
            <!-- 1. Biểu đồ tăng trưởng doanh thu -->
            <div class="dashboard-panel-card mb-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <h6 class="panel-header-title">Tăng trưởng doanh thu</h6>
                    <a asp-controller="Admin" asp-action="OrderList" class="btn-badge-cyan">Chi tiết</a>
                </div>
                <div class="d-flex justify-content-end mb-2">
                    <div class="legend-box">
                        <span><i class="sq-cyan"></i> Năm trước</span>
                        <span><i class="sq-navy"></i> Năm nay</span>
                    </div>
                </div>
                <div style="height: 180px;">
                    <canvas id="resultChart"></canvas>
                </div>
            </div>

            <!-- 2. Bảng 5 đơn hàng mới nhất -->
            <div class="dashboard-panel-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="panel-header-title">Đơn hàng mới nhất</h6>
                    <a asp-controller="Admin" asp-action="OrderList" class="text-decoration-none small fw-bold text-primary">
                        Xem tất cả <i class="bi bi-chevron-right"></i>
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle mb-0" style="font-size: 0.88rem;">
                        <thead class="text-muted small text-uppercase" style="border-bottom: 2px solid #e2e8f0;">
                            <tr>
                                <th>Mã đơn</th>
                                <th>Khách hàng</th>
                                <th>Ngày đặt</th>
                                <th class="text-end">Tổng tiền</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-center">Xem</th>
                            </tr>
                        </thead>
                        <tbody id="liveRecentOrdersList">
                            @if (ViewBag.RecentOrders != null)
                            {
                                foreach (var order in ViewBag.RecentOrders)
                                {
                                    <tr>
                                        <td class="fw-bold text-primary">#@order.OrderId</td>
                                        <td class="fw-semibold text-truncate" style="max-width: 130px;">@order.CustomerName</td>
                                        <td class="text-muted small">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-end fw-bold">@String.Format("{0:N0}", order.TotalAmount) ₫</td>
                                        <td class="text-center">
                                            @if (order.Status == "Hoàn thành")
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">Hoàn thành</span>
                                            }
                                            else if (order.Status == "Đang giao")
                                            {
                                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">Đang giao</span>
                                            }
                                            else if (order.Status == "Đã hủy")
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Đã hủy</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">@order.Status</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <a asp-action="OrderDetail" asp-route-id="@order.OrderId" class="btn btn-sm btn-light border text-primary py-0 px-2" style="width: auto; height: 28px;">
                                                <i class="bi bi-eye-fill"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI (Donut tỷ lệ hoàn thành & Top 5 bán chạy) -->
        <div class="col-xl-4 col-lg-5">
            <div class="dashboard-panel-card d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="fw-bold small text-muted text-uppercase">Tỷ lệ đơn hoàn thành</span>
                        <span class="badge bg-info-subtle text-info-emphasis" id="donutSubCount">
                            @(ViewBag.CompletedOrders ?? 0)/@(ViewBag.TotalOrders ?? 0) đơn
                        </span>
                    </div>

                    <div class="donut-holder">
                        <canvas id="donutChart"></canvas>
                        <div class="donut-center-text">
                            <h2 id="liveCompletionRate">@(ViewBag.CompletionRate ?? 0)%</h2>
                        </div>
                    </div>

                    <div class="mt-3">
                        <div class="fw-bold mb-2 small text-muted text-uppercase">Top 5 Bán Chạy Nhất</div>
                        <div id="liveBestProductsList">
                            @if (ViewBag.BestProducts != null)
                            {
                                foreach (var item in ViewBag.BestProducts)
                                {
                                    <div class="product-list-row">
                                        <span class="text-truncate" style="max-width: 150px;">@item.ProductName</span>
                                        <span class="price-text">@String.Format("{0:N0}", item.Price) ₫</span>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

                <a asp-controller="Admin" asp-action="ProductList" class="btn-main-cyan-block mt-4">
                    Xem toàn bộ kho
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    let barChartInstance = null;
    let donutChartInstance = null;

            function initBarChart() {

        const canvas = document.getElementById('resultChart');

        if (!canvas) {
            console.error("Không tìm thấy canvas resultChart");
            return;
        }

        const currentYearData = @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
                                ViewBag.RevenueCurrentYear ?? new decimal[12]
                        )
                );

        const previousYearData = @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
                                ViewBag.RevenuePrevYear ?? new decimal[12]
                        )
                );

        console.log("Doanh thu năm nay:", currentYearData);
        console.log("Doanh thu năm trước:", previousYearData);

        if (barChartInstance) {
            barChartInstance.destroy();
        }

        const ctx = canvas.getContext('2d');

        barChartInstance = new Chart(ctx, {

            type: 'bar',

            data: {

                labels: [
                    'T1', 'T2', 'T3', 'T4',
                    'T5', 'T6', 'T7', 'T8',
                    'T9', 'T10', 'T11', 'T12'
                ],

                datasets: [

                    {
                        label: 'Năm nay',

                        data: currentYearData,

                        backgroundColor: '#0f3c68',

                        barThickness: 9,

                        borderRadius: 2
                    },

                    {
                        label: 'Năm trước',

                        data: previousYearData,

                        backgroundColor: '#0ea5e9',

                        barThickness: 9,

                        borderRadius: 2
                    }

                ]
            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                plugins: {

                    legend: {
                        display: false
                    },

                    tooltip: {

                        callbacks: {

                            label: function (context) {

                                return Number(context.raw)
                                    .toLocaleString('vi-VN') + ' ₫';

                            }

                        }

                    }

                },

                scales: {

                    x: {

                        grid: {
                            display: false
                        },

                        ticks: {

                            font: {
                                size: 10,
                                weight: 'bold'
                            },

                            color: '#64748b'
                        }

                    },

                    y: {

                        beginAtZero: true,

                        grid: {
                            color: '#f1f5f9'
                        },

                        ticks: {

                            font: {
                                size: 10
                            },

                            callback: function (value) {

                                return Number(value)
                                    .toLocaleString('vi-VN') + ' đ';

                            }

                        }

                    }

                }

            }

        });
    }

          function initDonutChart(rate) {
        const canvas = document.getElementById('donutChart');

        if (!canvas) return;

        // Nếu Chart cũ tồn tại thì hủy
        if (donutChartInstance) {
            donutChartInstance.destroy();
            donutChartInstance = null;
        }

        // Khóa kích thước canvas
        canvas.width = 220;
        canvas.height = 220;

        const ctx = canvas.getContext('2d');

        const value = Number(rate) || 0;

        donutChartInstance = new Chart(ctx, {
            type: 'doughnut',

            data: {
                labels: [
                    'Hoàn thành',
                    'Chưa hoàn thành'
                ],

                datasets: [{
                    data: [
                        value,
                        Math.max(0, 100 - value)
                    ],

                    backgroundColor: [
                        '#0284c7',
                        '#0f3c68'
                    ],

                    borderWidth: 0,

                    cutout: '72%'
                }]
            },

            options: {
                // QUAN TRỌNG
                responsive: false,
                maintainAspectRatio: false,

                animation: false,

                plugins: {
                    legend: {
                        display: false
                    },

                    tooltip: {
                        enabled: false
                    }
                }
            }
        });
    }

    function renderStatusBadge(status) {
        if (status === 'Hoàn thành') return '<span class="badge bg-success-subtle text-success border border-success-subtle">Hoàn thành</span>';
        if (status === 'Đang giao') return '<span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">Đang giao</span>';
        if (status === 'Đã hủy') return '<span class="badge bg-danger-subtle text-danger border border-danger-subtle">Đã hủy</span>';
        return `<span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">${status}</span>`;
    }

    async function fetchDashboardRealtime() {
        try {
            const res = await fetch('/Admin/GetDashboardRealtimeData');
            if (!res.ok) return;
            const data = await res.json();

            // Cập nhật 4 thẻ số liệu
            if (data.totalRevenue !== undefined) document.getElementById('liveRevenue').innerText = Number(data.totalRevenue).toLocaleString('vi-VN');
            if (data.totalOrders !== undefined) document.getElementById('liveOrders').innerText = data.totalOrders;
            if (data.totalProducts !== undefined) document.getElementById('liveProducts').innerText = data.totalProducts;
            if (data.totalCategories !== undefined) document.getElementById('liveCategories').innerText = data.totalCategories;

            // Cập nhật Donut Chart
            if (data.completionRate !== undefined) {
                document.getElementById('liveCompletionRate').innerText = data.completionRate + '%';
                document.getElementById('donutSubCount').innerText = `${data.completedOrders}/${data.totalOrders} đơn`;
                if (donutChartInstance) {
                    donutChartInstance.data.datasets[0].data = [data.completionRate, Math.max(0, 100 - data.completionRate)];
                    donutChartInstance.update();
                }
            }

            // Cập nhật Bar Chart
            if (barChartInstance && data.revenueCurrentYear) {
                barChartInstance.data.datasets[0].data = data.revenueCurrentYear;
                barChartInstance.data.datasets[1].data = data.revenuePrevYear;
                barChartInstance.update();
            }

            // Cập nhật Top 5 sản phẩm
            const productListElem = document.getElementById('liveBestProductsList');
            if (data.bestProducts && data.bestProducts.length > 0) {
                productListElem.innerHTML = data.bestProducts.map(p => `
                        <div class="product-list-row">
                            <span class="text-truncate" style="max-width: 150px;">${p.productName}</span>
                            <span class="price-text">${Number(p.price).toLocaleString('vi-VN')} ₫</span>
                        </div>
                    `).join('');
            }

            // Cập nhật Bảng 5 đơn hàng mới nhất Realtime
            const recentOrdersElem = document.getElementById('liveRecentOrdersList');
            if (data.recentOrders && data.recentOrders.length > 0) {
                recentOrdersElem.innerHTML = data.recentOrders.map(o => `
                        <tr>
                            <td class="fw-bold text-primary">#${o.orderId}</td>
                            <td class="fw-semibold text-truncate" style="max-width: 130px;">${o.fullName}</td>
                            <td class="text-muted small">${o.orderDate}</td>
                            <td class="text-end fw-bold">${Number(o.totalAmount).toLocaleString('vi-VN')} ₫</td>
                            <td class="text-center">${renderStatusBadge(o.status)}</td>
                            <td class="text-center">
                                <a href="/Admin/OrderDetail/${o.orderId}" class="btn btn-sm btn-light border text-primary py-0 px-2" style="width: auto; height: 28px;">
                                    <i class="bi bi-eye-fill"></i>
                                </a>
                            </td>
                        </tr>
                    `).join('');
            }
        } catch (err) {
            console.error("Lỗi đồng bộ Dashboard realtime:", err);
        }
    }

        document.addEventListener("DOMContentLoaded", function () {

        console.log("Dashboard loaded");

        initBarChart();

        initDonutChart(@(ViewBag.CompletionRate ?? 0));

        fetchDashboardRealtime();

        setInterval(fetchDashboardRealtime, 8000);
    });
</script>
<style>
    .dashboard-scope {
        padding: 0;
    }

    /* =========================
       STAT CARDS
    ========================= */

    .stat-card-gradient {
        min-height: 105px;
        padding: 18px 20px;
        border-radius: 14px;
        color: white;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
    }

    .grad-navy {
        background: linear-gradient(135deg, #0f3c68, #075985);
    }

    .grad-cyan {
        background: linear-gradient(135deg, #0284c7, #0ea5e9);
    }

    .grad-emerald {
        background: linear-gradient(135deg, #059669, #10b981);
    }

    .grad-indigo {
        background: linear-gradient(135deg, #4338ca, #6366f1);
    }

    .stat-card-title {
        font-size: 14px;
        font-weight: 600;
        opacity: .9;
    }

    .stat-card-num {
        margin-top: 8px;
        font-size: 25px;
        font-weight: 700;
    }

    .stat-icon-glass {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: rgba(255,255,255,.18);
        font-size: 18px;
    }


    /* =========================
       DASHBOARD PANEL
    ========================= */

    .dashboard-panel-card {
        background: #fff;
        border-radius: 14px;
        padding: 18px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 3px 12px rgba(0,0,0,.04);
    }

    .panel-header-title {
        margin: 0;
        font-weight: 700;
        color: #0f3c68;
    }

    .legend-box {
        display: flex;
        gap: 15px;
        font-size: 12px;
        color: #64748b;
    }

    .sq-cyan,
    .sq-navy {
        display: inline-block;
        width: 9px;
        height: 9px;
        margin-right: 4px;
        border-radius: 2px;
    }

    .sq-cyan {
        background: #0ea5e9;
    }

    .sq-navy {
        background: #0f3c68;
    }


    /* =========================
       DONUT
    ========================= */

    .donut-holder {
        width: 220px;
        height: 220px;
        position: relative;
        margin: 15px auto;
    }

        .donut-holder canvas {
            width: 220px !important;
            height: 220px !important;
        }

    .donut-center-text {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;
    }

        .donut-center-text h2 {
            margin: 0;
            font-weight: 700;
            color: #1f2937;
        }


    /* =========================
       TOP PRODUCTS
    ========================= */

    .product-list-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 7px 0;
        border-bottom: 1px solid #f1f5f9;
        font-size: 13px;
    }

    .price-text {
        font-weight: 600;
        white-space: nowrap;
        margin-left: 10px;
    }

    .btn-main-cyan-block {
        display: block;
        width: 100%;
        padding: 10px;
        text-align: center;
        border-radius: 8px;
        text-decoration: none;
        background: #0ea5e9;
        color: white;
        font-weight: 600;
    }

        .btn-main-cyan-block:hover {
            background: #0284c7;
            color: white;
        }
</style>