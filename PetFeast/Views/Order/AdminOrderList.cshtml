@model List<PetFeast.Models.Orders.Order>

@{
    ViewData["Title"] = "Quản lý đơn hàng";
}

<div class="container mt-4">
    <h3 class="fw-bold mb-4">Quản lý đơn hàng - PetFeast</h3>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>SĐT / NDT CK</th>
                        <th>Tổng tiền</th>
                        <th>Hình thức TT</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>#@item.OrderId</strong></td>
                            <td>
                                <div>@item.CustomerName</div>
                                <small class="text-muted">@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</small>
                            </td>
                            <td>
                                <span class="fw-bold text-primary">@item.Phone</span>
                            </td>
                            <td class="text-danger fw-bold">
                                @item.TotalAmount.ToString("N0") đ
                            </td>
                            <td>
                                @if (item.PaymentMethod == "BankTransfer")
                                {
                                    <span class="badge bg-info text-dark">VietQR</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">COD</span>
                                }
                            </td>
                            <td>
                                @if (item.Status == "Chờ xác nhận CK")
                                {
                                    <span class="badge bg-warning text-dark">Chờ xác nhận CK</span>
                                }
                                else if (item.Status == "Đã thanh toán")
                                {
                                    <span class="badge bg-success">Đã thanh toán</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">@item.Status</span>
                                }
                            </td>
                            <td>
                                @if (item.Status == "Chờ xác nhận CK")
                                {
                                    <form asp-action="ConfirmPayment" method="post" class="d-inline">
                                        <input type="hidden" name="orderId" value="@item.OrderId" />
                                        <button type="submit"
                                                class="btn btn-sm btn-success fw-bold"
                                                onclick="return confirm('Bạn đã nhận được tiền từ số dư ngân hàng?')">
                                            <i class="bi bi-check-lg"></i> Nhận tiền
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>