@model IEnumerable<PetFeast.Models.Orders.Order>

@{
    int stt = 1;
}

<div class="container mt-4 mb-5">

    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="fw-bold text-primary mb-0">
            <i class="bi bi-bag-check me-2"></i>
            Đơn hàng của tôi
        </h2>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-bag-x text-muted"
               style="font-size: 60px;"></i>

            <h5 class="mt-3 text-muted">
                Bạn chưa có đơn hàng nào.
            </h5>

            <a asp-controller="Product"
               asp-action="Index"
               class="btn btn-primary mt-2">
                <i class="bi bi-cart me-1"></i>
                Mua sắm ngay
            </a>
        </div>
    }
    else
    {
        <div class="order-table-wrapper">

            <div class="table-responsive">

                <table class="table table-bordered align-middle order-table">

                    <thead class="table-primary text-center">
                        <tr>
                            <th style="width: 60px;">STT</th>
                            <th style="width: 150px;">Ngày đặt</th>
                            <th style="min-width: 280px;">Sản phẩm</th>
                            <th style="min-width: 220px;">Địa chỉ giao hàng</th>
                            <th style="width: 140px;">Tổng tiền</th>
                            <th style="width: 130px;">Trạng thái</th>
                            <th style="width: 130px;">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var order in Model)
                        {
                            <tr>

                                <!-- STT -->
                                <td class="text-center fw-semibold">
                                    @stt
                                </td>

                                <!-- NGÀY ĐẶT -->
                                <td class="text-center">
                                    <div class="small fw-semibold">
                                        @order.OrderDate.ToString("dd/MM/yyyy")
                                    </div>

                                    <div class="text-muted small">
                                        @order.OrderDate.ToString("HH:mm")
                                    </div>
                                </td>

                                <!-- SẢN PHẨM -->
                                <td>

                                    <div class="order-products">

                                        @foreach (var item in order.OrderDetails)
                                        {
                                            <div class="order-product-item">

                                                <img src="@item.Product.ImageUrl"
                                                     class="order-product-image"
                                                     alt="@item.Product.ProductName">

                                                <div class="order-product-info">

                                                    <div class="order-product-name"
                                                         title="@item.Product.ProductName">
                                                        @item.Product.ProductName
                                                    </div>

                                                    <div class="text-muted small">
                                                        SL: @item.Quantity
                                                    </div>

                                                    <div class="text-success fw-semibold small">
                                                        @item.Price.ToString("N0") đ
                                                    </div>

                                                </div>

                                            </div>
                                        }

                                    </div>

                                </td>

                                <!-- ĐỊA CHỈ -->
                                <td>
                                    <div class="order-address">
                                        <i class="bi bi-geo-alt text-primary me-1"></i>
                                        @order.Address
                                    </div>
                                </td>

                                <!-- TỔNG TIỀN -->
                                <td class="text-center">

                                    <div class="fw-bold text-success">
                                        @order.TotalAmount.ToString("N0") đ
                                    </div>

                                </td>

                                <!-- TRẠNG THÁI -->
                                <td class="text-center">

                                    @if (order.Status == "Đang giao")
                                    {
                                        <span class="badge bg-primary">
                                            <i class="bi bi-truck me-1"></i>
                                            @order.Status
                                        </span>
                                    }
                                    else if (order.Status == "Hoàn thành")
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle me-1"></i>
                                            @order.Status
                                        </span>
                                    }
                                    else if (order.Status == "Đã hủy")
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-x-circle me-1"></i>
                                            @order.Status
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @order.Status
                                        </span>
                                    }

                                </td>

                                <!-- THAO TÁC -->
                                <td class="text-center">

                                    <div class="d-flex flex-column gap-2 align-items-center">

                                        <!-- CHI TIẾT -->
                                        <a asp-controller="Order"
                                           asp-action="UserOrderDetail"
                                           asp-route-id="@order.OrderId"
                                           class="btn btn-sm btn-outline-primary order-detail-btn">

                                            <i class="bi bi-eye me-1"></i>
                                            Chi tiết

                                        </a>


                                        <!-- HỦY ĐƠN -->
                                        @if (order.Status == "Chờ xác nhận")
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger order-cancel-btn"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#cancelOrderModal"
                                                    data-order-id="@order.OrderId">

                                                <i class="bi bi-x-circle me-1"></i>
                                                Hủy đơn

                                            </button>
                                        }


                                        <!-- TRẢ HÀNG -->
                                        @{
                                            var canReturn =
                                            order.Status == "Hoàn thành"
                                            && order.CompletedDate.HasValue
                                            && DateTime.Now <= order.CompletedDate.Value.AddDays(7)
                                            && order.ReturnRequest == null;
                                        }

                                        @if (canReturn)
                                        {
                                            <a asp-controller="Order"
                                               asp-action="ReturnRequest"
                                               asp-route-id="@order.OrderId"
                                               class="btn btn-sm btn-outline-warning order-return-btn">

                                                <i class="bi bi-arrow-return-left me-1"></i>
                                                Trả hàng

                                            </a>
                                        }
                                        else if (order.ReturnRequest != null)
                                        {
                                            <span class="return-status">
                                                <i class="bi bi-arrow-repeat me-1"></i>
                                                @order.ReturnRequest.Status
                                            </span>
                                        }

                                    </div>

                                </td>

                            </tr>

                            stt++;
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>
<!-- MODAL HỦY ĐƠN -->
<div class="modal fade"
     id="cancelOrderModal"
     tabindex="-1"
     aria-labelledby="cancelOrderModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-md">

        <div class="modal-content cancel-modal">

            <div class="modal-header">
                <h5 class="modal-title fw-bold"
                    id="cancelOrderModalLabel">

                    <i class="bi bi-x-circle text-danger me-2"></i>
                    Hủy đơn hàng
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Đóng">
                </button>
            </div>

            <form id="cancelOrderForm"
                  asp-controller="Order"
                  asp-action="CancelMyOrder"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       id="cancelOrderId"
                       name="id" />

                <div class="modal-body">

                    <div class="cancel-order-title mb-3">
                        Bạn đang muốn hủy đơn hàng
                        <strong id="cancelOrderNumber">
                            #0
                        </strong>
                    </div>

                    <label class="form-label fw-semibold">
                        Vì sao bạn muốn hủy đơn?
                    </label>

                    <div class="cancel-reasons">

                        <label class="cancel-reason-item">
                            <input type="radio"
                                   name="cancellationReason"
                                   value="Tôi muốn thay đổi sản phẩm">

                            <span>
                                Tôi muốn thay đổi sản phẩm
                            </span>
                        </label>

                        <label class="cancel-reason-item">
                            <input type="radio"
                                   name="cancellationReason"
                                   value="Tôi muốn thay đổi địa chỉ nhận hàng">

                            <span>
                                Tôi muốn thay đổi địa chỉ nhận hàng
                            </span>
                        </label>

                        <label class="cancel-reason-item">
                            <input type="radio"
                                   name="cancellationReason"
                                   value="Tôi tìm được sản phẩm khác">

                            <span>
                                Tôi tìm được sản phẩm khác
                            </span>
                        </label>

                        <label class="cancel-reason-item">
                            <input type="radio"
                                   name="cancellationReason"
                                   value="Không còn nhu cầu mua">

                            <span>
                                Không còn nhu cầu mua
                            </span>
                        </label>

                        <label class="cancel-reason-item">
                            <input type="radio"
                                   name="cancellationReason"
                                   value="Đặt nhầm đơn hàng">

                            <span>
                                Đặt nhầm đơn hàng
                            </span>
                        </label>

                        <label class="cancel-reason-item">
                            <input type="radio"
                                   name="cancellationReason"
                                   value="Lý do khác">

                            <span>
                                Lý do khác
                            </span>
                        </label>

                    </div>

                    <div class="mt-3">
                        <label class="form-label fw-semibold">
                            Ghi chú thêm
                            <span class="text-muted fw-normal">
                                (không bắt buộc)
                            </span>
                        </label>

                        <textarea id="cancelNote"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Nhập thêm lý do nếu cần..."></textarea>
                    </div>

                    <div class="cancel-warning mt-3">
                        <i class="bi bi-info-circle me-1"></i>
                        Sau khi hủy, đơn hàng sẽ không thể tiếp tục xử lý.
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">
                        Quay lại
                    </button>

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="bi bi-x-circle me-1"></i>
                        Xác nhận hủy
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const cancelModal =
            document.getElementById("cancelOrderModal");

        const cancelOrderId =
            document.getElementById("cancelOrderId");

        const cancelOrderNumber =
            document.getElementById("cancelOrderNumber");

        const cancelNote =
            document.getElementById("cancelNote");

        const cancelForm =
            document.getElementById("cancelOrderForm");


        // Khi bấm nút Hủy đơn
        document.addEventListener("click", function (e) {

            const button =
                e.target.closest(".order-cancel-btn");

            if (!button)
                return;

            const orderId =
                button.dataset.orderId;

            cancelOrderId.value = orderId;

            cancelOrderNumber.textContent =
                "#" + orderId;

            // Reset lựa chọn
            cancelForm
                .querySelectorAll(
                    'input[name="cancellationReason"]'
                )
                .forEach(input => {
                    input.checked = false;
                });

            cancelNote.value = "";
        });


        // Khi submit form
        cancelForm.addEventListener("submit", function (e) {

            const selected =
                cancelForm.querySelector(
                    'input[name="cancellationReason"]:checked'
                );

            if (!selected) {

                e.preventDefault();

                alert("Vui lòng chọn lý do hủy đơn hàng.");

                return;
            }

            let reason = selected.value;

            // Nếu chọn lý do khác
            if (reason === "Lý do khác") {

                const note =
                    cancelNote.value.trim();

                if (!note) {

                    e.preventDefault();

                    alert(
                        "Vui lòng nhập lý do hủy đơn hàng."
                    );

                    cancelNote.focus();

                    return;
                }

                reason = "Lý do khác: " + note;
            }
            else if (cancelNote.value.trim()) {

                reason +=
                    " - " + cancelNote.value.trim();
            }

            // Cập nhật giá trị gửi lên server
            selected.value = reason;
        });

    });
</script>
<style>

    /* ==============================
       ORDER TABLE
    ============================== */

    .order-table {
        margin-bottom: 0;
        background: #fff;
    }

        .order-table th {
            font-size: 15px;
            font-weight: 600;
            vertical-align: middle;
            white-space: nowrap;
            padding: 13px 12px;
        }

        .order-table td {
            font-size: 15px;
            padding: 12px;
        }


    /* ==============================
       PRODUCT LIST
    ============================== */

    .order-products {
        max-height: 180px;
        overflow-y: auto;
        padding-right: 8px;
    }

        .order-products::-webkit-scrollbar {
            width: 6px;
        }

        .order-products::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }

        .order-products::-webkit-scrollbar-track {
            background: #f8f9fa;
        }


    /* ==============================
       PRODUCT ITEM
    ============================== */

    .order-product-item {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 10px 0;
        border-bottom: 1px solid #f0f0f0;
    }

        .order-product-item:last-child {
            border-bottom: none;
        }

    .order-product-image {
        width: 85px;
        height: 85px;
        object-fit: contain;
        flex-shrink: 0;
        border-radius: 10px;
        background: #f8f9fa;
        border: 1px solid #eee;
    }

    .order-product-info {
        min-width: 0;
        flex: 1;
    }

    .order-product-name {
        font-size: 15px;
        font-weight: 600;
        color: #212529;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 280px;
    }

    .order-product-info .small {
        font-size: 14px !important;
    }


    /* ==============================
       ADDRESS
    ============================== */

    .order-address {
        font-size: 15px;
        line-height: 1.6;
        color: #495057;
    }


    /* ==============================
       TOTAL PRICE
    ============================== */

    .order-table .text-success {
        font-size: 15px;
    }


    /* ==============================
       STATUS
    ============================== */

    .order-table .badge {
        font-size: 13px;
        padding: 8px 10px;
    }


    /* ==============================
       CANCEL BUTTON
    ============================== */

    .order-cancel-btn {
        font-size: 14px;
        padding: 7px 10px;
        transition: all 0.2s ease;
    }

        .order-cancel-btn:hover {
            transform: translateY(-1px);
        }


    /* ==============================
       MOBILE
    ============================== */

    @@media (max-width: 768px) {

        .container {
            margin-top: 20px !important;
        }

        .order-table th,
        .order-table td {
            font-size: 13px;
        }

        .order-products {
            max-height: 130px;
        }

        .order-product-image {
            width: 60px;
            height: 60px;
        }

        .order-product-item {
            gap: 10px;
            padding: 7px 0;
        }

        .order-product-name {
            font-size: 14px;
            max-width: 180px;
        }
    }

    .order-detail-btn {
        font-size: 14px;
        padding: 7px 10px;
        transition: all 0.2s ease;
    }

        .order-detail-btn:hover {
            transform: translateY(-1px);
        }
    /* =========================
       CANCEL ORDER MODAL
    ========================= */

    .cancel-modal {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.15);
    }

        .cancel-modal .modal-header {
            padding: 18px 20px;
            border-bottom: 1px solid #eee;
        }

        .cancel-modal .modal-body {
            padding: 20px;
        }

        .cancel-modal .modal-footer {
            padding: 15px 20px;
            border-top: 1px solid #eee;
        }

    .cancel-order-title {
        font-size: 14px;
        color: #555;
    }

    .cancel-reasons {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .cancel-reason-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border: 1px solid #e5e5e5;
        border-radius: 9px;
        cursor: pointer;
        font-size: 14px;
        transition: all 0.2s ease;
    }

        .cancel-reason-item:hover {
            border-color: #0d6efd;
            background: #f5f9ff;
        }

        .cancel-reason-item input {
            width: 16px;
            height: 16px;
            cursor: pointer;
        }

            .cancel-reason-item input:checked + span {
                color: #0d6efd;
                font-weight: 600;
            }

    .cancel-warning {
        padding: 10px 12px;
        background: #fff8e1;
        border-radius: 8px;
        color: #856404;
        font-size: 13px;
    }

    .cancel-modal .btn {
        border-radius: 8px;
        padding: 8px 16px;
    }
    /* =========================
       RETURN ORDER BUTTON
    ========================= */

    .order-return-btn {
        font-size: 14px;
        padding: 7px 10px;
        transition: all 0.2s ease;
    }

        .order-return-btn:hover {
            transform: translateY(-1px);
        }


    /* =========================
       RETURN STATUS
    ========================= */

    .return-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        max-width: 120px;
        padding: 6px 9px;
        border-radius: 8px;
        background: #fff3cd;
        color: #856404;
        font-size: 12px;
        font-weight: 600;
        line-height: 1.3;
    }
</style>