@using PetFeast.Models.Identity
@using PetFeast.Models.Voucher

@model List<PetFeast.Models.ShoppingCart.ShoppingCartItem>

@{
    var defaultAddress =
        ViewBag.DefaultAddress as UserAddress;

    var userVouchers =
        ViewBag.UserVouchers as List<UserVoucher>
        ?? new List<UserVoucher>();
}

<div class="container mt-4">
    <form asp-action="CheckOut" 
    asp-controller="Order"
          method="post">
        <div class="row">
            <!-- BÊN TRÁI -->
            <div class="col-lg-8">
                <!-- ĐỊA CHỈ NHẬN HÀNG -->
                <div class="card border-0 shadow-sm p-4 mb-4">

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <h4 class="fw-bold mb-0">
                            <i class="bi bi-geo-alt-fill text-primary me-2"></i>
                            Địa chỉ nhận hàng
                        </h4>

                        <a asp-controller="Address"
                           asp-action="Index"
                           asp-route-fromCheckout="true"
                           class="btn btn-outline-primary">
                            Thay đổi
                        </a>

                    </div>

                    @if (defaultAddress != null)
                    {
                        <div>

                            <div class="mb-2">

                                <strong>
                                    @defaultAddress.ReceiverName
                                </strong>

                                <span class="text-muted ms-2">
                                    @defaultAddress.PhoneNumber
                                </span>

                                <span class="badge bg-primary ms-2">
                                    Mặc định
                                </span>

                            </div>

                            <div class="text-muted">

                                <i class="bi bi-geo-alt me-2"></i>

                                @defaultAddress.AddressDetail,
                                @defaultAddress.Ward,
                                @defaultAddress.City

                            </div>

                        </div>
                    }

                </div>
                <!-- Hình thức nhận hàng -->
                <div class="card border-0 shadow-sm p-4 mb-4">
                    <h4 class="fw-bold mb-4">
                        Hình thức nhận hàng
                    </h4>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input"
                               type="radio"
                               name="DeliveryMethod"
                               value="Ship"
                               checked>
                        <label class="form-check-label">
                            Giao hàng tận nơi
                        </label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input"
                               type="radio"
                               name="DeliveryMethod"
                               value="Pickup">
                        <label class="form-check-label">
                            Nhận tại cửa hàng
                        </label>
                    </div>
                    <div id="shippingAddress" class="mt-4">

                        @if (defaultAddress != null)
                        {
                            <div class="alert alert-light border mb-0">

                                <i class="bi bi-info-circle text-primary me-2"></i>

                                Đơn hàng sẽ được giao đến
                                <strong>
                                    @defaultAddress.AddressDetail,
                                    @defaultAddress.Ward,
                                    @defaultAddress.City
                                </strong>

                            </div>
                        }

                    </div>
                    <div id="storeInfo"
                         class="store-info-card mt-4 d-none">

                        <div class="store-icon">
                            <i class="bi bi-shop"></i>
                        </div>

                        <div>

                            <h5 class="fw-bold mb-2">
                                Nhận tại cửa hàng PetFeast
                            </h5>

                            <p class="mb-2">
                                <i class="bi bi-geo-alt-fill text-danger"></i>
                                123 Đường Whatever, TP Đà Lạt, Lâm Đồng
                            </p>

                            <p class="mb-0">
                                <i class="bi bi-clock-fill text-warning"></i>
                                08:00 - 21:00 (Tất cả các ngày)
                            </p>

                        </div>

                    </div>
                </div>
                <!-- Sản phẩm -->
                <div class="card border-0 shadow-sm p-4 mb-4">
                    <h4 class="fw-bold mb-4">
                        Sản phẩm (@Model.Count)
                    </h4>
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Đơn giá</th>
                                <th>Số lượng</th>
                                <th>Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@item.ImageUrl"
                                                 width="70"
                                                 height="70"
                                                 style="object-fit:cover"
                                                 class="me-3 rounded" />
                                            <span>
                                                @item.ProductName
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        @item.Price.ToString("N0") đ
                                    </td>
                                    <td>
                                        x @item.Quantity
                                    </td>
                                    <td class="text-success fw-bold">
    @item.TotalPrice.ToString("N0") đ
</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <!-- ========================== -->
                <!-- PHƯƠNG THỨC THANH TOÁN -->
                <!-- ========================== -->

                <div class="card border-0 shadow-sm p-4 mb-4">

                    <h4 class="fw-bold mb-4">
                        <i class="bi bi-credit-card me-2 text-primary"></i>
                        Phương thức thanh toán
                    </h4>


                    <!-- COD -->
                    <div class="form-check mb-3">
                        <input class="form-check-input"
                               type="radio"
                               name="PaymentMethod"
                               id="paymentCOD"
                               value="COD"
                               checked>

                        <label class="form-check-label fw-semibold"
                               for="paymentCOD">

                            <i class="bi bi-truck me-2"></i>
                            Thanh toán khi nhận hàng (COD)

                        </label>

                        <div class="text-muted small ms-4 mt-1">
                            Thanh toán trực tiếp khi nhận hàng.
                        </div>
                    </div>

                    <!-- BANK TRANSFER -->
                    <div class="form-check">
                        <input class="form-check-input"
                               type="radio"
                               name="PaymentMethod"
                               id="paymentBank"
                               value="BankTransfer">

                        <label class="form-check-label fw-semibold"
                               for="paymentBank">

                            <i class="bi bi-bank me-2"></i>
                            Chuyển khoản ngân hàng

                        </label>

                        <div class="text-muted small ms-4 mt-1">
                            Sau khi đặt hàng, bạn sẽ nhận được mã QR và thông tin chuyển khoản.
                        </div>
                    </div>


                    

                </div>
            </div>
            <!-- BÊN PHẢI -->
            <div class="col-lg-4">
                <!-- Ghi chú -->
                <div class="card border-0 shadow-sm p-4 mb-3">
                    <h5 class="fw-bold mb-3">
                        Ghi chú đơn hàng
                    </h5>
                    <textarea class="form-control"
                              rows="5"
                              placeholder="Thêm ghi chú (tuỳ chọn)"
                              name="Note"></textarea>
                </div>

                <!-- Chi tiết thanh toán -->
                <div class="card border-0 shadow-sm p-4">

                    <h4 class="fw-bold mb-4">
                        Chi tiết thanh toán
                    </h4>

                    <!-- Tổng tiền hàng -->
                    <div class="d-flex justify-content-between mb-3">
                        <span>
                            Tổng tiền hàng
                        </span>

                        <span id="productTotal">
                            @Model.Sum(x => x.TotalPrice).ToString("N0") đ
                        </span>
                    </div>

                    <!-- Phí vận chuyển -->
                    <div class="d-flex justify-content-between mb-3">
                        <span>
                            Phí vận chuyển
                        </span>

                        <span id="shippingFee">
                            20.000 đ
                        </span>
                    </div>

                    <!-- SỬ DỤNG ĐIỂM -->
                    <div class="border rounded p-3 mb-3">

                        <div class="d-flex justify-content-between align-items-center mb-2">

                            <span class="fw-semibold">
                                <i class="bi bi-coin"></i>
                                Điểm tích lũy
                            </span>

                            <span class="text-primary fw-bold">
                                @ViewBag.UserPoints điểm
                            </span>

                        </div>

                        @if (ViewBag.UserPoints > 0)
                        {
                            <div class="input-group mt-2">

                                <input type="number"
                                       id="usedPoints"
                                       name="usedPoints"
                                       class="form-control"
                                       value="0"
                                       min="0"
                                       max="@ViewBag.UserPoints"
                                       placeholder="Số điểm muốn dùng">

                                <button type="button"
                                        class="btn btn-outline-primary"
                                        id="useAllPoints">
                                    Dùng tất cả
                                </button>

                            </div>

                            <small class="text-muted d-block mt-2">
                                1 điểm = 100đ
                            </small>

                            <div class="d-flex justify-content-between mt-3 text-success">

                                <span>
                                    Giảm từ điểm
                                </span>

                                <strong id="pointDiscount">
                                    -0 đ
                                </strong>

                            </div>
                        }
                        else
                        {
                            <small class="text-muted">
                                Bạn chưa có điểm tích lũy.
                            </small>
                        }

                    </div>
                    <!-- ========================== -->
                    <!-- VOUCHER -->
                    <!-- ========================== -->

                    <div class="border rounded p-3 mb-3">

                        <div class="d-flex justify-content-between align-items-center mb-2">

                            <span class="fw-semibold">
                                <i class="bi bi-ticket-perforated me-1"></i>
                                Voucher
                            </span>

                            <a asp-controller="Voucher"
                               asp-action="MyVouchers"
                               class="small text-primary text-decoration-none">
                                Voucher của tôi
                            </a>

                        </div>

                        @if (userVouchers.Any())
                        {
                            <select id="userVoucher"
                                    name="userVoucherId"
                                    class="form-select">

                                <option value="">
                                    -- Không sử dụng Voucher --
                                </option>

                                @foreach (var item in userVouchers)
                                {
                                    <option value="@item.UserVoucherId"
                                            data-discount="@item.Voucher.DiscountAmount"
                                            data-minimum="@item.Voucher.MinimumOrderAmount">

                                        @item.Voucher.Name
                                        - Giảm @item.Voucher.DiscountAmount.ToString("N0")đ
                                        (Đơn từ
                                        @item.Voucher.MinimumOrderAmount.ToString("N0")đ)

                                    </option>
                                }

                            </select>

                            <small class="text-muted d-block mt-2">
                                Chọn voucher bạn muốn sử dụng cho đơn hàng.
                            </small>

                            <div class="d-flex justify-content-between mt-3 text-success">

                                <span>
                                    Giảm từ Voucher
                                </span>

                                <strong id="voucherDiscount">
                                    -0 đ
                                </strong>

                            </div>
                        }
                        else
                        {
                            <div class="text-muted small">

                                Bạn chưa có voucher.

                                <a asp-controller="Voucher"
                                   asp-action="Index"
                                   class="text-primary">
                                    Đổi voucher bằng điểm
                                </a>

                            </div>
                        }

                    </div>
                    <hr />

                    <!-- Tổng thanh toán -->
                    <div class="d-flex justify-content-between mb-4">

                        <strong>
                            Tổng tiền thanh toán
                        </strong>

                        <strong class="text-success fs-4"
                                id="totalPayment">
                            @((Model.Sum(x => x.TotalPrice) + 20000).ToString("N0")) đ
                        </strong>

                    </div>

                    <button type="submit"
                            class="btn btn-warning w-100 fw-bold">
                        Đặt hàng
                    </button>

                </div>
            </div>
        </div>
    </form>
</div>
<script>

    // ==========================
    // TỔNG TIỀN SẢN PHẨM
    // ==========================

    const productTotal = @Model.Sum(x => x.TotalPrice);
    const userPoints = @ViewBag.UserPoints;


    // ==========================
    // DELIVERY
    // ==========================

    const deliveryMethods =
        document.querySelectorAll(
            'input[name="DeliveryMethod"]'
        );

    const shippingAddress =
        document.getElementById("shippingAddress");

    const storeInfo =
        document.getElementById("storeInfo");


    function toggleDelivery()
    {
        const selected =
            document.querySelector(
                'input[name="DeliveryMethod"]:checked'
            ).value;


        if (selected === "Ship")
        {
            shippingAddress.classList.remove("d-none");
            storeInfo.classList.add("d-none");
        }
        else
        {
            shippingAddress.classList.add("d-none");
            storeInfo.classList.remove("d-none");
        }


        updateTotal();
    }


    deliveryMethods.forEach(x =>
    {
        x.addEventListener(
            "change",
            toggleDelivery
        );
    });


    // ==========================
    // TÍNH TỔNG TIỀN
    // ==========================

    function updateTotal()
    {
        // ==========================
        // PHÍ SHIP
        // ==========================

        const delivery =
            document.querySelector(
                'input[name="DeliveryMethod"]:checked'
            ).value;

        let shipping = 0;

        if (delivery === "Ship")
        {
            shipping = 20000;
        }


        // ==========================
        // ĐIỂM
        // ==========================

        const usedPointsInput =
            document.getElementById("usedPoints");

        let usedPoints = 0;

        if (usedPointsInput)
        {
            usedPoints =
                parseInt(usedPointsInput.value) || 0;

            if (usedPoints < 0)
            {
                usedPoints = 0;
                usedPointsInput.value = 0;
            }

            if (usedPoints > userPoints)
            {
                usedPoints = userPoints;
                usedPointsInput.value = userPoints;
            }
        }


        // ==========================
        // 1 ĐIỂM = 100Đ
        // ==========================

        let pointDiscount =
            usedPoints * 100;


        const totalBeforeDiscount =
            productTotal + shipping;


        // Không giảm quá tổng đơn
        if (pointDiscount > totalBeforeDiscount)
        {
            usedPoints =
                Math.floor(
                    totalBeforeDiscount / 100
                );

            if (usedPointsInput)
            {
                usedPointsInput.value =
                    usedPoints;
            }

            pointDiscount =
                usedPoints * 100;
        }


        // ==========================
        // VOUCHER
        // ==========================

        const voucherSelect =
            document.getElementById("userVoucher");

        let voucherDiscount = 0;

        if (
            voucherSelect &&
            voucherSelect.value
        )
        {
            const selectedOption =
                voucherSelect.options[
                    voucherSelect.selectedIndex
                ];

            const discount =
                parseFloat(
                    selectedOption.dataset.discount
                ) || 0;

            const minimum =
                parseFloat(
                    selectedOption.dataset.minimum
                ) || 0;


            // Điều kiện đơn tối thiểu
            if (productTotal >= minimum)
            {
                voucherDiscount = discount;
            }
        }


        // ==========================
        // KHÔNG GIẢM QUÁ TỔNG
        // ==========================

        const remainingAfterPoints =
            totalBeforeDiscount -
            pointDiscount;


        if (voucherDiscount >
            remainingAfterPoints)
        {
            voucherDiscount =
                Math.max(
                    0,
                    remainingAfterPoints
                );
        }


        // ==========================
        // TỔNG CUỐI
        // ==========================

        let totalPayment =
            totalBeforeDiscount -
            pointDiscount -
            voucherDiscount;


        if (totalPayment < 0)
        {
            totalPayment = 0;
        }


        // ==========================
        // HIỂN THỊ PHÍ SHIP
        // ==========================

        document.getElementById(
            "shippingFee"
        ).innerText =
            shipping.toLocaleString("vi-VN")
            + " đ";


        // ==========================
        // HIỂN THỊ GIẢM ĐIỂM
        // ==========================

        const pointDiscountElement =
            document.getElementById(
                "pointDiscount"
            );

        if (pointDiscountElement)
        {
            pointDiscountElement.innerText =
                "-" +
                pointDiscount.toLocaleString("vi-VN")
                + " đ";
        }


        // ==========================
        // HIỂN THỊ GIẢM VOUCHER
        // ==========================

        const voucherDiscountElement =
            document.getElementById(
                "voucherDiscount"
            );

        if (voucherDiscountElement)
        {
            voucherDiscountElement.innerText =
                "-" +
                voucherDiscount.toLocaleString("vi-VN")
                + " đ";
        }


        // ==========================
        // HIỂN THỊ TỔNG
        // ==========================

        document.getElementById(
            "totalPayment"
        ).innerText =
            totalPayment.toLocaleString("vi-VN")
            + " đ";
    }


    // ==========================
    // NHẬP ĐIỂM
    // ==========================

    const usedPointsInput =
        document.getElementById("usedPoints");

    if (usedPointsInput)
    {
        usedPointsInput.addEventListener(
            "input",
            updateTotal
        );
    }


    // ==========================
    // DÙNG TẤT CẢ ĐIỂM
    // ==========================

    const useAllPoints =
        document.getElementById("useAllPoints");

    if (useAllPoints)
    {
        useAllPoints.addEventListener(
            "click",
            function ()
            {
                if (usedPointsInput)
                {
                    usedPointsInput.value =
                        userPoints;

                    updateTotal();
                }
            }
        );
    }


    // ==========================
    // CHỌN VOUCHER
    // ==========================

    const voucherSelect =
        document.getElementById("userVoucher");

    if (voucherSelect)
    {
        voucherSelect.addEventListener(
            "change",
            updateTotal
        );
    }


    // ==========================
    // KHỞI TẠO
    // ==========================

    toggleDelivery();

</script>