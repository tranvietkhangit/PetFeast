@model IEnumerable<PetFeast.Models.Notifications.Notification>

<div class="notification-content">

    <!-- TIÊU ĐỀ -->
    <div class="notification-header px-3 py-3 border-bottom">
        <h6 class="mb-0 fw-bold">
            <i class="bi bi-bell me-2"></i>
            Thông báo
        </h6>
    </div>

    <!-- DANH SÁCH CÓ THANH CUỘN -->
    <div class="notification-list">

        @if (Model == null || !Model.Any())
        {
            <div class="text-center text-muted py-4">
                <i class="bi bi-bell-slash fs-3 d-block mb-2"></i>
                <p class="mb-0">Chưa có thông báo nào.</p>
            </div>
        }
        else
        {
            foreach (var notification in Model)
            {
                <div class="notification-item border-bottom px-3 py-3
                                    @(notification.IsRead ? "" : "bg-light")"
                     data-notification-id="@notification.Id"
                     data-is-read="@notification.IsRead.ToString().ToLower()">

                    <div class="d-flex align-items-start gap-2">

                        <i class="bi bi-info-circle text-primary mt-1"></i>

                        <div class="flex-grow-1">

                            <div class="fw-semibold">
                                @notification.Title
                            </div>

                            <div class="small text-muted mt-1">
                                @notification.Message
                            </div>

                            <small class="text-secondary">
                                @notification.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </small>

                            @if (!notification.IsRead)
                            {
                                <span class="badge bg-primary ms-2">
                                    Mới
                                </span>
                            }

                        </div>
                    </div>

                </div>
            }
        }

    </div>

    <!-- XEM TẤT CẢ -->
    <div class="notification-footer p-2 border-top">
        <a asp-controller="Notification"
           asp-action="Index"
           class="btn btn-sm btn-outline-primary w-100">

            <i class="bi bi-list-ul me-1"></i>
            Xem tất cả thông báo

        </a>
    </div>

</div>

<style>
    /* Khung dropdown thông báo */
    .notification-dropdown {
        padding: 0;
        width: 380px;
        max-width: 90vw;
    }

    /* Nội dung dropdown */
    .notification-content {
        width: 100%;
    }

    /* Danh sách thông báo */
    .notification-list {
        max-height: 230px;
        overflow-y: auto;
    }

        /* Thanh cuộn */
        .notification-list::-webkit-scrollbar {
            width: 6px;
        }

        .notification-list::-webkit-scrollbar-thumb {
            background-color: #bdbdbd;
            border-radius: 10px;
        }

        .notification-list::-webkit-scrollbar-track {
            background-color: #f5f5f5;
        }

    /* Mỗi thông báo */
    .notification-item {
        transition: background-color 0.2s ease;
    }

        .notification-item:hover {
            background-color: #f0f6ff;
        }

        /* Thông báo đã đọc */
        .notification-item.read {
            background-color: #ffffff;
        }

    /* Phần cuối dropdown */
    .notification-footer {
        background-color: white;
    }
</style>

<script>

    document.addEventListener(
        "shown.bs.dropdown",
        function (event) {

            const notificationList =
                document.querySelector(".notification-list");

            if (!notificationList) {
                return;
            }


            // ==========================================
            // Lấy các notification chưa đọc
            // ==========================================
            const unreadItems =
                notificationList.querySelectorAll(
                    ".notification-item[data-is-read='false']"
                );

            if (unreadItems.length === 0) {
                return;
            }


            // ==========================================
            // Theo dõi notification khi xuất hiện
            // ==========================================
            const observer =
                new IntersectionObserver(
                    async function (entries, observer) {

                        for (const entry of entries) {

                            if (!entry.isIntersecting) {
                                continue;
                            }


                            const item =
                                entry.target;

                            const id =
                                item.dataset.notificationId;

                            if (!id) {
                                continue;
                            }


                            // Không gửi request nhiều lần
                            if (
                                item.dataset.marking === "true"
                            ) {
                                continue;
                            }

                            item.dataset.marking =
                                "true";


                            // ==========================================
                            // Lấy AntiForgeryToken
                            // ==========================================
                            const token =
                                document.querySelector(
                                    'input[name="__RequestVerificationToken"]'
                                );


                            const formData =
                                new FormData();

                            formData.append(
                                "id",
                                id
                            );


                            if (token) {

                                formData.append(
                                    "__RequestVerificationToken",
                                    token.value
                                );
                            }


                            try {

                                // ==========================================
                                // Gọi Controller
                                // ==========================================
                                const response =
                                    await fetch(
                                        '@Url.Action("MarkAsRead", "Notification")',
                                        {
                                            method: "POST",
                                            body: formData
                                        }
                                    );


                                if (!response.ok) {

                                    throw new Error(
                                        `HTTP ${response.status}`
                                    );
                                }


                                // ==========================================
                                // Nhận kết quả
                                // ==========================================
                                const result =
                                    await response.json();


                                console.log(
                                    "Dropdown MarkAsRead:",
                                    result
                                );


                                // ==========================================
                                // Thành công
                                // ==========================================
                                if (result.success) {

                                    // -------------------------------
                                    // Bỏ nền chưa đọc
                                    // -------------------------------
                                    item.classList.remove(
                                        "bg-light"
                                    );


                                    // -------------------------------
                                    // Đánh dấu đã đọc
                                    // -------------------------------
                                    item.dataset.isRead =
                                        "true";


                                    // -------------------------------
                                    // Xóa chữ "Mới"
                                    // -------------------------------
                                    const badge =
                                        item.querySelector(
                                            ".badge"
                                        );

                                    if (badge) {
                                        badge.remove();
                                    }


                                    // -------------------------------
                                    // Cập nhật số trên icon chuông
                                    // -------------------------------
                                    updateNotificationBadge(
                                        result.unreadCount
                                    );


                                    // -------------------------------
                                    // Không theo dõi item nữa
                                    // -------------------------------
                                    observer.unobserve(
                                        item
                                    );
                                }
                                else {

                                    console.warn(
                                        "Không thể đánh dấu notification:",
                                        result
                                    );

                                    // Cho phép thử lại
                                    item.dataset.marking =
                                        "false";
                                }

                            }
                            catch (error) {

                                console.error(
                                    "Dropdown MarkAsRead error:",
                                    error
                                );

                                // Cho phép thử lại
                                item.dataset.marking =
                                    "false";
                            }
                        }

                    },
                    {
                        root: notificationList,
                        threshold: 0.5
                    }
                );


            // ==========================================
            // Bắt đầu theo dõi
            // ==========================================
            unreadItems.forEach(
                function (item) {

                    observer.observe(item);

                }
            );

        }
    );

</script>