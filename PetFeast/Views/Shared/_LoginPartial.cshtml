@using PetFeast.Models.Identity
@using Microsoft.AspNetCore.Identity

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var user = await UserManager.GetUserAsync(User);
    var displayName = !string.IsNullOrWhiteSpace(user?.FullName)
                ? user.FullName
                : user?.UserName ?? "bạn";
}

<li class="nav-item dropdown">

    <a class="nav-link dropdown-toggle"
       href="#"
       role="button"
       data-bs-toggle="dropdown"
       aria-expanded="false">

        <i class="bi bi-person-circle account-icon"></i>

        @if (SignInManager.IsSignedIn(User))
        {
            <span class="account-name" title="@displayName">
                Xin chào, @displayName
            </span>
        }

    </a>

    <ul class="dropdown-menu dropdown-menu-end">

        @if (SignInManager.IsSignedIn(User))
        {
            <li>
                <a class="dropdown-item"
                   asp-controller="Home"
                   asp-action="UserPoint">
                    <i class="bi bi-coin"></i>
                    <strong>
                        @user?.Points điểm
                    </strong>

                </a>
            </li>

            <li><hr class="dropdown-divider"></li>
            <li>
                <a class="dropdown-item"
                   asp-controller="Account"
                   asp-action="Index">

                    <i class="bi bi-person-circle me-2"></i>
                    Tài khoản của tôi

                </a>
            </li>
            <li>
                <a class="dropdown-item"
                   asp-controller="Order"
                   asp-action="UserOrderList">

                    <i class="bi bi-bag"></i>
                    Đơn hàng của tôi

                </a>
            </li>
            <a asp-controller="Review"
               asp-action="MyReviews"
               class="dropdown-item">

                <i class="bi bi-star me-2"></i>
                Đánh giá của tôi

            </a>
            <li>
                <a asp-controller="Favorite"
                   asp-action="Index"
                   class="dropdown-item">
                    <i class="bi bi-heart"></i>
                    Sản phẩm yêu thích
                </a>
            </li>
            <li>
                <a asp-controller="Voucher"
                   asp-action="MyVouchers"
                   class="dropdown-item">

                    <i class="bi bi-ticket"></i>
                    Voucher của tôi

                </a>
            </li>

            <li><hr class="dropdown-divider"></li>

            <li>
                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      method="post">

                    <button type="submit"
                            class="dropdown-item">

                        <i class="bi bi-box-arrow-right"></i>
                        Đăng xuất

                    </button>

                </form>
            </li>
        }
        else
        {
            <li>
                <a class="dropdown-item"
                   asp-area="Identity"
                   asp-page="/Account/Login">

                    Đăng nhập

                </a>
            </li>

            <li>
                <a class="dropdown-item"
                   asp-area="Identity"
                   asp-page="/Account/Register">

                    Đăng ký

                </a>
            </li>
        }

    </ul>

</li>
<style>
    .account-name {
        display: inline-block;
        max-width: 180px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        vertical-align: middle;
    }
</style>