<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8">

    <title>PetFeast Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="icon"
          type="image/png"
          href="~/img/Logo/logo1.png">

    <link rel="stylesheet" href="~/css/admin.css" />

</head>

<body>

    <div class="sidebar">

        <div class="logo">

            <img src="~/img/logo/logo1.png"
                 alt="PetFeast Logo">

        </div>

        <ul>

            <li>
                <a asp-controller="Admin"
                   asp-action="Dashboard">

                    <i class="bi bi-speedometer2"></i>
                    Dashboard

                </a>
            </li>

            <li>
                <a asp-controller="Admin"
                   asp-action="ProductList">

                    <i class="bi bi-box-seam"></i>
                    Sản phẩm

                </a>
            </li>

            <li>
                <a asp-controller="Admin"
                   asp-action="CategoryList">

                    <i class="bi bi-grid"></i>
                    Danh mục

                </a>
            </li>

            <!-- ĐƠN HÀNG -->
            <li>
                <a asp-controller="Admin"
                   asp-action="OrderList">

                    <i class="bi bi-cart3"></i>
                    <span>Đơn hàng</span>

                    <span id="newOrderBadge"
                          class="notification-badge d-none">
                        0
                    </span>

                </a>
            </li>

            <!-- HOÀN TRẢ -->
            <li>
                <a asp-controller="Admin"
                   asp-action="ReturnRequestList">

                    <i class="bi bi-arrow-return-left"></i>
                    <span>Hoàn trả</span>

                    <span id="returnBadge"
                          class="notification-badge d-none">
                        0
                    </span>

                </a>
            </li>

            <!-- VOUCHER -->
            <li>
                <a asp-controller="Admin"
                   asp-action="VoucherList"
                   class="nav-link">

                    <i class="bi bi-ticket-perforated me-2"></i>
                    Quản lý Voucher

                </a>
            </li>
            <!-- CONTACT -->
            <li class="nav-item">
                <a asp-controller="AdminContact"
                   asp-action="Index"
                   class="nav-link d-flex align-items-center">

                    <i class="bi bi-envelope me-2"></i>

                    <span>Quản lý liên hệ</span>

                    @await Component.InvokeAsync(
                    "UnreadContactCount")
                </a>
            </li>
            <!-- ĐĂNG XUẤT -->
            <li>

                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      method="post">

                    <button type="submit"
                            class="logout-btn">

                        <i class="bi bi-box-arrow-right"></i>
                        Đăng xuất

                    </button>

                </form>

            </li>

        </ul>

    </div>

    <div class="main">

        <div class="topbar">

            <h3>Quản lý PetFeast</h3>

        </div>

        <div class="content">

            @RenderBody()

        </div>

    </div>

    <!-- ============================= -->
    <!-- CẬP NHẬT THÔNG BÁO ADMIN -->
    <!-- ============================= -->

    <script>

        async function updateAdminNotifications() {

            try {

                const response =
                    await fetch('/Admin/GetAdminNotificationCount');

                if (!response.ok)
                    return;

                const data = await response.json();

                const orderBadge =
                    document.getElementById('newOrderBadge');

                const returnBadge =
                    document.getElementById('returnBadge');


                // =========================
                // ĐƠN HÀNG MỚI
                // =========================

                if (data.newOrderCount > 0) {

                    orderBadge.textContent =
                        data.newOrderCount;

                    orderBadge.classList.remove('d-none');

                }
                else {

                    orderBadge.classList.add('d-none');

                }


                // =========================
                // YÊU CẦU HOÀN TRẢ
                // =========================

                if (data.pendingReturnCount > 0) {

                    returnBadge.textContent =
                        data.pendingReturnCount;

                    returnBadge.classList.remove('d-none');

                }
                else {

                    returnBadge.classList.add('d-none');

                }

            }
            catch (error) {

                console.error(
                    'Không thể cập nhật thông báo:',
                    error
                );

            }

        }


        // Cập nhật ngay khi mở trang
        updateAdminNotifications();


        // Cập nhật mỗi 10 giây
        setInterval(
            updateAdminNotifications,
            10000
        );

    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
<style>
    /* ========================================
           GLOBAL ADMIN
        ======================================== */

    body {
        background: #f5f8fc;
    }

    .main {
        background: #f5f8fc;
        min-height: 100vh;
    }

    .content {
        padding: 0;
    }

    /* ========================================
           NOTIFICATION BADGE
        ======================================== */

    .notification-badge {
        margin-left: auto;
        min-width: 24px;
        height: 24px;
        padding: 0 7px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #dc3545;
        color: #fff;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        line-height: 1;
        box-shadow: 0 2px 6px rgba(220, 53, 69, 0.35);
        animation: notificationPulse 2s infinite;
    }

    @@keyframes notificationPulse {
        0% {
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.4);
        }

        70% {
            box-shadow: 0 0 0 6px rgba(220, 53, 69, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0);
        }
    }

    .notification-badge.d-none {
        display: none !important;
    }

    /* ========================================
       ADMIN LIST PAGES
       Product - Category - Order
    ======================================== */

    .admin-list-page {
        padding: 30px 24px;
        background: transparent;
    }

        /* ========================================
       PAGE HEADER
    ======================================== */

        .admin-list-page .admin-page-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 24px;
            margin: 0 0 30px 0;
            padding: 0 4px;
            flex-wrap: wrap;
        }

        .admin-list-page .admin-page-title {
            margin: 0;
            color: #212529 !important;
            font-size: 28px;
            font-weight: 700;
            line-height: 1.4;
        }

        .admin-list-page .admin-page-header p {
            margin-top: 10px !important;
            margin-bottom: 0;
            color: #6c757d;
            font-size: 15px;
        }

        /* ========================================
       SEARCH
    ======================================== */

        .admin-list-page .admin-search {
            display: flex;
            align-items: stretch;
            width: 340px;
            max-width: 100%;
            margin-top: 2px;
        }

            .admin-list-page .admin-search input {
                flex: 1;
                min-width: 0;
                width: 100%;
                height: 42px;
                padding: 0 14px;
                border: 1px solid #ced4da;
                border-right: none;
                border-radius: 8px 0 0 8px;
                background: #fff;
                color: #212529;
                font-size: 14px;
                outline: none;
                transition: border-color .2s ease, box-shadow .2s ease;
            }

                .admin-list-page .admin-search input::placeholder {
                    color: #9ca3af;
                }

                .admin-list-page .admin-search input:focus {
                    border-color: #0d6efd;
                    box-shadow: 0 0 0 3px rgba(13, 110, 253, .12);
                }

            .admin-list-page .admin-search button {
                width: 48px;
                height: 42px;
                display: flex;
                align-items: center;
                justify-content: center;
                border: none;
                border-radius: 0 8px 8px 0;
                background: #0d6efd;
                color: #fff;
                cursor: pointer;
                transition: background .2s ease;
            }

                .admin-list-page .admin-search button:hover {
                    background: #0a58ca;
                }

        /* ========================================
       CARD
    ======================================== */

        .admin-list-page .admin-card {
            margin-top: 0;
            background: #fff;
            border: 1px solid #e5eaf0;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, .04);
            overflow: hidden;
        }

        .admin-list-page .admin-card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            padding: 20px 24px;
            background: #fff;
            color: #212529;
            border-bottom: 1px solid #e9ecef;
            flex-wrap: wrap;
        }

            .admin-list-page .admin-card-header h4 {
                margin: 0;
                color: #212529;
                font-size: 20px;
                font-weight: 700;
            }

                .admin-list-page .admin-card-header h4 i {
                    color: #0d6efd;
                }

        .admin-list-page .admin-card-body {
            padding: 24px;
            background: #fff;
        }

        /* ========================================
       ADD BUTTON
    ======================================== */

        .admin-list-page .admin-btn-add {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            padding: 10px 16px;
            border: none;
            border-radius: 8px;
            background: #0d6efd;
            color: #fff;
            font-weight: 600;
            text-decoration: none;
            transition: all .2s ease;
        }

            .admin-list-page .admin-btn-add:hover {
                background: #0a58ca;
                color: #fff;
                transform: translateY(-1px);
            }

        /* ========================================
       TABLE
    ======================================== */

        .admin-list-page .admin-table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        .admin-list-page .admin-table {
            min-width: 850px;
            margin-bottom: 0;
            vertical-align: middle;
        }

            .admin-list-page .admin-table thead th {
                padding: 16px 14px;
                background: #f8f9fa;
                color: #343a40;
                border-top: 1px solid #e9ecef;
                border-bottom: 1px solid #dee2e6;
                font-size: 13px;
                font-weight: 700;
                white-space: nowrap;
            }

            .admin-list-page .admin-table tbody td {
                padding: 14px;
                color: #374151;
                border-color: #edf0f2;
                font-size: 14px;
            }

            .admin-list-page .admin-table tbody tr {
                transition: background .2s ease;
            }

                .admin-list-page .admin-table tbody tr:hover {
                    background: #f8fbff;
                }

                .admin-list-page .admin-table tbody tr:last-child td {
                    border-bottom: none;
                }

        /* ========================================
       ACTION BUTTONS
    ======================================== */

        .admin-list-page .admin-action-buttons {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
        }

            .admin-list-page .admin-action-buttons .btn {
                width: 34px;
                height: 34px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0;
                border-radius: 8px;
            }

        /* ========================================
       PRODUCT IMAGE
    ======================================== */

        .admin-list-page .admin-product-image {
            width: 64px;
            height: 64px;
            object-fit: cover;
            border-radius: 10px;
            border: 1px solid #e9ecef;
            background: #fff;
        }

        /* ========================================
       STATUS BADGES
    ======================================== */

        .admin-list-page .admin-status,
        .admin-list-page .admin-status-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 7px 11px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
        }

        .admin-list-page .status-success {
            background: #dff5e8;
            color: #16804a;
        }

        .admin-list-page .status-warning {
            background: #fff3cd;
            color: #997404;
        }

        .admin-list-page .status-primary {
            background: #e5efff;
            color: #0d6efd;
        }

        .admin-list-page .status-danger {
            background: #ffe5e8;
            color: #dc3545;
        }

        .admin-list-page .status-secondary {
            background: #eef0f2;
            color: #6b7280;
        }

        .admin-list-page .status-refunded {
            background: #e0f7f1;
            color: #087f5b;
        }

        /* ========================================
       ORDER TABLE
    ======================================== */

        .admin-list-page .order-table {
            min-width: 1250px;
        }

        .admin-list-page .order-code {
            color: #0d6efd;
            font-weight: 700;
            text-decoration: none;
        }

            .admin-list-page .order-code:hover {
                color: #0a58ca;
                text-decoration: underline;
            }

        .admin-list-page .customer-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .admin-list-page .customer-avatar {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            border-radius: 50%;
            background: #e8f0ff;
            color: #0d6efd;
        }

        .admin-list-page .customer-name {
            color: #374151;
            font-weight: 600;
        }

        .admin-list-page .order-date {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

            .admin-list-page .order-date strong {
                font-size: 13px;
            }

            .admin-list-page .order-date small {
                color: #6b7280;
            }

        .admin-list-page .order-total {
            color: #374151;
            white-space: nowrap;
        }

        .admin-list-page .payment-method {
            display: block;
            margin-top: 4px;
            color: #6b7280;
            font-size: 11px;
        }

        /* ========================================
       ORDER ACTIONS
    ======================================== */

        .admin-list-page .admin-order-actions {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
        }

            .admin-list-page .admin-order-actions form {
                display: inline-flex;
                margin: 0;
            }

            .admin-list-page .admin-order-actions .btn {
                width: 34px;
                height: 34px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0;
                border-radius: 8px;
            }

        .admin-list-page .admin-detail-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 9px 14px;
            border: none;
            border-radius: 8px;
            background: #0d6efd;
            color: #fff;
            font-size: 12px;
            font-weight: 600;
            text-decoration: none;
            white-space: nowrap;
        }

            .admin-list-page .admin-detail-btn:hover {
                background: #0a58ca;
                color: #fff;
            }

        /* ========================================
       EMPTY STATE
    ======================================== */

        .admin-list-page .admin-empty-state {
            padding: 60px 20px;
            text-align: center;
        }

            .admin-list-page .admin-empty-state i {
                display: block;
                margin-bottom: 15px;
                color: #adb5bd;
                font-size: 48px;
            }

            .admin-list-page .admin-empty-state h5 {
                margin-bottom: 8px;
                color: #374151;
            }

    /* ========================================
       RESPONSIVE
    ======================================== */

    @@media (max-width: 768px) {
        .admin-list-page

    {
        padding: 20px 15px;
    }

    .admin-list-page .admin-page-header {
        gap: 16px;
        margin-bottom: 22px;
        padding: 0;
    }

    .admin-list-page .admin-page-title {
        font-size: 23px;
    }

    .admin-list-page .admin-page-header p {
        font-size: 14px;
    }

    .admin-list-page .admin-search {
        width: 100%;
        margin-top: 8px;
    }

    .admin-list-page .admin-card-header {
        padding: 16px;
    }

    .admin-list-page .admin-card-body {
        padding: 16px;
    }

    .admin-list-page .admin-card-header h4 {
        font-size: 18px;
    }

    .admin-list-page .admin-table {
        min-width: 900px;
    }

    .admin-list-page .order-table {
        min-width: 1250px;
    }

    }
    /* =========================================
       ADMIN FORM & DETAIL PAGES
    ========================================= */

    .admin-page {
        padding: 30px 24px;
        color: #212529;
    }

    /* Header trang */

    .admin-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
    }

    .admin-page-title {
        color: #212529;
        font-size: 26px;
        font-weight: 700;
        margin: 0;
    }

    .admin-page-subtitle {
        color: #6c757d;
        margin-top: 6px;
        margin-bottom: 0;
    }

    /* Card */

    .admin-card {
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 14px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
        overflow: hidden;
        margin-bottom: 24px;
    }

    .admin-card-header {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #fff;
        border-bottom: 1px solid #e9ecef;
        padding: 20px 24px;
    }

        .admin-card-header h4,
        .admin-card-header h5 {
            color: #212529;
            font-weight: 700;
            margin: 0;
        }

    .admin-card-body {
        padding: 24px;
    }

    /* Form */

    .admin-form-label {
        display: block;
        color: #343a40;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .admin-form .form-control,
    .admin-form .form-select {
        min-height: 44px;
        border: 1px solid #ced4da;
        border-radius: 8px;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

        .admin-form .form-control:focus,
        .admin-form .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.12);
        }

    .admin-form textarea.form-control {
        min-height: 120px;
        resize: vertical;
    }

    /* Buttons */

    .admin-btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-height: 42px;
        padding: 9px 18px;
        color: #fff;
        background: #0d6efd;
        border: 1px solid #0d6efd;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s;
    }

        .admin-btn-primary:hover {
            color: #fff;
            background: #0a58ca;
            border-color: #0a58ca;
        }

    .admin-btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-height: 42px;
        padding: 9px 18px;
        color: #495057;
        background: #fff;
        border: 1px solid #ced4da;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s;
    }

        .admin-btn-secondary:hover {
            color: #212529;
            background: #f1f3f5;
        }

    .admin-btn-warning {
        background: #ffc107;
        border-color: #ffc107;
        color: #212529;
    }

        .admin-btn-warning:hover {
            background: #e0a800;
            border-color: #e0a800;
            color: #212529;
        }

    /* Form buttons */

    .admin-form-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 24px;
        padding-top: 20px;
        border-top: 1px solid #e9ecef;
    }

    /* Image preview */

    .admin-image-preview {
        width: 150px;
        height: 150px;
        object-fit: cover;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 4px;
        background: #fff;
    }

    /* Detail cards */

    .admin-detail-label {
        display: block;
        color: #6c757d;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .admin-detail-value {
        color: #212529;
        font-weight: 500;
        margin-bottom: 18px;
    }

    .admin-detail-card .admin-card-body {
        padding: 24px;
    }

    /* Order detail */

    .admin-order-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 24px;
    }

    .admin-order-title {
        color: #212529;
        font-size: 25px;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .admin-order-subtitle {
        color: #6c757d;
        margin: 0;
    }

    .admin-section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #212529;
        font-size: 17px;
        font-weight: 700;
    }

    /* Table trong chi tiết đơn */

    .admin-detail-table {
        margin-bottom: 0;
    }

        .admin-detail-table thead th {
            background: #f8f9fa;
            color: #495057;
            font-size: 13px;
            font-weight: 700;
            border-bottom: 1px solid #dee2e6;
            padding: 14px;
        }

        .admin-detail-table tbody td {
            padding: 14px;
            vertical-align: middle;
        }

    .admin-product-image {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #e9ecef;
    }

    /* Tổng tiền */

    .admin-order-total {
        color: #0d6efd;
        font-size: 28px;
        font-weight: 700;
    }

    /* Evidence */

    .evidence-video-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #0d6efd;
        text-decoration: none;
        font-weight: 500;
    }

        .evidence-video-link:hover {
            color: #0a58ca;
            text-decoration: underline;
        }

    /* Return actions */

    .return-action-area {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        width: 100%;
    }

    .reject-form {
        display: flex;
        flex: 1 1 100%;
        align-items: center;
        gap: 8px;
    }

        .reject-form .form-control {
            flex: 1;
            min-width: 0;
        }

    /* Responsive */

    @@media (max-width: 768px) {
        .admin-page

    {
        padding: 20px 14px;
    }

    .admin-page-header,
    .admin-order-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .admin-page-title,
    .admin-order-title {
        font-size: 22px;
    }

    .admin-card-body {
        padding: 18px;
    }

    .admin-card-header {
        padding: 16px 18px;
