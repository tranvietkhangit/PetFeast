<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>PetFeast Admin</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Favicon -->
    <link rel="icon"
          type="image/png"
          href="~/img/Logo/logo1.png" />

    <!-- Admin CSS -->
    <link rel="stylesheet"
          href="~/css/admin.css" />

</head>

<body>

    <!-- =========================================================
         SIDEBAR
    ========================================================== -->

    <div class="sidebar">

        <!-- LOGO -->
        <div class="logo">
            <img src="~/img/Logo/logo1.png"
                 alt="PetFeast Logo" />
        </div>

        <!-- MENU -->
        <ul>

            <!-- DASHBOARD -->
            <li>
                <a asp-controller="Admin"
                   asp-action="Dashboard">

                    <i class="bi bi-speedometer2"></i>

                    <span>Dashboard</span>

                </a>
            </li>


            <!-- SẢN PHẨM -->
            <li>
                <a asp-controller="Admin"
                   asp-action="ProductList">

                    <i class="bi bi-box-seam"></i>

                    <span>Sản phẩm</span>

                </a>
            </li>


            <!-- DANH MỤC -->
            <li>
                <a asp-controller="Admin"
                   asp-action="CategoryList">

                    <i class="bi bi-grid"></i>

                    <span>Danh mục</span>

                </a>
            </li>


            <!-- ĐƠN HÀNG -->
            <li>
                <a asp-controller="Admin"
                   asp-action="OrderList">

                    <i class="bi bi-cart3"></i>

                    <span>Đơn hàng</span>

                    <span id="newOrderBadge"
                          class="notification-badge d-none">
                        0
                    </span>

                </a>
            </li>


            <!-- HOÀN TRẢ -->
            <li>
                <a asp-controller="Admin"
                   asp-action="ReturnRequestList">

                    <i class="bi bi-arrow-return-left"></i>

                    <span>Hoàn trả</span>

                    <span id="returnBadge"
                          class="notification-badge d-none">
                        0
                    </span>

                </a>
            </li>


            <!-- VOUCHER -->
            <li>
                <a asp-controller="Admin"
                   asp-action="VoucherList"
                   class="nav-link">

                    <i class="bi bi-ticket-perforated me-2"></i>

                    <span>Quản lý Voucher</span>

                </a>
            </li>


            <!-- LIÊN HỆ -->
            <li class="nav-item">

                <a asp-controller="AdminContact"
                   asp-action="Index"
                   class="nav-link d-flex align-items-center">

                    <i class="bi bi-envelope me-2"></i>

                    <span>Quản lý liên hệ</span>

                    @await Component.InvokeAsync("UnreadContactCount")

                </a>

            </li>


            <!-- TỐ CÁO ĐÁNH GIÁ -->
            <li>
                <a asp-controller="Admin"
                   asp-action="ReviewReports">

                    <i class="bi bi-flag"></i>

                    <span>Tố cáo đánh giá</span>

                    <span id="reportBadge"
                          class="notification-badge d-none">
                        0
                    </span>

                </a>
            </li>


            <!-- ĐĂNG XUẤT -->
            <li>

                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      method="post">

                    <button type="submit"
                            class="logout-btn">

                        <i class="bi bi-box-arrow-right"></i>

                        <span>Đăng xuất</span>

                    </button>

                </form>

            </li>

        </ul>

    </div>


    <!-- =========================================================
         MAIN
    ========================================================== -->

    <div class="main">

        <!-- TOPBAR -->
        <div class="topbar">

            <h3>
                Quản lý PetFeast
            </h3>

        </div>


        <!-- CONTENT -->
        <div class="content">

            @RenderBody()

        </div>

    </div>


    <!-- =========================================================
         BACK TO TOP
    ========================================================== -->

    <button id="backToTop"
            class="back-to-top"
            type="button"
            aria-label="Quay lại đầu trang">

        <i class="bi bi-arrow-up"></i>

    </button>


    <!-- =========================================================
         GLOBAL PETFEAST ACTION MODAL
    ========================================================== -->

    <div class="modal fade"
         id="petFeastActionModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered modal-sm">

            <div class="modal-content petfeast-modal">

                <div class="modal-body text-center">

                    <!-- ICON -->
                    <div id="petFeastModalIcon"
                         class="petfeast-modal-icon">

                        <i class="bi bi-check-circle-fill"></i>

                    </div>


                    <!-- TITLE -->
                    <h5 id="petFeastModalTitle"
                        class="petfeast-modal-title">

                        Thành công

                    </h5>


                    <!-- MESSAGE -->
                    <p id="petFeastModalMessage"
                       class="petfeast-modal-message">

                        Thao tác đã được thực hiện thành công.

                    </p>


                    <!-- BUTTONS -->
                    <div id="petFeastModalButtons"
                         class="petfeast-modal-buttons">

                        <button type="button"
                                id="petFeastModalCancel"
                                class="btn btn-outline-secondary">

                            Hủy

                        </button>


                        <button type="button"
                                id="petFeastModalConfirm"
                                class="btn btn-primary">

                            OK

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         BOOTSTRAP JS
    ========================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


    <!-- =========================================================
         GLOBAL PETFEAST MODAL
    ========================================================== -->

    <script>

        let petFeastModalInstance = null;
        let petFeastConfirmCallback = null;


        function initPetFeastModal() {

            const modalElement =
                document.getElementById("petFeastActionModal");

            if (!modalElement) {
                console.error(
                    "Không tìm thấy #petFeastActionModal"
                );
                return false;
            }


            if (!petFeastModalInstance) {

                petFeastModalInstance =
                    new bootstrap.Modal(modalElement);

            }


            const confirmButton =
                document.getElementById("petFeastModalConfirm");

            const cancelButton =
                document.getElementById("petFeastModalCancel");


            // CONFIRM BUTTON
            if (
                confirmButton &&
                !confirmButton.dataset.initialized
            ) {

                confirmButton.dataset.initialized = "true";

                confirmButton.addEventListener(
                    "click",
                    function () {

                        if (petFeastConfirmCallback) {

                            const callback =
                                petFeastConfirmCallback;

                            petFeastConfirmCallback = null;

                            petFeastModalInstance.hide();

                            callback();

                        }
                        else {

                            petFeastModalInstance.hide();

                        }

                    }
                );

            }


            // CANCEL BUTTON
            if (
                cancelButton &&
                !cancelButton.dataset.initialized
            ) {

                cancelButton.dataset.initialized = "true";

                cancelButton.addEventListener(
                    "click",
                    function () {

                        petFeastConfirmCallback = null;

                        petFeastModalInstance.hide();

                    }
                );

            }

            return true;
        }


        // =====================================================
        // SUCCESS
        // =====================================================

        function showSuccessModal(
            message,
            callback = null
        ) {

            if (!initPetFeastModal()) {
                return;
            }

            const icon =
                document.getElementById(
                    "petFeastModalIcon"
                );

            const title =
                document.getElementById(
                    "petFeastModalTitle"
                );

            const messageElement =
                document.getElementById(
                    "petFeastModalMessage"
                );

            const cancelButton =
                document.getElementById(
                    "petFeastModalCancel"
                );

            const confirmButton =
                document.getElementById(
                    "petFeastModalConfirm"
                );


            icon.innerHTML =
                '<i class="bi bi-check-circle-fill"></i>';

            icon.style.background =
                "#eaf7ee";

            icon.style.color =
                "#198754";

            title.textContent =
                "Thành công";

            messageElement.textContent =
                message;

            cancelButton.style.display =
                "none";

            confirmButton.textContent =
                "OK";

            confirmButton.className =
                "btn btn-success";

            petFeastConfirmCallback =
                callback;


            petFeastModalInstance.show();
        }


        // =====================================================
        // ERROR
        // =====================================================

        function showErrorModal(message) {

            if (!initPetFeastModal()) {
                return;
            }

            const icon =
                document.getElementById(
                    "petFeastModalIcon"
                );

            const title =
                document.getElementById(
                    "petFeastModalTitle"
                );

            const messageElement =
                document.getElementById(
                    "petFeastModalMessage"
                );

            const cancelButton =
                document.getElementById(
                    "petFeastModalCancel"
                );

            const confirmButton =
                document.getElementById(
                    "petFeastModalConfirm"
                );


            icon.innerHTML =
                '<i class="bi bi-x-circle-fill"></i>';

            icon.style.background =
                "#fdecec";

            icon.style.color =
                "#dc3545";

            title.textContent =
                "Có lỗi xảy ra";

            messageElement.textContent =
                message;

            cancelButton.style.display =
                "none";

            confirmButton.textContent =
                "OK";

            confirmButton.className =
                "btn btn-danger";

            petFeastConfirmCallback =
                null;


            petFeastModalInstance.show();
        }


        // =====================================================
        // INFO
        // =====================================================

        function showInfoModal(message) {

            if (!initPetFeastModal()) {
                return;
            }

            const icon =
                document.getElementById(
                    "petFeastModalIcon"
                );

            const title =
                document.getElementById(
                    "petFeastModalTitle"
                );

            const messageElement =
                document.getElementById(
                    "petFeastModalMessage"
                );

            const cancelButton =
                document.getElementById(
                    "petFeastModalCancel"
                );

            const confirmButton =
                document.getElementById(
                    "petFeastModalConfirm"
                );


            icon.innerHTML =
                '<i class="bi bi-info-circle-fill"></i>';

            icon.style.background =
                "#e7f3ff";

            icon.style.color =
                "#0d6efd";

            title.textContent =
                "Thông tin";

            messageElement.textContent =
                message;

            cancelButton.style.display =
                "none";

            confirmButton.textContent =
                "OK";

            confirmButton.className =
                "btn btn-primary";

            petFeastConfirmCallback =
                null;


            petFeastModalInstance.show();
        }


        // =====================================================
        // CONFIRM
        // =====================================================

        function showConfirmModal(
            message,
            callback
        ) {

            if (!initPetFeastModal()) {
                return;
            }

            const icon =
                document.getElementById(
                    "petFeastModalIcon"
                );

            const title =
                document.getElementById(
                    "petFeastModalTitle"
                );

            const messageElement =
                document.getElementById(
                    "petFeastModalMessage"
                );

            const cancelButton =
                document.getElementById(
                    "petFeastModalCancel"
                );

            const confirmButton =
                document.getElementById(
                    "petFeastModalConfirm"
                );


            icon.innerHTML =
                '<i class="bi bi-question-circle-fill"></i>';

            icon.style.background =
                "#fff4e5";

            icon.style.color =
                "#fd7e14";

            title.textContent =
                "Xác nhận";

            messageElement.textContent =
                message;

            cancelButton.style.display =
                "inline-block";

            confirmButton.textContent =
                "OK";

            confirmButton.className =
                "btn btn-primary";

            petFeastConfirmCallback =
                typeof callback === "function"
                    ? callback
                    : null;


            petFeastModalInstance.show();
        }


        // INIT
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                initPetFeastModal();

            }
        );

    </script>


    <!-- =========================================================
         ADMIN NOTIFICATIONS
    ========================================================== -->

    <script>

        async function updateAdminNotifications() {

            try {

                const response =
                    await fetch(
                        "/Admin/GetAdminNotificationCount"
                    );


                if (!response.ok) {
                    return;
                }


                const data =
                    await response.json();


                const orderBadge =
                    document.getElementById(
                        "newOrderBadge"
                    );

                const returnBadge =
                    document.getElementById(
                        "returnBadge"
                    );

                const reportBadge =
                    document.getElementById(
                        "reportBadge"
                    );


                // ĐƠN HÀNG MỚI
                if (
                    orderBadge &&
                    data.newOrderCount > 0
                ) {

                    orderBadge.textContent =
                        data.newOrderCount;

                    orderBadge.classList.remove(
                        "d-none"
                    );

                }
                else if (orderBadge) {

                    orderBadge.classList.add(
                        "d-none"
                    );

                }


                // YÊU CẦU HOÀN TRẢ
                if (
                    returnBadge &&
                    data.pendingReturnCount > 0
                ) {

                    returnBadge.textContent =
                        data.pendingReturnCount;

                    returnBadge.classList.remove(
                        "d-none"
                    );

                }
                else if (returnBadge) {

                    returnBadge.classList.add(
                        "d-none"
                    );

                }


                // TỐ CÁO ĐÁNH GIÁ
                if (
                    reportBadge &&
                    data.pendingReportCount > 0
                ) {

                    reportBadge.textContent =
                        data.pendingReportCount;

                    reportBadge.classList.remove(
                        "d-none"
                    );

                }
                else if (reportBadge) {

                    reportBadge.classList.add(
                        "d-none"
                    );

                }

            }
            catch (error) {

                console.error(
                    "Không thể cập nhật thông báo:",
                    error
                );

            }

        }


        // Cập nhật ngay khi mở trang
        updateAdminNotifications();


        // Cập nhật mỗi 10 giây
        setInterval(
            updateAdminNotifications,
            10000
        );

    </script>


    <!-- =========================================================
         BACK TO TOP
    ========================================================== -->

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const backToTop =
                    document.getElementById(
                        "backToTop"
                    );


                if (!backToTop) {
                    return;
                }


                window.addEventListener(
                    "scroll",
                    function () {

                        if (window.scrollY > 300) {

                            backToTop.classList.add(
                                "show"
                            );

                        }
                        else {

                            backToTop.classList.remove(
                                "show"
                            );

                        }

                    }
                );


                backToTop.addEventListener(
                    "click",
                    function () {

                        window.scrollTo({
                            top: 0,
                            behavior: "smooth"
                        });

                    }
                );

            }
        );

    </script>


    <!-- =========================================================
         TEMPDATA → GLOBAL MODAL
    ========================================================== -->
    @if (TempData["Success"] != null)
    {
        <script>
            window.addEventListener("load", function () {

                showSuccessModal(
                    @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
                                TempData["Success"]?.ToString()
                        )
                                )
            );

        });
    </script>
        }


    @if (TempData["Error"] != null)
    {
        <script>
            window.addEventListener("load", function () {

                showErrorModal(
                    @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
                                TempData["Error"]?.ToString()
                        )
                                )
            );

        });
    </script>
        }


    @if (TempData["Info"] != null)
    {
        <script>
            window.addEventListener("load", function () {

                showInfoModal(
                    @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
                                TempData["Info"]?.ToString()
                        )
                                )
            );

        });
    </script>
        }


    <!-- =========================================================
         VIEW-SPECIFIC SCRIPTS
    ========================================================== -->
    @await RenderSectionAsync(
    "Scripts",
        required: false
        )

</body>

</html>
<style>
    /* ========================================
           GLOBAL ADMIN
        ======================================== */

    body {
        background: #f5f8fc;
    }

    .main {
        background: #f5f8fc;
        min-height: 100vh;
    }

    .content {
        padding: 0;
    }

    /* ========================================
           NOTIFICATION BADGE
        ======================================== */

    .notification-badge {
        margin-left: auto;
        min-width: 24px;
        height: 24px;
        padding: 0 7px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #dc3545;
        color: #fff;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        line-height: 1;
        box-shadow: 0 2px 6px rgba(220, 53, 69, 0.35);
        animation: notificationPulse 2s infinite;
    }

    @@keyframes notificationPulse {
        0% {
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.4);
        }

        70% {
            box-shadow: 0 0 0 6px rgba(220, 53, 69, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0);
        }
    }

    .notification-badge.d-none {
        display: none !important;
    }

    /* ========================================
       ADMIN LIST PAGES
       Product - Category - Order
    ======================================== */

    .admin-list-page {
        padding: 30px 24px;
        background: transparent;
    }

        /* ========================================
       PAGE HEADER
    ======================================== */

        .admin-list-page .admin-page-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 24px;
            margin: 0 0 30px 0;
            padding: 0 4px;
            flex-wrap: wrap;
        }

        .admin-list-page .admin-page-title {
            margin: 0;
            color: #212529 !important;
            font-size: 28px;
            font-weight: 700;
            line-height: 1.4;
        }

        .admin-list-page .admin-page-header p {
            margin-top: 10px !important;
            margin-bottom: 0;
            color: #6c757d;
            font-size: 15px;
        }

        /* ========================================
       SEARCH
    ======================================== */

        .admin-list-page .admin-search {
            display: flex;
            align-items: stretch;
            width: 340px;
            max-width: 100%;
            margin-top: 2px;
        }

            .admin-list-page .admin-search input {
                flex: 1;
                min-width: 0;
                width: 100%;
                height: 42px;
                padding: 0 14px;
                border: 1px solid #ced4da;
                border-right: none;
                border-radius: 8px 0 0 8px;
                background: #fff;
                color: #212529;
                font-size: 14px;
                outline: none;
                transition: border-color .2s ease, box-shadow .2s ease;
            }

                .admin-list-page .admin-search input::placeholder {
                    color: #9ca3af;
                }

                .admin-list-page .admin-search input:focus {
                    border-color: #0d6efd;
                    box-shadow: 0 0 0 3px rgba(13, 110, 253, .12);
                }

            .admin-list-page .admin-search button {
                width: 48px;
                height: 42px;
                display: flex;
                align-items: center;
                justify-content: center;
                border: none;
                border-radius: 0 8px 8px 0;
                background: #0d6efd;
                color: #fff;
                cursor: pointer;
                transition: background .2s ease;
            }

                .admin-list-page .admin-search button:hover {
                    background: #0a58ca;
                }

        /* ========================================
       CARD
    ======================================== */

        .admin-list-page .admin-card {
            margin-top: 0;
            background: #fff;
            border: 1px solid #e5eaf0;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, .04);
            overflow: hidden;
        }

        .admin-list-page .admin-card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            padding: 20px 24px;
            background: #fff;
            color: #212529;
            border-bottom: 1px solid #e9ecef;
            flex-wrap: wrap;
        }

            .admin-list-page .admin-card-header h4 {
                margin: 0;
                color: #212529;
                font-size: 20px;
                font-weight: 700;
            }

                .admin-list-page .admin-card-header h4 i {
                    color: #0d6efd;
                }

        .admin-list-page .admin-card-body {
            padding: 24px;
            background: #fff;
        }

        /* ========================================
       ADD BUTTON
    ======================================== */

        .admin-list-page .admin-btn-add {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            padding: 10px 16px;
            border: none;
            border-radius: 8px;
            background: #0d6efd;
            color: #fff;
            font-weight: 600;
            text-decoration: none;
            transition: all .2s ease;
        }

            .admin-list-page .admin-btn-add:hover {
                background: #0a58ca;
                color: #fff;
                transform: translateY(-1px);
            }

        /* ========================================
       TABLE
    ======================================== */

        .admin-list-page .admin-table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        .admin-list-page .admin-table {
            min-width: 850px;
            margin-bottom: 0;
            vertical-align: middle;
        }

            .admin-list-page .admin-table thead th {
                padding: 16px 14px;
                background: #f8f9fa;
                color: #343a40;
                border-top: 1px solid #e9ecef;
                border-bottom: 1px solid #dee2e6;
                font-size: 13px;
                font-weight: 700;
                white-space: nowrap;
            }

            .admin-list-page .admin-table tbody td {
                padding: 14px;
                color: #374151;
                border-color: #edf0f2;
                font-size: 14px;
            }

            .admin-list-page .admin-table tbody tr {
                transition: background .2s ease;
            }

                .admin-list-page .admin-table tbody tr:hover {
                    background: #f8fbff;
                }

                .admin-list-page .admin-table tbody tr:last-child td {
                    border-bottom: none;
                }

        /* ========================================
       ACTION BUTTONS
    ======================================== */

        .admin-list-page .admin-action-buttons {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
        }

            .admin-list-page .admin-action-buttons .btn {
                width: 34px;
                height: 34px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0;
                border-radius: 8px;
            }

        /* ========================================
       PRODUCT IMAGE
    ======================================== */

        .admin-list-page .admin-product-image {
            width: 64px;
            height: 64px;
            object-fit: cover;
            border-radius: 10px;
            border: 1px solid #e9ecef;
            background: #fff;
        }

        /* ========================================
       STATUS BADGES
    ======================================== */

        .admin-list-page .admin-status,
        .admin-list-page .admin-status-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 7px 11px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
        }

        .admin-list-page .status-success {
            background: #dff5e8;
            color: #16804a;
        }

        .admin-list-page .status-warning {
            background: #fff3cd;
            color: #997404;
        }

        .admin-list-page .status-primary {
            background: #e5efff;
            color: #0d6efd;
        }

        .admin-list-page .status-danger {
            background: #ffe5e8;
            color: #dc3545;
        }

        .admin-list-page .status-secondary {
            background: #eef0f2;
            color: #6b7280;
        }

