<html lang="vi">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>PetFeast</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/swiper/swiper-bundle.min.css">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <link rel="icon"
          type="image/png"
          href="~/img/Logo/logo1.png">
    <link rel="stylesheet" href="~/css/site.css" />

</head>

<body>

    <!-- HEADER -->
    <header class="border-bottom bg-white">

        <div class="container">

            <div class="row header-row">

                <!-- LOGO -->
                <div class="col-lg-3">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="logo-link">

                        <img src="~/img/Logo/logo1.png"
                             alt="PetFeast Logo"
                             class="logo-img">

                    </a>

                </div>


                <!-- SEARCH -->
                <div class="col-lg-5">
                    <form asp-controller="Product"
                          asp-action="Index"
                          method="get"
                          class="w-100 header-search">
                        <div class="input-group">

                            <input type="text"
                                   name="keyword"
                                   class="form-control"
                                   placeholder="Tìm kiếm sản phẩm..." />

                            <button type="submit"
                                    class="btn btn-primary search-btn">
                                <i class="bi bi-search"></i>
                                <span>Tìm kiếm</span>
                            </button>

                        </div>

                    </form>

                </div>
                

                <!-- ACCOUNT + CART -->
                <div class="col-lg-4">

                    <ul class="navbar-nav flex-row justify-content-end align-items-center w-100">


                        <partial name="_LoginPartial"></partial>

                        <li class="nav-item ms-3">

                            <a asp-controller="ShoppingCart"
                               asp-action="Index"
                               class="cart-header">

                                <i class="bi bi-cart3"></i>

                                <span id="cartCount" class="cart-badge">
                                    @await Component.InvokeAsync("CartCount")
                                </span>

                            </a>

                        </li>


                    </ul>

                </div>


            </div>

        </div>

    </header>
    <!-- MENU -->
