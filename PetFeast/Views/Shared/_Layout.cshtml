                    <a asp-controller="Voucher"
                       asp-action="Index"
                       class="nav-link">

                        <i class="bi bi-ticket-perforated"></i>
                        Voucher

                    </a>

                </li>
                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="AboutUs">
                            <i class="bi bi-info-circle"></i>
                            Về chúng tôi

                        </a>

