        <div class="container">

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainMenu"
                    aria-controls="mainMenu"
                    aria-expanded="false"
                    aria-label="Mở menu">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse" id="mainMenu">

                <ul class="navbar-nav">

                    <!-- Trang chủ -->
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">
                            <i class="bi bi-house"></i>
                            Trang chủ
                        </a>
                    </li>

                    <!-- Sản phẩm -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle"
                           href="#"
                           role="button"
                           data-bs-toggle="dropdown">
                            <i class="bi bi-box-seam"></i>
                            Sản phẩm
                        </a>

                        <ul class="dropdown-menu">

                        <li>
                            <a class="dropdown-item"
                               asp-controller="Product"
                               asp-action="Index">

                                Tất cả sản phẩm

                            </a>
                        </li>

                        <li><hr class="dropdown-divider"></li>

                        <li>
                            <a class="dropdown-item"
                               asp-controller="Product"
                               asp-action="Index"
                               asp-route-categoryId="1">Thức ăn chó
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item"
                               asp-controller="Product"
                               asp-action="Index"
                               asp-route-categoryId="2">Thức ăn mèo
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item"
                               asp-controller="Product"
                               asp-action="Index"
                               asp-route-categoryId="3">Snack & Bánh thưởng</a>
                        </li>
                        <li>
                            <a class="dropdown-item"
                               asp-controller="Product"
                               asp-action="Index"
                               asp-route-categoryId="4">Đồ chơi</a>
                        </li>
                        <li>
                            <a class="dropdown-item"
                               asp-controller="Product"
                               asp-action="Index"
                               asp-route-categoryId="5">Phụ kiện</a>
                        </li>
                    </ul>
                </li>

                <!-- Khuyến mãi -->
                <li class="nav-item">

                    <a class="nav-link"
                       asp-controller="Home"
                       asp-action="Discount">
                        <i class="bi bi-tag"></i>
                        Khuyến mãi

                    </a>

