    <!-- ==================================================
     PETFEAST ACTION MODAL
     ================================================== -->

    <div class="modal fade"
         id="petFeastActionModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered modal-sm">

            <div class="modal-content petfeast-modal">

                <div class="modal-body text-center">

                    <div id="petFeastModalIcon"
                         class="petfeast-modal-icon">

                        <i class="bi bi-check-circle-fill"></i>

                    </div>

                    <h5 id="petFeastModalTitle"
                        class="petfeast-modal-title">

                        Thành công

                    </h5>

                    <p id="petFeastModalMessage"
                       class="petfeast-modal-message">

                        Thao tác đã được thực hiện thành công.

                    </p>

                    <div id="petFeastModalButtons"
                         class="petfeast-modal-buttons">

                        <button type="button"
                                id="petFeastModalCancel"
                                class="btn btn-outline-secondary">

                            Hủy

                        </button>

                        <button type="button"
                                id="petFeastModalConfirm"
                                class="btn btn-primary">

                            OK

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>

        let petFeastModalInstance = null;
        let petFeastConfirmCallback = null;


        // ==================================================
        // KHỞI TẠO MODAL
        // ==================================================

        function initPetFeastModal() {

            const modalElement =
                document.getElementById("petFeastActionModal");

            if (!modalElement) {
                console.error(
                    "Không tìm thấy #petFeastActionModal"
                );

                return;
            }


            // Chỉ tạo instance một lần
            if (!petFeastModalInstance) {

                petFeastModalInstance =
                    new bootstrap.Modal(modalElement);

            }


            const confirmButton =
                document.getElementById(
                    "petFeastModalConfirm"
                );


            const cancelButton =
                document.getElementById(
                    "petFeastModalCancel"
                );


            // ==================================================
            // NÚT OK
            // ==================================================

            if (
                confirmButton &&
                !confirmButton.dataset.initialized
            ) {

                confirmButton.dataset.initialized = "true";

                confirmButton.addEventListener(
                    "click",
                    function () {

                        if (petFeastConfirmCallback) {

                            const callback =
                                petFeastConfirmCallback;

                            petFeastConfirmCallback =
                                null;

                            petFeastModalInstance.hide();

                            callback();

                        }
                        else {

                            petFeastModalInstance.hide();

                        }

                    }
                );

            }


            // ==================================================
            // NÚT HỦY
            // ==================================================

            if (
                cancelButton &&
                !cancelButton.dataset.initialized
            ) {

                cancelButton.dataset.initialized = "true";

                cancelButton.addEventListener(
                    "click",
                    function () {

                        petFeastConfirmCallback =
                            null;

                        petFeastModalInstance.hide();

                    }
                );

            }

        }


        // ==================================================
        // SUCCESS
        // ==================================================

        function showSuccessModal(
            message,
            callback = null
        ) {

            initPetFeastModal();


            const icon =
                document.getElementById(
                    "petFeastModalIcon"
                );

            const title =
                document.getElementById(
                    "petFeastModalTitle"
                );

            const messageElement =
                document.getElementById(
                    "petFeastModalMessage"
                );

            const cancelButton =
                document.getElementById(
                    "petFeastModalCancel"
                );

            const confirmButton =
                document.getElementById(
                    "petFeastModalConfirm"
                );


            if (!icon ||
                !title ||
                !messageElement ||
                !confirmButton) {

                console.error(
                    "PetFeast modal chưa được cấu hình đúng."
                );

                return;

            }


            icon.innerHTML =
                '<i class="bi bi-check-circle-fill"></i>';

            icon.style.background =
                "#eaf7ee";

            icon.style.color =
                "#198754";


            title.textContent =
                "Thành công";


            messageElement.textContent =
                message;


            cancelButton.style.display =
                "none";


            confirmButton.textContent =
                "OK";


            confirmButton.className =
                "btn btn-success";


            petFeastConfirmCallback =
                callback;


            if (petFeastModalInstance) {

                petFeastModalInstance.show();

            }

        }


        // ==================================================
        // ERROR
        // ==================================================

        function showErrorModal(message) {

            initPetFeastModal();


            const icon =
                document.getElementById(
                    "petFeastModalIcon"
                );

            const title =
                document.getElementById(
                    "petFeastModalTitle"
                );

            const messageElement =
                document.getElementById(
                    "petFeastModalMessage"
                );

            const cancelButton =
                document.getElementById(
                    "petFeastModalCancel"
                );

            const confirmButton =
                document.getElementById(
                    "petFeastModalConfirm"
                );


            icon.innerHTML =
                '<i class="bi bi-x-circle-fill"></i>';

            icon.style.background =
                "#fdecec";

            icon.style.color =
                "#dc3545";


            title.textContent =
                "Có lỗi xảy ra";


            messageElement.textContent =
                message;


            cancelButton.style.display =
                "none";


            confirmButton.textContent =
                "OK";


            confirmButton.className =
                "btn btn-danger";


            petFeastConfirmCallback =
                null;


            if (petFeastModalInstance) {

                petFeastModalInstance.show();

            }

        }


        // ==================================================
        // CONFIRM
        // ==================================================

        function showConfirmModal(
            message,
            callback
        ) {

            initPetFeastModal();


            const icon =
                document.getElementById(
                    "petFeastModalIcon"
                );

            const title =
                document.getElementById(
                    "petFeastModalTitle"
                );

            const messageElement =
                document.getElementById(
                    "petFeastModalMessage"
                );

            const cancelButton =
                document.getElementById(
                    "petFeastModalCancel"
                );

            const confirmButton =
                document.getElementById(
                    "petFeastModalConfirm"
                );


            icon.innerHTML =
                '<i class="bi bi-question-circle-fill"></i>';

            icon.style.background =
                "#fff4e5";

            icon.style.color =
                "#fd7e14";


            title.textContent =
                "Xác nhận";


            messageElement.textContent =
                message;


            cancelButton.style.display =
                "inline-block";


            confirmButton.textContent =
                "OK";


            confirmButton.className =
                "btn btn-primary";


            petFeastConfirmCallback =
                callback;


            if (petFeastModalInstance) {

                petFeastModalInstance.show();

            }

        }


        // ==================================================
        // INIT
        // ==================================================

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                initPetFeastModal();

            }
        );

    </script>
    <script>
                       function scrollSlider(id, direction) {

            const slider = document.getElementById(id);

            const card = slider.querySelector('.product-item');

            if (!card) return;


            const distance = (card.offsetWidth + 20) * direction;

            const start = slider.scrollLeft;

            const end = start + distance;

            const duration = 600; // thời gian trượt (ms)

            let startTime = null;


            function animation(currentTime) {

                if (!startTime)
                    startTime = currentTime;


                const progress = Math.min(
                    (currentTime - startTime) / duration,
                    1
                );


                // easing mượt
                const ease =
                    1 - Math.pow(1 - progress, 3);


                slider.scrollLeft =
                    start + (end - start) * ease;


                if (progress < 1) {

                    requestAnimationFrame(animation);

                }

            }


            requestAnimationFrame(animation);

        }

        window.addEventListener('load', function () {

            document.querySelectorAll('.product-scroll').forEach(slider => {

                let isDown = false;
                let startX;
                let scrollLeft;

                slider.addEventListener('mousedown', e => {

                    isDown = true;
                    startX = e.pageX - slider.offsetLeft;
                    scrollLeft = slider.scrollLeft;

                });

                slider.addEventListener('mouseleave', () => isDown = false);
                slider.addEventListener('mouseup', () => isDown = false);

                slider.addEventListener('mousemove', e => {

                    if (!isDown) return;

                    e.preventDefault();

                    const x = e.pageX - slider.offsetLeft;
                    const walk = (x - startX) * 2;

                    slider.scrollLeft = scrollLeft - walk;

                });

            });

        });
        //Back to top
                document.addEventListener("DOMContentLoaded", function () {

            const backToTop = document.getElementById("backToTop");

            if (!backToTop) return;

            // Hiển thị / ẩn nút khi cuộn
            window.addEventListener("scroll", function () {

                if (window.scrollY > 300) {
                    backToTop.classList.add("show");
                } else {
                    backToTop.classList.remove("show");
                }

            });

            // Cuộn về đầu trang
            backToTop.addEventListener("click", function () {

                window.scrollTo({
                    top: 0,
                    behavior: "smooth"
                });

            });

        });
    </script>

    @await RenderSectionAsync("Scripts", false)
    <script>
        function updateNotificationBadge(unreadCount) {

            const notificationLink =
                document.querySelector(".header-notification");

            if (!notificationLink) {
                return;
            }

            let notificationBadge =
                notificationLink.querySelector(".notification-count");

            // Nếu chưa có badge thì tạo
            if (!notificationBadge) {

                notificationBadge =
                    document.createElement("span");

                notificationBadge.className =
                    "notification-count";

                notificationLink.appendChild(
                    notificationBadge
                );
            }

            // Cập nhật số
            notificationBadge.dataset.count =
                unreadCount;

            notificationBadge.textContent =
                unreadCount > 99
                    ? "99+"
                    : unreadCount;
        }
    </script>

</body>
