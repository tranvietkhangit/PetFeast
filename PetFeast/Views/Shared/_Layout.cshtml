                            </li>

                            <li>
                                <a asp-controller="Support"
                                   asp-action="ChinhSachDoiTra">
                                    Chính sách đổi trả
                                </a>
                            </li>

                        </ul>

                    </div>

                    <div class="col-lg-3 col-md-6 mb-4">

                        <h5>Chính sách</h5>

                        <ul class="footer-links">

                            <li>
                                <a asp-controller="Support"
                                   asp-action="DieuKhoanSuDung">
                                    Điều khoản sử dụng
                                </a>
                            </li>

                            <li>
                                <a asp-controller="Support"
                                   asp-action="BaoMatThongTin">
                                    Bảo mật thông tin
                                </a>
                            </li>

                            <li>
                                <a asp-controller="Home"
                                   asp-action="Contact">
                                    Liên hệ
                                </a>
                            </li>

