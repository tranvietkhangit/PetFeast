@model IEnumerable<PetFeast.Models.Products.Product>
@using PetFeast.Models.ViewModels
@{
    var sliderId = "slider_" + Guid.NewGuid().ToString("N");

    var favoriteProductIds =
        ViewBag.FavoriteProductIds
        as HashSet<int>
        ?? new HashSet<int>();

    var productRatings =
        ViewBag.ProductRatings
        as Dictionary<int, ProductRatingViewModel>
        ?? new Dictionary<int, ProductRatingViewModel>();
}

<div class="product-slider-wrapper">

    <!-- PREVIOUS -->
    <button type="button"
            class="btn btn-primary slider-btn slider-prev"
            onclick="scrollSlider('@sliderId', -1)">
        ❮
    </button>


    <!-- PRODUCT LIST -->
    <div class="product-scroll" id="@sliderId">

        @foreach (var item in Model)
        {
            bool isFavorite =
            favoriteProductIds.Contains(item.ProductId);

            bool isOutOfStock =
            item.Quantity <= 0;

            ProductRatingViewModel? rating = null;

            productRatings.TryGetValue(
            item.ProductId,
            out rating);

            <div class="product-item">

                <div class="card product-card @(isOutOfStock ? "out-of-stock" : "")">

                    <!-- PRODUCT IMAGE -->
                    <div class="product-image-wrapper">

                        @if (isOutOfStock)
                        {
                            <span class="out-of-stock-badge">
                                <i class="bi bi-x-circle me-1"></i>
                                Hết hàng
                            </span>
                        }

                        @if (item.DiscountPercent > 0 && !isOutOfStock)
                        {
                            <span class="discount-badge">
                                -@item.DiscountPercent%
                            </span>
                        }

                        <a asp-controller="Product"
                           asp-action="Detail"
                           asp-route-id="@item.ProductId">

                            <img src="@item.ImageUrl"
                                 class="product-image"
                                 alt="@item.ProductName" />

                        </a>


                        <!-- FAVORITE -->
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form class="favorite-form"
                                  data-product-id="@item.ProductId">

                                @Html.AntiForgeryToken()

                                <button type="button"
                                        class="favorite-btn @(isFavorite ? "active" : "")"
                                        title="@(isFavorite ? "Bỏ yêu thích" : "Thêm vào yêu thích")">

                                    <i class="bi @(isFavorite ? "bi-heart-fill" : "bi-heart")"></i>

                                </button>

                            </form>
                        }
                        else
                        {
                            <div class="favorite-form">

                                <a asp-area="Identity"
                                   asp-page="/Account/Login"
                                   asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString"
                                   class="favorite-btn"
                                   title="Đăng nhập để thêm yêu thích">

                                    <i class="bi bi-heart"></i>

                                </a>

                            </div>
                        }

                    </div>


                    <!-- PRODUCT BODY -->
                    <div class="card-body">

                        <h6 class="product-name">
                            @item.ProductName
                        </h6>


                        <!-- RATING -->
                        <div class="product-rating">

                            @if (rating != null && rating.ReviewCount > 0)
                            {
                                <span class="rating-stars">

                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (rating.AverageRating >= i)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else if (rating.AverageRating >= i - 0.5)
                                        {
                                            <i class="bi bi-star-half"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star"></i>
                                        }
                                    }

                                </span>

                                <span class="rating-score">
                                    @rating.AverageRating.ToString("0.0")
                                </span>

                                <span class="rating-divider">
                                    ·
                                </span>

                                <span class="rating-count">
                                    @rating.ReviewCount đánh giá
                                </span>
                            }
                            else
                            {
                                <span class="rating-stars">
                                    <i class="bi bi-star"></i>
                                    <i class="bi bi-star"></i>
                                    <i class="bi bi-star"></i>
                                    <i class="bi bi-star"></i>
                                    <i class="bi bi-star"></i>
                                </span>

                                <span class="rating-count">
                                    Chưa có đánh giá
                                </span>
                            }

                        </div>


                        <!-- PRICE -->
                        @if (item.DiscountPercent > 0)
                        {
                            <div class="product-price-box">

                                <div class="price-old">
                                    @item.Price.ToString("N0") đ
                                </div>

                                <div class="price-new">
                                    @item.DiscountPrice.ToString("N0") đ
                                </div>

                                <div class="price-saving">

                                    <i class="bi bi-tag-fill me-1"></i>

                                    Tiết kiệm
                                    @((item.Price - item.DiscountPrice).ToString("N0")) đ

                                </div>

                            </div>
                        }
                        else
                        {
                            <div class="product-price-box">

                                <div class="price-normal">
                                    @item.Price.ToString("N0") đ
                                </div>
                            </div>
                        }

                    </div>


                    <!-- ADD TO CART -->
                    <div class="card-footer bg-white border-0">

                        @if (isOutOfStock)
                        {
                            <button type="button"
                                    class="btn btn-secondary w-100 add-to-cart-btn"
                                    disabled>

                                <i class="bi bi-x-circle me-1"></i>

                                <span>Hết hàng</span>

                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-primary w-100 add-to-cart-btn"
                                    data-product-id="@item.ProductId">

                                <i class="bi bi-cart-plus"></i>

                                <span>Thêm vào giỏ hàng</span>

                            </button>
                        }

                    </div>

                </div>

            </div>
        }

    </div>


    <!-- NEXT -->
    <button type="button"
            class="btn btn-primary slider-btn slider-next"
            onclick="scrollSlider('@sliderId', 1)">
        ❯
    </button>

</div>


<!-- ==================================================
     CSS
================================================== -->

<style>
    /* =========================
       PRODUCT CARD
    ========================= */

    .product-card {
        overflow: hidden;
        border-radius: 12px;
    }


    /* =========================
       PRODUCT IMAGE
    ========================= */

    .product-image-wrapper {
        position: relative;
    }

    .product-image {
        width: 100%;
        height: 250px;
        object-fit: cover;
        display: block;
    }


    
    /* =========================
       PRODUCT RATING
    ========================= */

    .product-rating {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        min-height: 24px;
        margin-bottom: 7px;
        font-size: 13px;
    }

    .rating-stars {
        display: inline-flex;
        align-items: center;
        gap: 1px;
    }

        .rating-stars i {
            color: #ffc107;
            font-size: 14px;
            line-height: 1;
        }

    .rating-score {
        color: #343a40;
        font-weight: 600;
    }

    .rating-divider {
        color: #adb5bd;
        margin: 0 1px;
    }

    .rating-count {
        color: #6c757d;
    }


    /* =========================
       PRICE
    ========================= */

    .product-price-box {
        min-height: 72px;
        margin-bottom: 8px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
    }


    /* OLD PRICE */

    .price-old {
        font-size: 16px;
        color: #888;
        text-decoration: line-through;
        line-height: 21px;
    }


    /* NEW PRICE */

    .price-new {
        font-size: 23px;
        font-weight: 700;
        color: #dc3545;
        line-height: 29px;
    }


    /* SAVING */

    .price-saving {
        font-size: 14px;
        font-weight: 700;
        color: #198754;
        line-height: 20px;
    }


    /* NORMAL PRICE */

    .price-normal {
        font-size: 23px;
        font-weight: 700;
        color: #0d6efd;
        line-height: 29px;
    }


    /* =========================
       CARD BODY
    ========================= */

    .product-card .card-body {
        padding: 12px 14px 8px;
    }

    .product-name {
        text-align: center;
        font-weight: 600;
        line-height: 1.4;
        min-height: 45px;
        margin-bottom: 8px;
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        overflow: hidden;
    }

    /* =========================
       CARD FOOTER
    ========================= */

    .product-card .card-footer {
        padding: 8px 14px 14px;
    }


    /* =========================
       ADD TO CART
    ========================= */

    .add-to-cart-btn {
        height: 44px;
        font-size: 16px;
        font-weight: 600;
    }

        .add-to-cart-btn:hover {
            transform: translateY(-2px);
        }

        .add-to-cart-btn:disabled {
            cursor: not-allowed;
            opacity: 0.7;
        }


    /* =========================
       OUT OF STOCK
    ========================= */

    .product-card.out-of-stock .product-image {
        opacity: 0.6;
    }

    .out-of-stock-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        z-index: 25;
        display: inline-flex;
        align-items: center;
        padding: 7px 12px;
        background: #6c757d;
        color: #fff;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 700;
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.15);
    }


    /* =========================
       DISCOUNT
    ========================= */

    .discount-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        z-index: 15;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 54px;
        height: 28px;
        padding: 0 10px;
        background: #dc3545;
        color: #fff;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 700;
        box-shadow: 0 3px 8px rgba(220, 53, 69, 0.22);
    }

    /* ========================================
       FAVORITE
    ======================================== */

    .favorite-form {
        position: absolute;
        top: 12px;
        right: 12px;
        z-index: 20;
        margin: 0;
    }

    .favorite-btn {
        width: 44px;
        height: 44px;
        padding: 0;
        border: 1px solid #dee2e6;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.96);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        text-decoration: none;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.10);
        transition: transform 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
    }

        .favorite-btn i {
            font-size: 20px;
            color: #495057;
            transition: color 0.2s ease, transform 0.2s ease;
        }


        /* Hover */

        .favorite-btn:hover {
            transform: translateY(-2px);
            border-color: #dc3545;
            background: #fff5f5;
        }

            .favorite-btn:hover i {
                color: #dc3545;
                transform: scale(1.08);
            }


        /* Đã yêu thích */

        .favorite-btn.active {
            border-color: #dc3545;
            background: #fff1f2;
        }

            .favorite-btn.active i {
                color: #dc3545;
            }


        /* Click */

        .favorite-btn:active {
            transform: scale(0.95);
        }

   
    /* ========================================
       PRODUCT RATING
    ======================================== */

    .product-rating {
        display: flex;
        align-items: center;
        gap: 5px;
        min-height: 24px;
        margin-bottom: 7px;
        font-size: 13px;
    }


    /* STAR */

    .rating-stars {
        display: inline-flex;
        align-items: center;
        gap: 1px;
    }

        .rating-stars i {
            color: #ffc107;
            font-size: 14px;
            line-height: 1;
        }


    /* SCORE */

    .rating-score {
        color: #343a40;
        font-weight: 600;
    }


    /* DIVIDER */

    .rating-divider {
        color: #adb5bd;
        margin: 0 1px;
    }


    /* COUNT */

    .rating-count {
        color: #6c757d;
    }
    /* ========================================
       MOBILE
    ======================================== */

    @@media (max-width: 768px) {
        .product-item

    {
        padding: 6px;
    }

    .product-image-wrapper {
        height: 220px;
    }

    .product-card .card-body {
        padding: 13px 12px;
    }

    .product-name {
        font-size: 15px;
    }

    .price-new,
    .price-normal {
        font-size: 19px;
    }

    .favorite-btn {
        width: 40px;
        height: 40px;
    }

        .favorite-btn i {
            font-size: 18px;
        }

    }
</style>


<!-- ==================================================
     FAVORITE JS
================================================== -->

<script>

    document
        .querySelectorAll(".favorite-form")
        .forEach(function (form) {

            const button =
                form.querySelector(".favorite-btn");

            // Login link
            if (!button || !form.dataset.productId) {
                return;
            }

            const icon =
                button.querySelector("i");

            const productId =
                form.dataset.productId;

            const token =
                form.querySelector(
                    'input[name="__RequestVerificationToken"]'
                )?.value;


            button.addEventListener(
                "click",
                async function () {

                    if (button.disabled) {
                        return;
                    }

                    button.disabled = true;

                    try {

                        const formData =
                            new FormData();

                        formData.append(
                            "productId",
                            productId
                        );

                        formData.append(
                            "__RequestVerificationToken",
                            token
                        );


                        const response =
                            await fetch(
                                "/Favorite/ToggleAjax",
                                {
                                    method: "POST",
                                    body: formData,
                                    headers: {
                                        "X-Requested-With":
                                            "XMLHttpRequest"
                                    }
                                }
                            );


                        const data =
                            await response.json();


                        if (data.requireLogin) {

                            window.location.href =
                                "/Identity/Account/Login?returnUrl="
                                + encodeURIComponent(
                                    window.location.pathname +
                                    window.location.search
                                );

                            return;
                        }


                        if (!data.success) {

                            throw new Error(
                                "Không thể cập nhật yêu thích."
                            );

                        }


                        if (data.isFavorite) {

                            button.classList.add("active");

                            icon.classList.remove("bi-heart");

                            icon.classList.add("bi-heart-fill");

                            button.title =
                                "Bỏ yêu thích";

                        }
                        else {

                            button.classList.remove("active");

                            icon.classList.remove("bi-heart-fill");

                            icon.classList.add("bi-heart");

                            button.title =
                                "Thêm vào yêu thích";

                        }

                    }
                    catch (error) {

                        console.error(
                            "Favorite error:",
                            error
                        );

                        showErrorModal(
                            "Có lỗi xảy ra khi cập nhật yêu thích."
                        );

                    }
                    finally {

                        button.disabled = false;

                    }

                }
            );

        });

</script>


<!-- ==================================================
     ADD TO CART JS
================================================== -->

<script>

    document
        .querySelectorAll(".add-to-cart-btn:not(:disabled)")
        .forEach(function (button) {

            button.addEventListener(
                "click",
                async function () {

                    if (button.disabled) {
                        return;
                    }

                    const productId =
                        button.dataset.productId;

                    // Không có productId
                    if (!productId) {
                        return;
                    }

                    const originalHTML =
                        button.innerHTML;

                    button.disabled = true;


                    // ĐANG THÊM
                    button.innerHTML = `
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        Đang thêm...
                    `;


                    try {

                        const response =
                            await fetch(
                                "/ShoppingCart/AddToCartAjax",
                                {
                                    method: "POST",

                                    headers: {
                                        "Content-Type":
                                            "application/x-www-form-urlencoded; charset=UTF-8",

                                        "X-Requested-With":
                                            "XMLHttpRequest"
                                    },

                                    body:
                                        `productId=${encodeURIComponent(productId)}&quantity=1`
                                }
                            );


                        if (!response.ok) {

                            throw new Error(
                                "HTTP error " +
                                response.status
                            );

                        }


                        const data =
                            await response.json();


                        // ==============================
                        // CHƯA ĐĂNG NHẬP
                        // ==============================

                        if (data.requireLogin) {

                            const currentUrl =
                                window.location.pathname +
                                window.location.search;

                            window.location.href =
                                "/Identity/Account/Login?returnUrl=" +
                                encodeURIComponent(currentUrl);

                            return;
                        }


                        // ==============================
                        // THÀNH CÔNG
                        // ==============================

                        if (data.success) {

                            const cartCount =
                                document.getElementById(
                                    "cartCount"
                                );


                            if (cartCount) {

                                cartCount.textContent =
                                    data.cartCount;

                            }


                            button.classList.remove(
                                "btn-primary"
                            );

                            button.classList.add(
                                "btn-success"
                            );


                            button.innerHTML = `
                                <i class="bi bi-check-circle-fill"></i>
                                <span>Đã thêm</span>
                            `;


                            setTimeout(function () {

                                button.classList.remove(
                                    "btn-success"
                                );

                                button.classList.add(
                                    "btn-primary"
                                );

                                button.innerHTML =
                                    originalHTML;

                                button.disabled =
                                    false;

                            }, 1500);

                            return;
                        }


                        // ==============================
                        // HẾT HÀNG / KHÔNG ĐỦ STOCK
                        // ==============================

                        showErrorModal(
                            data.message ||
                            "Không thể thêm sản phẩm vào giỏ hàng."
                        );


                        button.innerHTML =
                            originalHTML;

                        button.disabled =
                            false;

                    }
                    catch (error) {

                        console.error(
                            "Add to cart error:",
                            error
                        );

                        showErrorModal(
                            "Có lỗi xảy ra khi thêm sản phẩm vào giỏ hàng."
                        );

                        button.innerHTML =
                            originalHTML;

                        button.disabled =
                            false;

                    }

                }
            );

        });

</script>