@model IEnumerable<PetFeast.Models.Products.Product>

@{
    var sliderId = "slider_" + Guid.NewGuid().ToString("N");

    var favoriteProductIds =
        ViewBag.FavoriteProductIds
        as HashSet<int>
        ?? new HashSet<int>();
}

<div class="product-slider-wrapper">

    <!-- PREVIOUS -->
    <button type="button"
            class="btn btn-primary slider-btn slider-prev"
            onclick="scrollSlider('@sliderId', -1)">
        ❮
    </button>


    <!-- PRODUCT LIST -->
    <div class="product-scroll" id="@sliderId">

        @foreach (var item in Model)
        {
            bool isFavorite =
            favoriteProductIds.Contains(item.ProductId);

            bool isOutOfStock =
            item.Quantity <= 0;

            <div class="product-item">

                <div class="card h-100 shadow-sm product-card @(isOutOfStock ? "out-of-stock" : "")">

                    <!-- ==============================
                         IMAGE
                    =============================== -->

                    <div class="product-image-wrapper">

                        <!-- OUT OF STOCK -->
                        @if (isOutOfStock)
                        {
                            <span class="out-of-stock-badge">
                                <i class="bi bi-x-circle me-1"></i>
                                Hết hàng
                            </span>
                        }

                        <!-- IMAGE -->
                        <a asp-controller="Product"
                           asp-action="Detail"
                           asp-route-id="@item.ProductId"
                           class="product-image-link">

                            <img src="@item.ImageUrl"
                                 class="card-img-top"
                                 style="height:250px; object-fit:cover;"
                                 alt="@item.ProductName">

                        </a>


                        <!-- DISCOUNT -->
                        @if (item.DiscountPercent > 0)
                        {
                            <span class="discount-badge">
                                -@item.DiscountPercent%
                            </span>
                        }


                        <!-- FAVORITE -->
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form class="favorite-form"
                                  data-product-id="@item.ProductId">

                                @Html.AntiForgeryToken()

                                <button type="button"
                                        class="favorite-btn @(isFavorite ? "active" : "")"
                                        title="@(isFavorite ? "Bỏ yêu thích" : "Thêm vào yêu thích")">

                                    <i class="bi @(isFavorite ? "bi-heart-fill" : "bi-heart")"></i>

                                </button>

                            </form>
                        }
                        else
                        {
                            <div class="favorite-form">

                                <a asp-area="Identity"
                                   asp-page="/Account/Login"
                                   asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString"
                                   class="favorite-btn"
                                   title="Đăng nhập để thêm yêu thích">

                                    <i class="bi bi-heart"></i>

                                </a>

                            </div>
                        }

                    </div>


                    <!-- ==============================
                         PRODUCT INFO
                    =============================== -->

                    <div class="card-body text-center">

                        <h6 class="product-name">
                            @item.ProductName
                        </h6>


                        <!-- PRICE -->
                        <div class="product-price-box">

                            @if (item.DiscountPercent > 0)
                            {
                                <div class="price-old">
                                    @item.Price.ToString("N0") đ
                                </div>

                                <div class="price-new">
                                    @item.DiscountPrice.ToString("N0") đ
                                </div>

                                <div class="price-saving">
                                    <i class="bi bi-tag-fill me-1"></i>
                                    Tiết kiệm
                                    @((item.Price - item.DiscountPrice).ToString("N0")) đ
                                </div>
                            }
                            else
                            {
                                <div class="price-normal">
                                    @item.Price.ToString("N0") đ
                                </div>
                            }

                        </div>


                        <!-- ==============================
                             ADD TO CART
                        =============================== -->
                        @if (!isOutOfStock)
                        {
                            <button type="button"
                                    class="btn btn-primary w-100 add-to-cart-btn"
                                    data-product-id="@item.ProductId">

                                <i class="bi bi-cart-plus"></i>

                                <span>Thêm vào giỏ</span>

                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-secondary w-100 add-to-cart-btn"
                                    disabled>

                                <i class="bi bi-x-circle me-1"></i>

                                <span>Hết hàng</span>

                            </button>
                        }

                    </div>

                </div>

            </div>
        }

    </div>


    <!-- NEXT -->
    <button type="button"
            class="btn btn-primary slider-btn slider-next"
            onclick="scrollSlider('@sliderId', 1)">
        ❯
    </button>

</div>


<!-- ==================================================
     CSS
================================================== -->

<style>

    /* ========================================
           PRODUCT IMAGE
        ======================================== */

    .product-image-wrapper {
        position: relative;
    }


    /* ========================================
           OUT OF STOCK
        ======================================== */

    .product-card.out-of-stock
    .product-image-wrapper img {
        opacity: 0.6;
    }


    .out-of-stock-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        z-index: 25;
        display: inline-flex;
        align-items: center;
        padding: 7px 12px;
        background: #6c757d;
        color: #fff;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 700;
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.15);
    }


    /* ========================================
           FAVORITE
        ======================================== */

    .favorite-form {
        position: absolute;
        top: 12px;
        right: 12px;
        z-index: 20;
        margin: 0;
    }


    .favorite-btn {
        width: 50px;
        height: 50px;
        padding: 0;
        border-radius: 50%;
        border: 2px solid #222;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        text-decoration: none;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.15);
        transition: border-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
    }


        .favorite-btn i {
            font-size: 24px;
            color: #222;
            transition: color 0.25s ease;
        }


        /* ACTIVE */

        .favorite-btn.active {
            border-color: #ff416c;
        }


            .favorite-btn.active i {
                color: #ff416c;
            }


        /* HOVER */

        .favorite-btn:hover {
            transform: translateY(-2px);
        }


        /* KHÔNG SCALE KHI CLICK */

        .favorite-btn:active {
            transform: translateY(-2px);
        }


    /* ========================================
           ADD TO CART
        ======================================== */

    .add-to-cart-btn {
        height: 44px;
        font-size: 16px;
        font-weight: 600;
        transition: background-color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
    }


        .add-to-cart-btn:hover:not(:disabled) {
            transform: translateY(-2px);
        }


        .add-to-cart-btn:disabled {
            cursor: not-allowed;
            opacity: 0.7;
        }


    /* ========================================
           DISCOUNT BADGE
        ======================================== */

    .discount-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        z-index: 15;
        background: #dc3545;
        color: #fff;
        padding: 6px 10px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 700;
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.15);
    }


    /* ========================================
           PRODUCT NAME
        ======================================== */

    .product-name {
        height: 30px;
        margin-bottom: 8px;
        font-size: 18px;
        font-weight: 700;
        line-height: 30px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }


    /* ========================================
           PRODUCT PRICE
        ======================================== */

    .product-price-box {
        min-height: 72px;
        margin-bottom: 8px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }


    .price-old {
        font-size: 16px;
        color: #888;
        text-decoration: line-through;
        line-height: 21px;
    }


    .price-new {
        font-size: 23px;
        font-weight: 700;
        color: #dc3545;
        line-height: 29px;
    }


    .price-saving {
        font-size: 14px;
        font-weight: 700;
        color: #198754;
        line-height: 20px;
    }


    .price-normal {
        font-size: 23px;
        font-weight: 700;
        color: #0d6efd;
        line-height: 29px;
    }


    /* ========================================
           CARD BODY
        ======================================== */

    .product-card .card-body {
        padding: 12px 14px 8px;
    }

</style>


<!-- ==================================================
     FAVORITE JS
================================================== -->

<script>

    document
        .querySelectorAll(".favorite-form")
        .forEach(function (form) {

            const button =
                form.querySelector(".favorite-btn");

            // Login link
            if (!button || !form.dataset.productId) {
                return;
            }

            const icon =
                button.querySelector("i");

            const productId =
                form.dataset.productId;

            const token =
                form.querySelector(
                    'input[name="__RequestVerificationToken"]'
                )?.value;


            button.addEventListener(
                "click",
                async function () {

                    if (button.disabled) {
                        return;
                    }

                    button.disabled = true;

                    try {

                        const formData =
                            new FormData();

                        formData.append(
                            "productId",
                            productId
                        );

                        formData.append(
                            "__RequestVerificationToken",
                            token
                        );


                        const response =
                            await fetch(
                                "/Favorite/ToggleAjax",
                                {
                                    method: "POST",
                                    body: formData,
                                    headers: {
                                        "X-Requested-With":
                                            "XMLHttpRequest"
                                    }
                                }
                            );


                        const data =
                            await response.json();


                        if (data.requireLogin) {

                            window.location.href =
                                "/Identity/Account/Login?returnUrl="
                                + encodeURIComponent(
                                    window.location.pathname +
                                    window.location.search
                                );

                            return;
                        }


                        if (!data.success) {

                            throw new Error(
                                "Không thể cập nhật yêu thích."
                            );

                        }


                        if (data.isFavorite) {

                            button.classList.add("active");

                            icon.classList.remove("bi-heart");

                            icon.classList.add("bi-heart-fill");

                            button.title =
                                "Bỏ yêu thích";

                        }
                        else {

                            button.classList.remove("active");

                            icon.classList.remove("bi-heart-fill");

                            icon.classList.add("bi-heart");

                            button.title =
                                "Thêm vào yêu thích";

                        }

                    }
                    catch (error) {

                        console.error(
                            "Favorite error:",
                            error
                        );

                        alert(
                            "Có lỗi xảy ra khi cập nhật yêu thích."
                        );

                    }
                    finally {

                        button.disabled = false;

                    }

                }
            );

        });

</script>


<!-- ==================================================
     ADD TO CART JS
================================================== -->

<script>

    document
        .querySelectorAll(".add-to-cart-btn:not(:disabled)")
        .forEach(function (button) {

            button.addEventListener(
                "click",
                async function () {

                    if (button.disabled) {
                        return;
                    }

                    const productId =
                        button.dataset.productId;

                    // Không có productId
                    if (!productId) {
                        return;
                    }

                    const originalHTML =
                        button.innerHTML;

                    button.disabled = true;


                    // ĐANG THÊM
                    button.innerHTML = `
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        Đang thêm...
                    `;


                    try {

                        const response =
                            await fetch(
                                "/ShoppingCart/AddToCartAjax",
                                {
                                    method: "POST",

                                    headers: {
                                        "Content-Type":
                                            "application/x-www-form-urlencoded; charset=UTF-8",

                                        "X-Requested-With":
                                            "XMLHttpRequest"
                                    },

                                    body:
                                        `productId=${encodeURIComponent(productId)}&quantity=1`
                                }
                            );


                        if (!response.ok) {

                            throw new Error(
                                "HTTP error " +
                                response.status
                            );

                        }


                        const data =
                            await response.json();


                        // ==============================
                        // CHƯA ĐĂNG NHẬP
                        // ==============================

                        if (data.requireLogin) {

                            const currentUrl =
                                window.location.pathname +
                                window.location.search;

                            window.location.href =
                                "/Identity/Account/Login?returnUrl=" +
                                encodeURIComponent(currentUrl);

                            return;
                        }


                        // ==============================
                        // THÀNH CÔNG
                        // ==============================

                        if (data.success) {

                            const cartCount =
                                document.getElementById(
                                    "cartCount"
                                );


                            if (cartCount) {

                                cartCount.textContent =
                                    data.cartCount;

                            }


                            button.classList.remove(
                                "btn-primary"
                            );

                            button.classList.add(
                                "btn-success"
                            );


                            button.innerHTML = `
                                <i class="bi bi-check-circle-fill"></i>
                                <span>Đã thêm</span>
                            `;


                            setTimeout(function () {

                                button.classList.remove(
                                    "btn-success"
                                );

                                button.classList.add(
                                    "btn-primary"
                                );

                                button.innerHTML =
                                    originalHTML;

                                button.disabled =
                                    false;

                            }, 1500);

                            return;
                        }


                        // ==============================
                        // HẾT HÀNG / KHÔNG ĐỦ STOCK
                        // ==============================

                        alert(
                            data.message ||
                            "Không thể thêm sản phẩm vào giỏ hàng."
                        );


                        button.innerHTML =
                            originalHTML;

                        button.disabled =
                            false;

                    }
                    catch (error) {

                        console.error(
                            "Add to cart error:",
                            error
                        );

                        alert(
                            "Có lỗi xảy ra khi thêm sản phẩm vào giỏ hàng."
                        );

                        button.innerHTML =
                            originalHTML;

                        button.disabled =
                            false;

                    }

                }
            );

        });

</script>