                            <div class="input-group">

                                <input type="number"
       id="maxPriceInput"
       name="maxPrice"
       class="form-control"
       min="0"
       max="@maxDiscountPrice"
       step="1"
       value="@maxPrice" />

                                <span class="input-group-text">
                                    đ
                                </span>

                            </div>

                        </div>


                        <!-- SLIDER -->

