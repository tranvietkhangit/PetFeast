                                @maxPrice.ToString("N0") đ
                            </span>

                        </div>


                        <!-- SORT -->

                        <input type="hidden"
                               name="sortOrder"
                               value="@sortOrder" />
                               <input type="hidden"
       name="minRating"
       value="@(selectedMinRating?.ToString() ?? "")" />


                        <!-- BUTTON -->

                        <button type="submit"
                                class="btn btn-primary w-100 mt-3">

                            <i class="bi bi-funnel-fill me-1"></i>

                            Lọc sản phẩm

