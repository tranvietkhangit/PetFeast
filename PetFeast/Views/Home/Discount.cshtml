<!-- =========================================================
     PRICE SLIDER
========================================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

    const minRange =
        document.getElementById("minPriceRange");

    const maxRange =
        document.getElementById("maxPriceRange");

    const minInput =
        document.getElementById("minPriceInput");

    const maxInput =
        document.getElementById("maxPriceInput");

    const minLabel =
        document.getElementById("minPriceLabel");

    const maxLabel =
        document.getElementById("maxPriceLabel");

    const track =
        document.querySelector(".price-slider-track");


    if (!minRange ||
        !maxRange ||
        !minInput ||
        !maxInput ||
        !minLabel ||
        !maxLabel ||
        !track) {

        return;
    }


    // LẤY GIÁ CAO NHẤT TRỰC TIẾP TỪ SLIDER
    const maxDiscountPrice =
        Number(maxRange.max);


    function formatPrice(value) {

        return Number(value)
            .toLocaleString("vi-VN") + " đ";

    }


    function updateTrack() {

        const minValue =
            Number(minRange.value);

        const maxValue =
            Number(maxRange.value);


        const minPercent =
            maxDiscountPrice > 0
                ? (minValue / maxDiscountPrice) * 100
                : 0;

        const maxPercent =
            maxDiscountPrice > 0
                ? (maxValue / maxDiscountPrice) * 100
                : 100;


        track.style.background =
            `linear-gradient(
                to right,
                #dbeafe 0%,
                #dbeafe ${minPercent}%,
                #0d6efd ${minPercent}%,
                #0d6efd ${maxPercent}%,
                #dbeafe ${maxPercent}%,
                #dbeafe 100%
            )`;

    }


    // =========================
    // SLIDER MIN
    // =========================

    minRange.addEventListener(
        "input",
        function () {

            let value =
                Number(this.value);

            let maxValue =
                Number(maxRange.value);


            if (value > maxValue) {

                value = maxValue;

                this.value = value;

            }


            minInput.value = value;

            minLabel.textContent =
                formatPrice(value);

            updateTrack();

        }
    );


    // =========================
    // SLIDER MAX
    // =========================

    maxRange.addEventListener(
        "input",
        function () {

            let value =
                Number(this.value);

            let minValue =
                Number(minRange.value);


            if (value < minValue) {

                value = minValue;

                this.value = value;

            }


            maxInput.value = value;

            maxLabel.textContent =
                formatPrice(value);

            updateTrack();

        }
    );


    // =========================
    // INPUT MIN
    // =========================

    minInput.addEventListener(
        "change",
        function () {

            let value =
                Number(this.value);


            if (isNaN(value))
                value = 0;


            value = Math.max(
                0,
                Math.min(
                    maxDiscountPrice,
                    value
                )
            );


            let maxValue =
                Number(maxInput.value);


            if (isNaN(maxValue))
                maxValue = maxDiscountPrice;


            if (value > maxValue)
                value = maxValue;


            this.value = value;

            minRange.value = value;

            minLabel.textContent =
                formatPrice(value);

            updateTrack();

        }
    );


    // =========================
    // INPUT MAX
    // =========================

    maxInput.addEventListener(
        "change",
        function () {

            let value =
                Number(this.value);


            if (isNaN(value))
                value = maxDiscountPrice;


            value = Math.max(
                0,
                Math.min(
                    maxDiscountPrice,
                    value
                )
            );


            let minValue =
                Number(minInput.value);


            if (isNaN(minValue))
                minValue = 0;


            if (value < minValue)
                value = minValue;


            this.value = value;

            maxRange.value = value;

            maxLabel.textContent =
                formatPrice(value);

            updateTrack();

        }
    );


    // =========================
    // KHỞI TẠO
    // =========================

    minLabel.textContent =
        formatPrice(minRange.value);

    maxLabel.textContent =
        formatPrice(maxRange.value);

    updateTrack();
    });

</script>


<!-- =========================================================
     FAVORITE AJAX
========================================================= -->

<script>

    document.querySelectorAll(".favorite-form")
        .forEach(function (form) {

            const button =
                form.querySelector(".favorite-btn");

            if (!button)
                return;

            const icon =
                button.querySelector("i");

            if (!icon)
                return;

            const productId =
                form.dataset.productId;

            const token =
                form.querySelector(
                    'input[name="__RequestVerificationToken"]'
                )?.value;


            button.addEventListener(
                "click",
                async function () {

                    if (button.disabled)
                        return;

                    button.disabled = true;


                    try {

                        const formData =
                            new FormData();


                        formData.append(
                            "productId",
                            productId
                        );


                        if (token) {

                            formData.append(
                                "__RequestVerificationToken",
                                token
                            );

                        }


                        const response =
                            await fetch(
                                "/Favorite/ToggleAjax",
                                {
                                    method: "POST",
                                    body: formData,
                                    headers: {
                                        "X-Requested-With":
                                            "XMLHttpRequest"
                                    }
                                }
                            );


                        if (!response.ok)
                            throw new Error(
                                "HTTP error " +
                                response.status
                            );


                        const data =
                            await response.json();


                        if (data.requireLogin) {

                            window.location.href =
                                "/Identity/Account/Login?returnUrl=" +
                                encodeURIComponent(
                                    window.location.pathname +
                                    window.location.search
                                );

                            return;
                        }


                        if (!data.success) {

                            throw new Error(
                                data.message ||
                                "Không thể cập nhật yêu thích."
                            );

                        }


                        if (data.isFavorite) {

                            button.classList.add("active");

                            icon.classList.remove(
                                "bi-heart"
                            );

                            icon.classList.add(
                                "bi-heart-fill"
                            );

                            button.title =
                                "Bỏ yêu thích";

                        }
                        else {

                            button.classList.remove("active");

                            icon.classList.remove(
                                "bi-heart-fill"
                            );

