        </label>


        <!-- 10% - 19% -->
        <label class="list-group-item filter-option">
            <input type="radio"
       name="minDiscount"
       value="10"
       @(selectedMinDiscount == 10 ? "checked" : "")
       onchange="applyDiscountFilter(this)" />

            <span>10% – 19%</span>
        </label>


        <!-- 20% - 29% -->
        <label class="list-group-item filter-option">
            <input type="radio"
       name="minDiscount"
       value="20"
       @(selectedMinDiscount == 20 ? "checked" : "")
       onchange="applyDiscountFilter(this)" />

            <span>20% – 29%</span>
        </label>


        <!-- 30% - 49% -->
        <label class="list-group-item filter-option">
            <input type="radio"
       name="minDiscount"
       value="30"
       @(selectedMinDiscount == 30 ? "checked" : "")
       onchange="applyDiscountFilter(this)" />

            <span>30% – 49%</span>
        </label>


        <!-- 50% TRỞ LÊN -->
        <label class="list-group-item filter-option">
            <input type="radio"
       name="minDiscount"
       value="50"
       @(selectedMinDiscount == 50 ? "checked" : "")
       onchange="applyDiscountFilter(this)" />

