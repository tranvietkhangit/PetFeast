@model IEnumerable<PetFeast.Models.Products.Product>
@using PetFeast.Models.ViewModels
@{
    var favoriteProductIds =
        ViewBag.FavoriteProductIds
        as HashSet<int>
        ?? new HashSet<int>();

    // =========================
    // PRODUCT RATINGS
    // =========================
    var productRatings =
        ViewBag.ProductRatings
        as Dictionary<int, ProductRatingViewModel>
        ?? new Dictionary<int, ProductRatingViewModel>();

    int currentPage =
        ViewBag.CurrentPage ?? 1;

    int totalPages =
        ViewBag.TotalPages ?? 1;

    int? selectedMinDiscount =
        ViewBag.MinDiscount;
        double? selectedMinRating =
    ViewBag.MinRating;
    // GIÁ CAO NHẤT CỦA SẢN PHẨM KHUYẾN MÃI
    int maxDiscountPrice =
        ViewBag.MaxDiscountPrice ?? 0;

    int minPrice =
        ViewBag.MinPrice ?? 0;

    // Nếu chưa có giá max được chọn thì dùng giá cao nhất
    int maxPrice =
        ViewBag.MaxPrice ?? maxDiscountPrice;

    string sortOrder =
        ViewBag.SortOrder ?? "";
}

<div class="container mt-4">

    <!-- =========================================================
         HEADER
    ========================================================== -->

    <div class="product-header mb-4">

        <div>

            <h4 class="fw-bold text-primary mb-1">
                Sản phẩm khuyến mãi
            </h4>

            <p class="text-muted mb-0">
                Những sản phẩm đang có ưu đãi hấp dẫn dành cho thú cưng
            </p>

        </div>

        <!-- SẮP XẾP -->

       <form method="get"
      asp-controller="Home"
      asp-action="Discount"
      class="discount-sort-form">

    <input type="hidden"
           name="minDiscount"
           value="@(selectedMinDiscount?.ToString() ?? "")" />
           <input type="hidden"
       name="minRating"
       value="@(selectedMinRating?.ToString() ?? "")" />

    <input type="hidden"
           name="minPrice"
           value="@minPrice" />

    <input type="hidden"
           name="maxPrice"
           value="@maxPrice" />

    <select name="sortOrder"
            class="form-select sort-select">

        <option value="" selected="@(string.IsNullOrEmpty(sortOrder) ? "selected" : null)">
            Sắp xếp
        </option>

        <option value="price_asc" selected="@(sortOrder == "price_asc" ? "selected" : null)">
            Giá thấp → cao
        </option>

        <option value="price_desc" selected="@(sortOrder == "price_desc" ? "selected" : null)">
            Giá cao → thấp
        </option>

    </select>

</form>

    </div>


    <!-- =========================================================
         MAIN
    ========================================================== -->

    <div class="row">

        <!-- =====================================================
             SIDEBAR FILTER
        ====================================================== -->

        <div class="col-md-3">

            <form method="get"
      asp-controller="Home"
      asp-action="Discount">

                <!-- =========================
                     MỨC GIẢM GIÁ
                ========================= -->

                <div class="card mb-3">

    <div class="card-header bg-primary text-white">
        MỨC GIẢM GIÁ
    </div>

    <div class="list-group list-group-flush">

        <!-- TẤT CẢ -->
