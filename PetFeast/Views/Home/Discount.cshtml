@model IEnumerable<PetFeast.Models.Products.Product>

@{
    var favoriteProductIds =
        ViewBag.FavoriteProductIds
        as HashSet<int>
        ?? new HashSet<int>();

    int currentPage =
        ViewBag.CurrentPage ?? 1;

    int totalPages =
        ViewBag.TotalPages ?? 1;

    int? selectedMinDiscount =
        ViewBag.MinDiscount;

    // GIÁ CAO NHẤT CỦA SẢN PHẨM KHUYẾN MÃI
    int maxDiscountPrice =
        ViewBag.MaxDiscountPrice ?? 0;

    int minPrice =
        ViewBag.MinPrice ?? 0;

    // Nếu chưa có giá max được chọn thì dùng giá cao nhất
    int maxPrice =
        ViewBag.MaxPrice ?? maxDiscountPrice;

    string sortOrder =
        ViewBag.SortOrder ?? "";
}

<div class="container mt-4">

    <!-- =========================================================
         HEADER
    ========================================================== -->

    <div class="product-header mb-4">

        <div>

            <h4 class="fw-bold text-primary mb-1">
                Sản phẩm khuyến mãi
            </h4>

            <p class="text-muted mb-0">
                Những sản phẩm đang có ưu đãi hấp dẫn dành cho thú cưng
            </p>

        </div>

        <!-- SẮP XẾP -->

        <form method="get"
      asp-controller="Home"
      asp-action="Discount"
      class="sort-form">

            <input type="hidden"
       name="minDiscount"
       value="@selectedMinDiscount" />

            <input type="hidden"
                   name="minPrice"
                   value="@minPrice" />

            <input type="hidden"
                   name="maxPrice"
                   value="@maxPrice" />

            <select name="sortOrder"
                    class="form-select sort-select"
                    onchange="this.form.submit()">

                <option value="">
                    Sắp xếp
                </option>

                <option value="discount_desc"
        selected="@(sortOrder == "discount_desc" ? "selected" : null)">
    Giảm giá nhiều nhất
</option>

<option value="price_asc"
        selected="@(sortOrder == "price_asc" ? "selected" : null)">
    Giá thấp → cao
</option>

<option value="price_desc"
        selected="@(sortOrder == "price_desc" ? "selected" : null)">
    Giá cao → thấp
</option>

            </select>

        </form>

    </div>


    <!-- =========================================================
         MAIN
    ========================================================== -->

    <div class="row">

        <!-- =====================================================
             SIDEBAR FILTER
        ====================================================== -->

        <div class="col-md-3">

            <form method="get"
      asp-controller="Home"
      asp-action="Discount">

                <!-- =========================
                     MỨC GIẢM GIÁ
                ========================= -->

                <div class="card mb-3">

    <div class="card-header bg-primary text-white">
        MỨC GIẢM GIÁ
    </div>

    <div class="list-group list-group-flush">

        <label class="list-group-item filter-option">
            <input type="radio"
                   name="minDiscount"
                   value=""
                   @(selectedMinDiscount == null ? "checked" : "")
                   onchange="this.form.submit()" />

            <span>Tất cả</span>
        </label>

        <label class="list-group-item filter-option">
            <input type="radio"
                   name="minDiscount"
                   value="10"
                   @(selectedMinDiscount == 10 ? "checked" : "")
                   onchange="this.form.submit()" />

            <span>Từ 10%</span>
        </label>

        <label class="list-group-item filter-option">
            <input type="radio"
                   name="minDiscount"
                   value="20"
                   @(selectedMinDiscount == 20 ? "checked" : "")
                   onchange="this.form.submit()" />

            <span>Từ 20%</span>
        </label>

        <label class="list-group-item filter-option">
            <input type="radio"
                   name="minDiscount"
                   value="30"
                   @(selectedMinDiscount == 30 ? "checked" : "")
                   onchange="this.form.submit()" />

            <span>Từ 30%</span>
        </label>

        <label class="list-group-item filter-option">
            <input type="radio"
                   name="minDiscount"
                   value="50"
                   @(selectedMinDiscount == 50 ? "checked" : "")
                   onchange="this.form.submit()" />

            <span>Từ 50%</span>
        </label>

    </div>

</div>


                <!-- =========================
                     GIÁ SAU KHI GIẢM
                ========================== -->

                <div class="card mb-3">

                    <div class="card-header bg-primary text-white">
                        GIÁ SAU KHI GIẢM
                    </div>

                    <div class="card-body">

                        <!-- GIÁ TỪ -->

                        <div class="mb-3">

                            <label class="form-label">
                                Giá từ
                            </label>

                            <div class="input-group">

                               <input type="number"
       id="minPriceInput"
       name="minPrice"
       class="form-control"
       min="0"
       max="@maxDiscountPrice"
       step="1"
       value="@minPrice" />

                                <span class="input-group-text">
                                    đ
                                </span>

                            </div>

                        </div>


                        <!-- GIÁ ĐẾN -->

                        <div class="mb-3">

                            <label class="form-label">
                                Giá đến
                            </label>

                            <div class="input-group">

                                <input type="number"
       id="maxPriceInput"
       name="maxPrice"
       class="form-control"
       min="0"
       max="@maxDiscountPrice"
       step="1"
       value="@maxPrice" />

                                <span class="input-group-text">
                                    đ
                                </span>

                            </div>

                        </div>


                        <!-- SLIDER -->

                        <div class="price-slider-container">

                            <div class="price-slider-track"></div>

                            <input type="range"
       id="minPriceRange"
       min="0"
       max="@maxDiscountPrice"
       step="1"
       value="@minPrice"
       class="price-range" />

                            <input type="range"
       id="maxPriceRange"
       min="0"
       max="@maxDiscountPrice"
       step="1"
       value="@maxPrice"
       class="price-range" />

                        </div>


                        <div class="d-flex justify-content-between mt-2">

                            <span id="minPriceLabel">
                                @minPrice.ToString("N0") đ
                            </span>

                            <span id="maxPriceLabel">
                                @maxPrice.ToString("N0") đ
                            </span>

                        </div>


                        <!-- SORT -->

                        <input type="hidden"
                               name="sortOrder"
                               value="@sortOrder" />


                        <!-- BUTTON -->

                        <button type="submit"
                                class="btn btn-primary w-100 mt-3">

                            <i class="bi bi-funnel-fill me-1"></i>

                            Lọc sản phẩm

                        </button>
                       <!-- RESET -->

<a asp-controller="Home"
   asp-action="Discount"
   class="btn btn-outline-secondary w-100 mt-2">

    <i class="bi bi-arrow-counterclockwise me-1"></i>

    Xóa bộ lọc

</a>
                    </div>

                </div>


                

            </form>

        </div>


        <!-- =====================================================
             PRODUCTS
        ====================================================== -->

        <div class="col-md-9">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <i class="bi bi-search"
                       style="font-size: 45px;">
                    </i>

                    <h4 class="mt-3">
                        Không tìm thấy sản phẩm
                    </h4>

                    <p class="text-muted">
                        Hãy thử thay đổi điều kiện lọc.
                    </p>

                    <a asp-controller="Home"
                       asp-action="Discount"
                       class="btn btn-primary">

                        Xem tất cả sản phẩm khuyến mãi

                    </a>

                </div>
            }
            else
            {
                <div class="row">

                    @foreach (var item in Model)
                    {
                        bool isFavorite =
                            favoriteProductIds.Contains(
                                item.ProductId);

                        <div class="col-md-4 mb-4">

                            <div class="card h-100 product-card">

                                <!-- =========================
                                     IMAGE
                                ========================== -->

                                <div class="product-image-wrapper">

                                    <a asp-controller="Product"
                                       asp-action="Detail"
                                       asp-route-id="@item.ProductId">

                                        <img src="@item.ImageUrl"
                                             class="product-image"
                                             alt="@item.ProductName" />

                                    </a>


                                    <!-- FAVORITE -->

                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        <form class="favorite-form"
                                              data-product-id="@item.ProductId">

                                            @Html.AntiForgeryToken()

                                            <button type="button"
                                                    class="favorite-btn @(isFavorite ? "active" : "")"
                                                    title="@(isFavorite ? "Bỏ yêu thích" : "Thêm vào yêu thích")">

                                                <i class="bi @(isFavorite ? "bi-heart-fill" : "bi-heart")"></i>

                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <div class="favorite-form">

                                            <a asp-area="Identity"
                                               asp-page="/Account/Login"
                                               asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString"
                                               class="favorite-btn"
                                               title="Đăng nhập để thêm yêu thích">

                                                <i class="bi bi-heart"></i>

                                            </a>

                                        </div>
                                    }

                                </div>


                                <!-- =========================
                                     INFORMATION
                                ========================== -->

                                <div class="card-body">

                                    <h6>
                                        @item.ProductName
                                    </h6>


                                    <span class="discount-badge">

                                        -@item.DiscountPercent%

                                    </span>


                                    <div class="mb-2">

                                        <div class="price-box">

                                            <span class="old-price">

                                                @item.Price.ToString("N0") đ

                                            </span>

                                            <span class="new-price">

                                                @item.DiscountPrice.ToString("N0") đ

                                            </span>

                                        </div>

                                    </div>

                                </div>


                                <!-- =========================
                                     ADD CART
                                ========================== -->

                                <div class="card-footer bg-white border-0">

                                    <button type="button"
                                            class="btn btn-primary w-100 add-to-cart-btn"
                                            data-product-id="@item.ProductId">

                                        <i class="bi bi-cart-plus"></i>

                                        <span>
                                            Thêm vào giỏ hàng
                                        </span>

                                    </button>

                                </div>

                            </div>

                        </div>
                    }

                </div>


                <!-- =================================================
                     PAGINATION
                ================================================== -->

                @if (totalPages > 1)
                {
                    <nav class="mt-4 mb-5">

                        <ul class="pagination justify-content-center">

                            <!-- PREVIOUS -->

                            @if (currentPage > 1)
                            {
                                <li class="page-item">

                                    <a class="page-link"
                                       href="@Url.Action("Discount", new {
                                           page = currentPage - 1,
                                           minDiscount = selectedMinDiscount,
                                           minPrice = minPrice,
                                           maxPrice = maxPrice,
                                           sortOrder = sortOrder
                                       })">

                                        <i class="bi bi-chevron-left"></i>

                                    </a>

                                </li>
                            }


                            <!-- PAGE NUMBERS -->

                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">

                                    <a class="page-link"
                                       href="@Url.Action("Discount", new {
                                           page = i,
                                           minDiscount = selectedMinDiscount,
                                           minPrice = minPrice,
                                           maxPrice = maxPrice,
                                           sortOrder = sortOrder
                                       })">

                                        @i

                                    </a>

                                </li>
                            }


                            <!-- NEXT -->

                            @if (currentPage < totalPages)
                            {
                                <li class="page-item">

                                    <a class="page-link"
                                       href="@Url.Action("Discount", new {
                                           page = currentPage + 1,
                                           minDiscount = selectedMinDiscount,
                                           minPrice = minPrice,
                                           maxPrice = maxPrice,
                                           sortOrder = sortOrder
                                       })">

                                        <i class="bi bi-chevron-right"></i>

                                    </a>

                                </li>
                            }

                        </ul>

                    </nav>
                }

            }

        </div>

    </div>

</div>


<!-- =========================================================
     PRICE SLIDER
========================================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

    const minRange =
        document.getElementById("minPriceRange");

    const maxRange =
        document.getElementById("maxPriceRange");

    const minInput =
        document.getElementById("minPriceInput");

    const maxInput =
        document.getElementById("maxPriceInput");

    const minLabel =
        document.getElementById("minPriceLabel");

    const maxLabel =
        document.getElementById("maxPriceLabel");

    const track =
        document.querySelector(".price-slider-track");


    if (!minRange ||
        !maxRange ||
        !minInput ||
        !maxInput ||
        !minLabel ||
        !maxLabel ||
        !track) {

        return;
    }


    // LẤY GIÁ CAO NHẤT TRỰC TIẾP TỪ SLIDER
    const maxDiscountPrice =
        Number(maxRange.max);


    function formatPrice(value) {

        return Number(value)
            .toLocaleString("vi-VN") + " đ";

    }


    function updateTrack() {

        const minValue =
            Number(minRange.value);

        const maxValue =
            Number(maxRange.value);


        const minPercent =
            maxDiscountPrice > 0
                ? (minValue / maxDiscountPrice) * 100
                : 0;

        const maxPercent =
            maxDiscountPrice > 0
                ? (maxValue / maxDiscountPrice) * 100
                : 100;


        track.style.background =
            `linear-gradient(
                to right,
                #dbeafe 0%,
                #dbeafe ${minPercent}%,
                #0d6efd ${minPercent}%,
                #0d6efd ${maxPercent}%,
                #dbeafe ${maxPercent}%,
                #dbeafe 100%
            )`;

    }


    // =========================
    // SLIDER MIN
    // =========================

    minRange.addEventListener(
        "input",
        function () {

            let value =
                Number(this.value);

            let maxValue =
                Number(maxRange.value);


            if (value > maxValue) {

                value = maxValue;

                this.value = value;

            }


            minInput.value = value;

            minLabel.textContent =
                formatPrice(value);

            updateTrack();

        }
    );


    // =========================
    // SLIDER MAX
    // =========================

    maxRange.addEventListener(
        "input",
        function () {

            let value =
                Number(this.value);

            let minValue =
                Number(minRange.value);


            if (value < minValue) {

                value = minValue;

                this.value = value;

            }


            maxInput.value = value;

            maxLabel.textContent =
                formatPrice(value);

            updateTrack();

        }
    );


    // =========================
    // INPUT MIN
    // =========================

    minInput.addEventListener(
        "change",
        function () {

            let value =
                Number(this.value);


            if (isNaN(value))
                value = 0;


            value = Math.max(
                0,
                Math.min(
                    maxDiscountPrice,
                    value
                )
            );


            let maxValue =
                Number(maxInput.value);


            if (isNaN(maxValue))
                maxValue = maxDiscountPrice;


            if (value > maxValue)
                value = maxValue;


            this.value = value;

            minRange.value = value;

            minLabel.textContent =
                formatPrice(value);

            updateTrack();

        }
    );


    // =========================
    // INPUT MAX
    // =========================

    maxInput.addEventListener(
        "change",
        function () {

            let value =
                Number(this.value);


            if (isNaN(value))
                value = maxDiscountPrice;


            value = Math.max(
                0,
                Math.min(
                    maxDiscountPrice,
                    value
                )
            );


            let minValue =
                Number(minInput.value);


            if (isNaN(minValue))
                minValue = 0;


            if (value < minValue)
                value = minValue;


            this.value = value;

            maxRange.value = value;

            maxLabel.textContent =
                formatPrice(value);

            updateTrack();

        }
    );


    // =========================
    // KHỞI TẠO
    // =========================

    minLabel.textContent =
        formatPrice(minRange.value);

    maxLabel.textContent =
        formatPrice(maxRange.value);

    updateTrack();
    });

</script>


<!-- =========================================================
     FAVORITE AJAX
========================================================= -->

<script>

    document.querySelectorAll(".favorite-form")
        .forEach(function (form) {

            const button =
                form.querySelector(".favorite-btn");

            if (!button)
                return;

            const icon =
                button.querySelector("i");

            if (!icon)
                return;

            const productId =
                form.dataset.productId;

            const token =
                form.querySelector(
                    'input[name="__RequestVerificationToken"]'
                )?.value;


            button.addEventListener(
                "click",
                async function () {

                    if (button.disabled)
                        return;

                    button.disabled = true;


                    try {

                        const formData =
                            new FormData();


                        formData.append(
                            "productId",
                            productId
                        );


                        if (token) {

                            formData.append(
                                "__RequestVerificationToken",
                                token
                            );

                        }


                        const response =
                            await fetch(
                                "/Favorite/ToggleAjax",
                                {
                                    method: "POST",
                                    body: formData,
                                    headers: {
                                        "X-Requested-With":
                                            "XMLHttpRequest"
                                    }
                                }
                            );


                        if (!response.ok)
                            throw new Error(
                                "HTTP error " +
                                response.status
                            );


                        const data =
                            await response.json();


                        if (data.requireLogin) {

                            window.location.href =
                                "/Identity/Account/Login?returnUrl=" +
                                encodeURIComponent(
                                    window.location.pathname +
                                    window.location.search
                                );

                            return;
                        }


                        if (!data.success) {

                            throw new Error(
                                data.message ||
                                "Không thể cập nhật yêu thích."
                            );

                        }


                        if (data.isFavorite) {

                            button.classList.add("active");

                            icon.classList.remove(
                                "bi-heart"
                            );

                            icon.classList.add(
                                "bi-heart-fill"
                            );

                            button.title =
                                "Bỏ yêu thích";

                        }
                        else {

                            button.classList.remove("active");

                            icon.classList.remove(
                                "bi-heart-fill"
                            );

                            icon.classList.add(
                                "bi-heart"
                            );

                            button.title =
                                "Thêm vào yêu thích";

                        }

                    }
                    catch (error) {

                        console.error(
                            "Favorite error:",
                            error
                        );

                        alert(
                            "Có lỗi xảy ra khi cập nhật yêu thích."
                        );

                    }
                    finally {

                        button.disabled = false;

                    }

                });

        });
         function filterDiscount(value) {

    const url = new URL(
        "/Home/Discount",
        window.location.origin
    );

    // Chọn mức giảm giá
    if (value !== "") {
        url.searchParams.set("minDiscount", value);
    }

    // Giữ giá hiện tại
    const minPriceInput =
        document.getElementById("minPriceInput");

    const maxPriceInput =
        document.getElementById("maxPriceInput");

    if (minPriceInput && minPriceInput.value) {
        url.searchParams.set(
            "minPrice",
            minPriceInput.value
        );
    }

    if (maxPriceInput && maxPriceInput.value) {
        url.searchParams.set(
            "maxPrice",
            maxPriceInput.value
        );
    }

    // Giữ cách sắp xếp
    const sortSelect =
        document.querySelector(
            'select[name="sortOrder"]'
        );

    if (sortSelect && sortSelect.value) {
        url.searchParams.set(
            "sortOrder",
            sortSelect.value
        );
    }

    // Luôn quay về trang 1
    url.searchParams.set("page", "1");

    window.location.href = url.toString();
}
</script>


<!-- =========================================================
     ADD TO CART AJAX
========================================================= -->

<script>

    document.querySelectorAll(".add-to-cart-btn")
        .forEach(function (button) {

            button.addEventListener(
                "click",
                async function () {

                    if (button.disabled)
                        return;


                    const productId =
                        button.dataset.productId;


                    const originalHTML =
                        button.innerHTML;


                    button.disabled = true;


                    button.innerHTML = `
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        Đang thêm...
                    `;


                    try {

                        const response =
                            await fetch(
                                "/ShoppingCart/AddToCartAjax",
                                {
                                    method: "POST",

                                    headers: {
                                        "Content-Type":
                                            "application/x-www-form-urlencoded; charset=UTF-8",

                                        "X-Requested-With":
                                            "XMLHttpRequest"
                                    },

                                    body:
                                        `productId=${encodeURIComponent(productId)}&quantity=1`
                                }
                            );


                        if (!response.ok)
                            throw new Error(
                                "HTTP error " +
                                response.status
                            );


                        const data =
                            await response.json();


                        if (data.requireLogin) {

                            const currentUrl =
                                window.location.pathname +
                                window.location.search;


                            window.location.href =
                                "/Identity/Account/Login?returnUrl=" +
                                encodeURIComponent(
                                    currentUrl
                                );

                            return;
                        }


                        if (data.success) {

                            const cartCount =
                                document.getElementById(
                                    "cartCount"
                                );


                            if (cartCount) {

                                cartCount.textContent =
                                    data.cartCount;

                                cartCount.classList.add(
                                    "cart-count-bump"
                                );


                                setTimeout(
                                    function () {

                                        cartCount.classList.remove(
                                            "cart-count-bump"
                                        );

                                    },
                                    400
                                );

                            }


                            button.classList.remove(
                                "btn-primary"
                            );

                            button.classList.add(
                                "btn-success",
                                "cart-added"
                            );


                            button.innerHTML = `
                                <i class="bi bi-check-circle-fill"></i>
                                <span>Đã thêm</span>
                            `;


                            setTimeout(
                                function () {

                                    button.classList.remove(
                                        "btn-success",
                                        "cart-added"
                                    );

                                    button.classList.add(
                                        "btn-primary"
                                    );

                                    button.innerHTML =
                                        originalHTML;

                                    button.disabled =
                                        false;

                                },
                                1500
                            );

                        }
                        else {

                            alert(
                                data.message ||
                                "Không thể thêm sản phẩm vào giỏ hàng."
                            );

                            button.innerHTML =
                                originalHTML;

                            button.disabled =
                                false;

                        }

                    }
                    catch (error) {

                        console.error(
                            "Add to cart error:",
                            error
                        );

                        alert(
                            "Có lỗi xảy ra khi thêm sản phẩm vào giỏ hàng."
                        );

                        button.innerHTML =
                            originalHTML;

                        button.disabled =
                            false;

                    }

                });

        });

</script>


<!-- =========================================================
     CSS
========================================================= -->

<style>

    /* =========================================================
       PRODUCT CARD
    ========================================================= */

    .product-card {

        overflow: hidden;

        border-radius: 12px;

    }


    .product-image-wrapper {

        position: relative;

    }


    .product-image {

        width: 100%;

        height: 250px;

        object-fit: cover;

        display: block;

    }


    /* =========================================================
       FAVORITE
    ========================================================= */

    .favorite-form {

        position: absolute;

        top: 12px;

        right: 12px;

        z-index: 20;

        margin: 0;

    }


    .favorite-btn {

        width: 58px;

        height: 58px;

        padding: 0;

        border-radius: 50%;

        border: 2px solid #222;

        background: #fff;

        display: flex;

        align-items: center;

        justify-content: center;

        cursor: pointer;

        text-decoration: none;

        box-shadow:
            0 3px 10px rgba(0, 0, 0, 0.15);

        transition:
            all 0.25s ease;

    }


    .favorite-btn i {

        font-size: 28px;

        color: #222;

        transition:
            all 0.25s ease;

    }


    .favorite-btn.active {

