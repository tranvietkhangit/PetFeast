                    <i class="bi bi-search"
                       style="font-size: 45px;">
                    </i>

                    <h4 class="mt-3">
                        Không tìm thấy sản phẩm
                    </h4>

                    <p class="text-muted">
                        Hãy thử thay đổi điều kiện lọc.
                    </p>

                    <a asp-controller="Home"
                       asp-action="Discount"
                       class="btn btn-primary">

                        Xem tất cả sản phẩm khuyến mãi

                    </a>

                </div>
            }
            else
            {
                <div class="row">

                    @foreach (var item in Model)
                    {
                       bool isFavorite =
        favoriteProductIds.Contains(
            item.ProductId);

    bool isOutOfStock =
        item.Quantity <= 0;

    ProductRatingViewModel? rating = null;

    productRatings.TryGetValue(
        item.ProductId,
        out rating);

                        <div class="col-md-4 mb-4">

                            <div class="card h-100 product-card @(isOutOfStock ? "out-of-stock" : "")">

                                <!-- =========================
                                     IMAGE
                                ========================== -->

                                <div class="product-image-wrapper">
                                    @if (isOutOfStock)
{
    <span class="out-of-stock-badge">
        <i class="bi bi-x-circle me-1"></i>
        Hết hàng
    </span>
}
                                    <a asp-controller="Product"
