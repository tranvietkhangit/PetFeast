                                        </div>
                                    }

                                </div>


                                <!-- =========================
                                     INFORMATION
                                ========================== -->

                                <div class="card-body">

                                    <h6 class="product-name">
    @item.ProductName
</h6>

<!-- =========================
     RATING
========================= -->

<div class="product-rating">

