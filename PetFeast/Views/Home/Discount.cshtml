                                    <a class="page-link"
                                       href="@Url.Action("Discount", new {
                                           page = i,
                                           minDiscount = selectedMinDiscount,
minRating = selectedMinRating,
                                           minPrice = minPrice,
                                           maxPrice = maxPrice,
                                           sortOrder = sortOrder
