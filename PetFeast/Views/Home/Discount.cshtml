                                <li class="page-item">

                                    <a class="page-link"
                                       href="@Url.Action("Discount", new {
                                           page = currentPage - 1,
                                           minDiscount = selectedMinDiscount,
minRating = selectedMinRating,
                                           minPrice = minPrice,
                                           maxPrice = maxPrice,
