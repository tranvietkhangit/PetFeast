          /* =========================================================
       AJAX DISCOUNT FILTER
    ========================================================= */

    async function loadDiscountPage(url, updateHistory = true) {

        try {

            const productArea =
                document.querySelector(".col-md-9");

            if (!productArea)
                return;


            // Hiệu ứng loading nhẹ
            productArea.style.opacity = "0.5";
            productArea.style.pointerEvents = "none";


            const response = await fetch(url, {
                headers: {
                    "X-Requested-With": "XMLHttpRequest"
                }
            });


            if (!response.ok) {
                throw new Error(
                    "HTTP error " + response.status
                );
            }


            const html =
                await response.text();


            // Parse HTML trả về
            const parser =
                new DOMParser();

            const doc =
                parser.parseFromString(
                    html,
                    "text/html"
                );


            const newProductArea =
                doc.querySelector(".col-md-9");


            if (!newProductArea) {
                throw new Error(
                    "Không tìm thấy khu vực sản phẩm."
                );
            }


            // Thay phần sản phẩm cũ
            productArea.innerHTML =
                newProductArea.innerHTML;


            // Cập nhật URL trên trình duyệt
            if (updateHistory) {

                window.history.pushState(
                    {},
                    "",
                    url
                );

            }

        }
        catch (error) {

            console.error(
                "Discount AJAX error:",
                error
            );

            showErrorModal(
                "Không thể tải sản phẩm. Vui lòng thử lại."
            );

        }
        finally {

            const productArea =
                document.querySelector(".col-md-9");

            if (productArea) {

                productArea.style.opacity = "1";
                productArea.style.pointerEvents = "auto";

            }

        }

    }


    /* =========================================================
       TẠO URL FILTER
    ========================================================= */

    function getDiscountUrl(form) {

        const params =
            new URLSearchParams();


        const formData =
            new FormData(form);


        for (const [key, value] of formData.entries()) {

            if (value !== "") {

                params.set(
                    key,
                    value
                );

            }

        }


        // Khi thay đổi filter luôn quay về trang 1
        params.set(
            "page",
            "1"
        );


        return `/Home/Discount?${params.toString()}`;

    }


    /* =========================================================
       FILTER FORM
    ========================================================= */

    document.addEventListener(
        "submit",
        function (event) {

            const form =
                event.target;


            if (!form.matches(
                'form[asp-action="Discount"], form[action*="/Home/Discount"], .discount-sort-form'
            )) {

                return;

            }


            event.preventDefault();


            const url =
                getDiscountUrl(form);


            loadDiscountPage(url);

        }
    );


    /* =========================================================
       SORT
    ========================================================= */

    document.addEventListener(
        "change",
        function (event) {

            const element =
                event.target;


            if (!element.matches(
                '.discount-sort-form select[name="sortOrder"]'
            )) {

                return;

            }


            const form =
                element.closest("form");


            if (!form)
                return;


            const url =
                getDiscountUrl(form);


            loadDiscountPage(url);

        }
    );


    /* =========================================================
       PAGINATION
    ========================================================= */

    document.addEventListener(
        "click",
        function (event) {

            const link =
                event.target.closest(
                    '.col-md-9 .pagination a'
                );


            if (!link)
                return;


            event.preventDefault();


            const url =
                link.href;


            if (!url)
                return;


            loadDiscountPage(url);

        }
    );


    /* =========================================================
       RESET FILTER
    ========================================================= */

    document.addEventListener(
        "click",
        function (event) {

            const link =
                event.target.closest(
                    '.col-md-3 a[href*="/Home/Discount"]'
                );


            if (!link)
                return;


            event.preventDefault();


            loadDiscountPage(
                link.href
            );

        }
    );


    /* =========================================================
       BACK / FORWARD TRÌNH DUYỆT
    ========================================================= */

    window.addEventListener(
        "popstate",
        function () {

            loadDiscountPage(
                window.location.href,
                false
            );

        }
    );
</script>


